#!/usr/bin/env bash
# Regression tests for `pr-checks` check classification (arbsec/orchestraitor#706).
# Synthetic `gh pr checks` responses; no network or provider calls.
#
# Covers:
#   (a) every real check SUCCESS + CodeRabbit SKIPPED with the observed
#       (empty) description on a bot-authored PR -> all_passed true,
#       CodeRabbit not-applicable, skip_reason "bot-author"
#   (a2) the same when gh populates the real check-run reason in `description`
#   (a3) a classic `<slug>[bot]` author login is also a bot author
#   (b) any OTHER check skipped for an unexplained reason -> all_passed false
#   (c) CodeRabbit skipped with a non-bot reason -> all_passed false
#   (d) a known-disabled job that actually ran and FAILED -> all_passed false
#   (e) known-disabled and CodeRabbit checks that pass/fail/pend are classified
#       from their state, never not-applicable (state-blindness guard)
#   (e2) a RE-ENABLED job (`Docs Consistency`, #741) that pends is a plain
#       pending check, never not-applicable
#   (e3) a RE-ENABLED job that reports SKIPPED is an unexplained skip: it
#       blocks the gate instead of being excused from it
#   (f2) the known-disabled vocabulary holds exactly the still-disabled jobs
#   (g) CodeRabbit SKIPPED on a HUMAN-authored PR -> all_passed false,
#       skip_reason null (the tightening from the #707 review)
#   (h) empty/unknown author -> fails closed
#   (i) a failed author read -> fails closed
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT
mkdir -p "$TMP/repo/scripts" "$TMP/bin"
git -C "$TMP/repo" init -q
cp -L -- "$SCRIPT_DIR/_lib.sh" "$SCRIPT_DIR/pr-checks" "$TMP/repo/scripts/"
chmod +x "$TMP/repo/scripts/"*

# Review-policy provenance fixture (#748): the base commit holds the CURRENT
# classifier. A clean tree therefore proves "current copy -> normal verdict, no
# spurious refusal"; a branch that carries an older policy proves the typed
# refusal. `pr-checks` compares itself against the PR's baseRefOid blob.
GIT_ID=(-c user.name=skills-test -c user.email=skills-test@example.invalid)
git -C "$TMP/repo" add -A
git -C "$TMP/repo" "${GIT_ID[@]}" commit -q -m "base: current review policy"
BASE_BRANCH="$(git -C "$TMP/repo" rev-parse --abbrev-ref HEAD)"
PR_BASE_SHA="$(git -C "$TMP/repo" rev-parse HEAD)"
export PR_BASE_SHA

# gh stub: serves the check fixture and the PR author. The author drives the
# bot/App predicate; `PR_AUTHOR_FAIL=true` simulates a failed read.
cat > "$TMP/bin/gh" <<'STUB'
#!/usr/bin/env bash
case "$1/${2:-}" in
  auth/status) exit 0 ;;
  pr/checks) cat "$PR_CHECKS_FIXTURE" ;;
  pr/view)
    json=""; prev=""
    for a in "$@"; do [ "$prev" = "--json" ] && json="$a"; prev="$a"; done
    if [ "$json" = baseRefOid ]; then
      # The PR's trusted base commit (review-policy provenance, #748).
      out="{\"baseRefOid\":$(jq -cn --arg b "$PR_BASE_SHA" '$b')}"
    else
      [ "${PR_AUTHOR_FAIL:-false}" = true ] && exit 1
      out="{\"author\":{\"login\":$(jq -cn --arg a "${PR_AUTHOR_LOGIN-app/arbsec-agent}" '$a')}}"
    fi
    j=""; prev=""
    for a in "$@"; do [ "$prev" = "--jq" ] && j="$a"; prev="$a"; done
    if [ -n "$j" ]; then printf '%s\n' "$out" | jq -r "$j"; exit $?; fi
    printf '%s\n' "$out" ;;
  *) echo "unexpected gh call: $*" >&2; exit 1 ;;
esac
STUB
chmod +x "$TMP/bin/gh"

# orc stub: service-identity config resolves; gh-env re-execs the gh stub.
cat > "$TMP/bin/orc" <<'STUB'
#!/usr/bin/env bash
case "$1/${2:-}" in
  config/validate) exit 0 ;;
  config/get) echo stub-config ;;
  github/gh-env) shift 3; exec "$@" ;;
  *) exit 1 ;;
esac
STUB
chmod +x "$TMP/bin/orc"

export PATH="$TMP/bin:/usr/bin:/bin"
export ORC_BIN="$TMP/bin/orc" GH_BIN="$TMP/bin/gh"
export ORC_GITHUB_APP_ENFORCEMENT=required
# Default author for the existing #706 cases: the App service identity this
# repo's agent PRs carry.
export PR_AUTHOR_LOGIN=app/arbsec-agent
PASS=0; FAIL=0
assert() {
  if [ "$2" = "$3" ]; then PASS=$((PASS+1)); echo "PASS: $1"
  else FAIL=$((FAIL+1)); printf 'FAIL: %s\n  expected: %s\n  actual: %s\n' "$1" "$2" "$3"; fi
}
run() {
  # `"scripts/$@"` mixes a string with an array (shellcheck SC2145); the first
  # argument names the script, the rest are its arguments.
  OUT="$(cd "$TMP/repo" && "scripts/$1" "${@:2}" 2>"$TMP/stderr")"; RC=$?
}
# One check object; missing fields are irrelevant to classification.
check() { # name bucket state description
  jq -cn --arg name "$1" --arg bucket "$2" --arg state "$3" --arg description "${4:-}" \
    '{name:$name,state:$state,bucket:$bucket,description:$description,workflow:"CI",link:"https://example.test/check/"+$name}'
}
fixture() { # fixture <file> <check-object-process-substitutions...>
  local file="$1"; shift
  jq -s '.' "$@" > "$file"
}
classification() { jq -r --arg n "$1" '.checks[] | select(.name == $n) | .classification' <<<"$OUT"; }
skip_reason() { jq -r --arg n "$1" '.checks[] | select(.name == $n) | .skip_reason' <<<"$OUT"; }

# (a) all real checks green + CodeRabbit SKIPPED with the observed empty
# description. This is the #706 defect shape.
fixture "$TMP/a.json" \
  <(check CodeQL pass SUCCESS) \
  <(check "Check & Lint" pass SUCCESS) \
  <(check CodeRabbit skipping SKIPPED "") \
  <(check "qlty check" pass SUCCESS "No blocking issues")
export PR_CHECKS_FIXTURE="$TMP/a.json"
run pr-checks 7 --repo test-org/repo --json
assert 'a: exits 0' 0 "$RC"
assert 'a: all_passed true' true "$(jq -r .all_passed <<<"$OUT")"
assert 'a: any_failing false' false "$(jq -r .any_failing <<<"$OUT")"
assert 'a: CodeRabbit not-applicable' not-applicable "$(classification CodeRabbit)"
assert 'a: CodeRabbit skip_reason bot-author' bot-author "$(skip_reason CodeRabbit)"
assert 'a: passing check has null skip_reason' null "$(skip_reason CodeQL)"
assert 'a: aggregate keys preserved' true \
  "$(jq -r 'has("checks") and has("all_passed") and has("any_failing") and has("any_pending")' <<<"$OUT")"

# (a2) the exact reason observed in the CodeRabbit check-run output, if gh
# ever surfaces it in `description`, is still recognised.
fixture "$TMP/a2.json" \
  <(check CodeQL pass SUCCESS) \
  <(check CodeRabbit skipping SKIPPED "Review skipped: bot user not eligible for review")
export PR_CHECKS_FIXTURE="$TMP/a2.json"
run pr-checks 7 --repo test-org/repo --json
assert 'a2: bot-author description exempts' not-applicable "$(classification CodeRabbit)"
assert 'a2: bot-author description records reason' bot-author "$(skip_reason CodeRabbit)"
assert 'a2: all_passed true' true "$(jq -r .all_passed <<<"$OUT")"

# (a3) a classic `<slug>[bot]` login is a bot author too.
export PR_AUTHOR_LOGIN='arbsec-agent[bot]'
export PR_CHECKS_FIXTURE="$TMP/a.json"
run pr-checks 7 --repo test-org/repo --json
assert 'a3: [bot] author exempts CodeRabbit' not-applicable "$(classification CodeRabbit)"
assert 'a3: [bot] author records bot-author' bot-author "$(skip_reason CodeRabbit)"
export PR_AUTHOR_LOGIN=app/arbsec-agent

# (b) anti-bypass: a different check skipped with no explanation still blocks.
fixture "$TMP/b.json" \
  <(check CodeQL pass SUCCESS) \
  <(check CodeRabbit skipping SKIPPED "") \
  <(check "Advisory Check" skipping SKIPPED "")
export PR_CHECKS_FIXTURE="$TMP/b.json"
run pr-checks 7 --repo test-org/repo --json
assert 'b: unexplained skip blocks' false "$(jq -r .all_passed <<<"$OUT")"
assert 'b: unexplained skip stays skip' skip "$(classification "Advisory Check")"
assert 'b: unexplained skip has null reason' null "$(skip_reason "Advisory Check")"

# (c) anti-bypass: CodeRabbit skipped for a NON-bot reason still blocks.
fixture "$TMP/c.json" \
  <(check CodeQL pass SUCCESS) \
  <(check CodeRabbit skipping SKIPPED "Review skipped: rate limit exceeded")
export PR_CHECKS_FIXTURE="$TMP/c.json"
run pr-checks 7 --repo test-org/repo --json
assert 'c: non-bot CodeRabbit skip blocks' false "$(jq -r .all_passed <<<"$OUT")"
assert 'c: non-bot CodeRabbit stays skip' skip "$(classification CodeRabbit)"
assert 'c: non-bot CodeRabbit has null reason' null "$(skip_reason CodeRabbit)"

# (d) state-blindness regression pin: a known-disabled job that actually ran
# and FAILED is a failure, never not-applicable.
fixture "$TMP/d.json" \
  <(check Documentation fail FAILURE) \
  <(check CodeRabbit skipping SKIPPED "") \
  <(check CodeQL pass SUCCESS)
export PR_CHECKS_FIXTURE="$TMP/d.json"
run pr-checks 7 --repo test-org/repo --json
assert 'd: failed known-disabled job blocks' false "$(jq -r .all_passed <<<"$OUT")"
assert 'd: failed known-disabled job is fail' fail "$(classification Documentation)"
assert 'd: failed known-disabled job has null reason' null "$(skip_reason Documentation)"
assert 'd: any_failing true' true "$(jq -r .any_failing <<<"$OUT")"

# (e) state-blindness both ways: exempt names that ran are classified by state.
fixture "$TMP/e.json" \
  <(check Documentation pass SUCCESS) \
  <(check CodeRabbit fail FAILURE) \
  <(check "Advisory Check" pending PENDING)
export PR_CHECKS_FIXTURE="$TMP/e.json"
run pr-checks 7 --repo test-org/repo --json
assert 'e: passing known-disabled job is pass' pass "$(classification Documentation)"
assert 'e: failing CodeRabbit is fail' fail "$(classification CodeRabbit)"
assert 'e: pending non-exempt job is pending' pending "$(classification "Advisory Check")"
assert 'e: gate still fails' false "$(jq -r .all_passed <<<"$OUT")"
assert 'e: pending reported' true "$(jq -r .any_pending <<<"$OUT")"

# (e2) `Docs Consistency` was re-enabled by markdown.yml (#741): its PENDING run
# is a plain pending check, never not-applicable.
fixture "$TMP/e2.json" \
  <(check CodeQL pass SUCCESS) \
  <(check "Docs Consistency" pending PENDING)
export PR_CHECKS_FIXTURE="$TMP/e2.json"
run pr-checks 7 --repo test-org/repo --json
assert 'e2: re-enabled job pending is pending' pending "$(classification "Docs Consistency")"
assert 'e2: re-enabled job pending has null reason' null "$(skip_reason "Docs Consistency")"
assert 'e2: re-enabled job pending blocks' false "$(jq -r .all_passed <<<"$OUT")"
assert 'e2: re-enabled job pending reported' true "$(jq -r .any_pending <<<"$OUT")"

# (e3) the #750 review condition: a re-enabled job must not stay exempt, or a
# SKIPPED run of it would be silently laundered to not-applicable. Before #741
# this exact fixture passed; it now fails closed as an unexplained skip.
fixture "$TMP/e3.json" \
  <(check CodeQL pass SUCCESS) \
  <(check "Docs Consistency" skipping SKIPPED "")
export PR_CHECKS_FIXTURE="$TMP/e3.json"
run pr-checks 7 --repo test-org/repo --json
assert 'e3: re-enabled job skip is not exempt' skip "$(classification "Docs Consistency")"
assert 'e3: re-enabled job skip has null reason' null "$(skip_reason "Docs Consistency")"
assert 'e3: re-enabled job skip blocks' false "$(jq -r .all_passed <<<"$OUT")"
assert 'e3: re-enabled job skip is not a failure' false "$(jq -r .any_failing <<<"$OUT")"

# (f) a known-disabled job in the skipping bucket is exempt and visible.
fixture "$TMP/f.json" \
  <(check Documentation skipping SKIPPED "") \
  <(check CodeRabbit skipping SKIPPED "") \
  <(check CodeQL pass SUCCESS)
export PR_CHECKS_FIXTURE="$TMP/f.json"
run pr-checks 7 --repo test-org/repo --json
assert 'f: known-disabled skip all_passed' true "$(jq -r .all_passed <<<"$OUT")"
assert 'f: known-disabled skip reason' known-disabled-job "$(skip_reason Documentation)"
assert 'f: known-disabled skip classification' not-applicable "$(classification Documentation)"

# (f2) the known-disabled VOCABULARY: exactly the jobs that are still disabled
# repo-side. A name left behind after its job is re-enabled is a silent gate
# hole (#741): the exemption matches on name AND `skipping`, so a re-enabled
# job reporting SKIPPED would be excused from the all-passed gate.
KNOWN_LIST="$(sed -n "s/^KNOWN_DISABLED_JOBS='\(.*\)'$/\1/p" "$TMP/repo/scripts/pr-checks")"
assert 'f2: vocabulary is exactly the still-disabled job' 'Documentation' \
  "$(printf '%s' "$KNOWN_LIST" | jq -r 'join(",")')"
assert 'f2: re-enabled job is absent from the vocabulary' 'false' \
  "$(printf '%s' "$KNOWN_LIST" | jq -r 'index("Docs Consistency") != null')"

# (g) a human-authored PR is never exempted, even with the same empty
# description: the author predicate carries the discrimination, not the reason.
export PR_AUTHOR_LOGIN=mekwall
export PR_CHECKS_FIXTURE="$TMP/a.json"
run pr-checks 7 --repo test-org/repo --json
assert 'g: human author blocks CodeRabbit skip' false "$(jq -r .all_passed <<<"$OUT")"
assert 'g: human author CodeRabbit stays skip' skip "$(classification CodeRabbit)"
assert 'g: human author has null reason' null "$(skip_reason CodeRabbit)"

# (h) empty/unknown author fails closed.
export PR_AUTHOR_LOGIN=""
export PR_CHECKS_FIXTURE="$TMP/a.json"
run pr-checks 7 --repo test-org/repo --json
assert 'h: empty author blocks CodeRabbit skip' false "$(jq -r .all_passed <<<"$OUT")"
assert 'h: empty author has null reason' null "$(skip_reason CodeRabbit)"

# (i) a failed author read fails closed.
export PR_AUTHOR_FAIL=true
export PR_CHECKS_FIXTURE="$TMP/a.json"
run pr-checks 7 --repo test-org/repo --json
assert 'i: failed author read blocks CodeRabbit skip' false "$(jq -r .all_passed <<<"$OUT")"
assert 'i: failed author read has null reason' null "$(skip_reason CodeRabbit)"
unset PR_AUTHOR_FAIL
export PR_AUTHOR_LOGIN=app/arbsec-agent

# (j) review-policy provenance (#748): a tree carrying an OLDER classifier than
# the base branch's copy must refuse (exit 6) instead of emitting a confident
# classification. Fixture: the base commit holds the current script; a branch
# reverts the bot-author exemption — the pre-#707 policy shape that produced
# today's false `checks_not_passing`.
echo "--- (j) stale classifier is refused ---"
git -C "$TMP/repo" switch -q -c stale-policy
sed -i 's/and bot_author_pr/and false/' "$TMP/repo/scripts/pr-checks"
git -C "$TMP/repo" add -A
git -C "$TMP/repo" "${GIT_ID[@]}" commit -q -m "fixture: pre-#707 classifier"
STALE_HEAD="$(git -C "$TMP/repo" rev-parse HEAD)"
export PR_CHECKS_FIXTURE="$TMP/a.json"
run pr-checks 7 --repo test-org/repo --json
assert 'j: stale copy refuses (exit 6)' 6 "$RC"
assert 'j: refusal is typed, not a verdict' stale-review-policy "$(jq -r .error <<<"$OUT")"
assert 'j: refusal carries no verdict keys' false \
  "$(jq -r 'has("checks") or has("all_passed") or has("any_failing") or has("any_pending")' <<<"$OUT")"
assert 'j: refusal names the stale file' 1 "$(grep -cF "$TMP/repo/scripts/pr-checks" "$TMP/stderr")"
assert 'j: refusal names the running commit' 1 "$(grep -cF "$STALE_HEAD" "$TMP/stderr")"
assert 'j: refusal names the trusted base oid' 1 \
  "$(grep -cF "at $PR_BASE_SHA (the PR's baseRefOid)" "$TMP/stderr")"
assert 'j: refusal gives the base-checkout command' 1 "$(grep -cF 'worktree add --detach' "$TMP/stderr")"
assert 'j: no classification on stdout' "" "$(jq -r '.checks // empty' <<<"$OUT")"

# (j2) an UNCOMMITTED edit to the running classifier is refused too: provenance
# that cannot be tied to a commit is never assumed current.
git -C "$TMP/repo" switch -q "$BASE_BRANCH"
printf '\n# uncommitted policy edit\n' >> "$TMP/repo/scripts/pr-checks"
run pr-checks 7 --repo test-org/repo --json
assert 'j2: uncommitted copy refuses (exit 6)' 6 "$RC"
assert 'j2: refusal names the working tree' 1 "$(grep -cF 'uncommitted content' "$TMP/stderr")"
git -C "$TMP/repo" checkout -- scripts/pr-checks

# (j3) the CURRENT copy still produces the normal verdict: the refusal must not
# fire on a current tree, or the gate is useless in a different way.
run pr-checks 7 --repo test-org/repo --json
assert 'j3: current copy exits 0' 0 "$RC"
assert 'j3: current copy still classifies' true "$(jq -r .all_passed <<<"$OUT")"
assert 'j3: current copy emits no refusal' 0 "$(grep -cF 'stale review policy' "$TMP/stderr")"

# usage errors
run pr-checks
assert 'missing argument exits 2' 2 "$RC"
run pr-checks --help
assert 'help exits 0' 0 "$RC"

printf '\n=== stub-run: %s passed, %s failed ===\n' "$PASS" "$FAIL"
[ "$FAIL" -eq 0 ]
