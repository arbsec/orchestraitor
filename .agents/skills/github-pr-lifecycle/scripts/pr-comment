#!/usr/bin/env bash
# pr-comment: comment on a PR through the service-identity wrapper.
# Wraps `gh pr comment` via orc_lib_gh_service so the comment attributes to the
# arbsec-agent GitHub App service identity, never a personal account
# (AGENTS.md critical rules; .agents/project/orchestraitor-workflow.md).
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=_lib.sh
source "$SCRIPT_DIR/_lib.sh"

orc_lib_parse_common "$@"

if [ "$OPT_HELP" = true ]; then
  orc_lib_print_help "pr-comment" "Comment on a PR (gh pr comment) through the service-identity wrapper. Positional: <pr-number> --body <text> (or --body-file <path>)."
  exit "$ORC_OK"
fi

# Extract --body/--body-file flags (body may span several words); the first
# remaining positional arg is the PR number, the rest pass through to gh.
BODY=""
BODY_FILE=""
REST=()
while [ "${#ORC_LIB_EXTRA_ARGS[@]}" -gt 0 ]; do
  case "${ORC_LIB_EXTRA_ARGS[0]}" in
    --body)         BODY="${ORC_LIB_EXTRA_ARGS[1]}"; ORC_LIB_EXTRA_ARGS=("${ORC_LIB_EXTRA_ARGS[@]:2}") ;;
    --body=*)       BODY="${ORC_LIB_EXTRA_ARGS[0]#*=}"; ORC_LIB_EXTRA_ARGS=("${ORC_LIB_EXTRA_ARGS[@]:1}") ;;
    --body-file)    BODY_FILE="${ORC_LIB_EXTRA_ARGS[1]}"; ORC_LIB_EXTRA_ARGS=("${ORC_LIB_EXTRA_ARGS[@]:2}") ;;
    --body-file=*)  BODY_FILE="${ORC_LIB_EXTRA_ARGS[0]#*=}"; ORC_LIB_EXTRA_ARGS=("${ORC_LIB_EXTRA_ARGS[@]:1}") ;;
    *)              REST+=("${ORC_LIB_EXTRA_ARGS[0]}"); ORC_LIB_EXTRA_ARGS=("${ORC_LIB_EXTRA_ARGS[@]:1}") ;;
  esac
done

PR="${REST[0]:-}"
if [ -z "$PR" ]; then
  echo "error: PR number required" >&2
  exit "$ORC_ERR_CONFIG"
fi
if [ -z "$BODY" ] && [ -z "$BODY_FILE" ]; then
  echo "error: --body <text> or --body-file <path> required" >&2
  exit "$ORC_ERR_CONFIG"
fi

REPO="$(orc_lib_resolve_repo)"
ARGS=(pr comment "$PR" --repo "$REPO")
[ -n "$BODY" ] && ARGS+=(--body "$BODY")
[ -n "$BODY_FILE" ] && ARGS+=(--body-file "$BODY_FILE")
ARGS+=("${REST[@]:1}")

if [ "$OPT_DRY_RUN" = true ]; then
  echo "[dry-run] gh ${ARGS[*]}" >&2
  echo "[dry-run] (executed via 'orc github gh-env --' when github_app config is present)" >&2
  exit "$ORC_OK"
fi

# Mutating call: service route or typed failure — never silent personal auth.
COMMENT_URL="$(orc_lib_run_or_dry_run ARGS gh)"
echo "Commented on PR #$PR: $COMMENT_URL" >&2
printf '%s\n' "$COMMENT_URL"
