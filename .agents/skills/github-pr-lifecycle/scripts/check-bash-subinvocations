#!/usr/bin/env bash
# Regression guard for #588: skill scripts may land as mode 100644 (the
# App-signed createCommitOnBranch path cannot create 100755), so any direct
# exec of a sibling script fails with exit 126. All intra-skill script
# invocations must go through `bash "$SCRIPT_DIR/<script>"`.
#
# Filtering is PER COMMAND SEGMENT, never per whole line: a line that
# contains both an exempt command (`source`/`cp`/`echo`, or a `bash`-prefixed
# invocation) AND a direct `"$SCRIPT_DIR/<script>"` exec must still be
# flagged. Two whole-line exclusion greps once masked such lines
# (CodeRabbit finding, PR #600).
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

fail=0
while IFS= read -r line; do
  echo "direct exec of sibling script (must be \`bash \"$SCRIPT_DIR/<script>\"\`):"
  echo "  $line"
  fail=1
done < <(grep -rEn '\$\{?SCRIPT_DIR\}?"?/[a-z_-]' \
           "$ROOT/github-pr-lifecycle/scripts" "$ROOT/github-project-workflow/scripts" \
         | grep -v 'scripts/check-bash-subinvocations' \
         | grep -v 'scripts/test-check-bash-subinvocations' \
         | while IFS= read -r hit; do
             # Per-segment analysis of the matched line.
             #
             # A segment is EXEMPT when it:
             #   - is empty, or
             #   - starts with `source`/`cp`/`echo` (not script invocations:
             #     sourcing the shared lib, fixture copies, usage hints), or
             #   - contains no `$SCRIPT_DIR/` reference at all (either the
             #     `$SCRIPT_DIR/` or the braced `${SCRIPT_DIR}/` form), or
             #   - contains only `_lib.sh` references (the shared library
             #     is sourced/copied, never executed, and
             #     `bash "$SCRIPT_DIR/_lib.sh"` is not meaningful), or
             #   - contains a `bash "...$SCRIPT_DIR/..."` invocation (the
             #     required form).
             # A line is flagged when ANY of its segments is a direct
             # (non-bash) sibling invocation.
             #
             # Splitting is two-phase so separators adjacent to redirect
             # digits (e.g. `>&2;`) still yield clean segments: first turn
             # each command separator (`;`, `&&`, `||`, `|`) into newlines,
             # then trim whitespace and leading `!` off each segment. The
             # split pattern does not consume `&` following `>` (fd
             # duplication like `>&2`), so only real command separators
             # split.
             segs="${hit#*:}"
             seg_rest="${segs#*:}"
             direct_exec=0
             while IFS= read -r part; do
               [ -z "$part" ] && continue
               seg="${part#\!}"
               seg="${seg#"${seg%%[![:space:]]*}"}"
               case "$seg" in
                 source\ *|source|cp\ *|cp|echo\ *|echo)
                   # The command is exempt, but a direct sibling exec can
                   # still hide INSIDE a command substitution
                   # (e.g. `echo "$("$SCRIPT_DIR/pr-checks" ...)"` — local
                   # review at b1c2451). Extract each `$( ... )` body —
                   # with balanced-paren depth tracking so nested
                   # substitutions (`$(VAR=$(printf ok) exec)`) yield their
                   # COMPLETE body — and run the same checks on it: strip
                   # bash-prefixed invocations and `_lib.sh` references,
                   # then flag any remaining SCRIPT_DIR reference as a
                   # direct exec.
                   nested_direct=0
                   while IFS= read -r nested; do
                     [ -z "$nested" ] && continue
                     nested="$(printf '%s' "$nested" |
                       sed -E 's/bash "?\$\{?SCRIPT_DIR\}?"?\/[a-z_.-]+//g' |
                       sed -E 's/\$\{?SCRIPT_DIR\}?"?\/_lib\.sh//g')"
                     if printf '%s' "$nested" | grep -qE '\$\{?SCRIPT_DIR\}?"?/[a-z_-]'; then
                       nested_direct=1
                       break
                     fi
                   done < <(printf '%s\n' "$seg" | awk '
                     {
                       s = $0
                       while (match(s, /\$\(/)) {
                         body = ""
                         depth = 1
                         i = RSTART + RLENGTH
                         while (i <= length(s) && depth > 0) {
                           c = substr(s, i, 1)
                           two = substr(s, i, 2)
                           if (two == "$(") { depth++; body = body two; i += 2; continue }
                           if (c == "(") { depth++; body = body c; i++; continue }
                           if (c == ")") { depth--; if (depth > 0) body = body c; i++; continue }
                           body = body c; i++
                         }
                         print body
                         s = substr(s, i)
                       }
                     }')
                   if [ "$nested_direct" -eq 1 ]; then
                     direct_exec=1
                     break
                   fi
                   continue ;;
               esac
               # Strip bash-prefixed invocations (both variable forms); a
               # remaining SCRIPT_DIR reference in the segment is a direct
               # exec.
               seg_wo_bash="$(printf '%s\n' "$seg" |
                 sed -E 's/bash "?\$\{?SCRIPT_DIR\}?"?\/[a-z_.-]+/ORC_BASH_GUARD/g')"
               seg_wo_bash="${seg_wo_bash//ORC_BASH_GUARD/}"
               # Strip _lib.sh references (both forms); they are never
               # sibling-script execs.
               seg_lib_stripped="$(printf '%s' "$seg_wo_bash" |
                 sed -E 's/\$\{?SCRIPT_DIR\}?"?\/_lib\.sh//g')"
               if printf '%s' "$seg_lib_stripped" | grep -qE '\$\{?SCRIPT_DIR\}?"?/[a-z_-]'; then
                 direct_exec=1
               fi
             done < <(printf '%s\n' "$seg_rest" | sed -E 's/([^>!])[;&|]+/\1\n/g; s/^[;&|]+//')
             [ "$direct_exec" -eq 1 ] && printf '%s\n' "$hit"
           done )

if [ "$fail" -eq 0 ]; then
  echo "ok: all sibling script invocations use bash"
fi
exit "$fail"
