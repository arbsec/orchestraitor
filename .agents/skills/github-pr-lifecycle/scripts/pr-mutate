#!/usr/bin/env bash
# pr-mutate: edit / ready / close a PR through the service-identity wrapper.
# Wraps `gh pr edit` / `gh pr ready` / `gh pr close` via orc_lib_gh_service so
# the write attributes to the arbsec-agent GitHub App service identity, never
# a personal account (AGENTS.md critical rules;
# .agents/project/orchestraitor-workflow.md "GitHub service identity").
# `gh pr edit|ready|close` are PR writes exactly like `pr create`/`comment`:
# direct invocation risks personal attribution — the defect this skill
# exists to prevent.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=_lib.sh
source "$SCRIPT_DIR/_lib.sh"

orc_lib_parse_common "$@"

if [ "$OPT_HELP" = true ]; then
  orc_lib_print_help "pr-mutate" "Edit, ready, or close a PR (gh pr edit / ready / close) through the service-identity wrapper. Subcommand is the FIRST positional: edit <pr> [--add-reviewer <login>]... [--add-assignee <login>]... [--add-label <label>]... | ready <pr> | close <pr> [reason flags]."
  exit "$ORC_OK"
fi

REST=("${ORC_LIB_EXTRA_ARGS[@]:-}")
ACTION="${REST[0]:-}"
if [ -z "$ACTION" ]; then
  echo "error: subcommand required (edit | ready | close)" >&2
  exit "$ORC_ERR_CONFIG"
fi
case "$ACTION" in
  edit|ready|close) ;;
  *) echo "error: unknown subcommand \`$ACTION\` (edit | ready | close)" >&2; exit "$ORC_ERR_CONFIG" ;;
esac
REST=("${REST[@]:1}")

PR="${REST[0]:-}"
if [ -z "$PR" ]; then
  echo "error: PR number required" >&2
  exit "$ORC_ERR_CONFIG"
fi
if ! [[ "$PR" =~ ^[0-9]+$ ]]; then
  echo "error: PR number must be numeric, got \`$PR\`" >&2
  exit "$ORC_ERR_CONFIG"
fi
REST=("${REST[@]:1}")

# `edit` has no meaningful effect without at least one edit flag; refuse the
# no-op instead of letting gh error later with an ambiguous message.
if [ "$ACTION" = "edit" ] && [ "${#REST[@]}" -eq 0 ]; then
  echo "error: edit requires at least one edit flag (e.g. --add-reviewer <login>)" >&2
  exit "$ORC_ERR_CONFIG"
fi

REPO="$(orc_lib_resolve_repo)"
ARGS=(pr "$ACTION" "$PR" --repo "$REPO")
[ "${#REST[@]}" -gt 0 ] && ARGS+=("${REST[@]}")

# Reviewer-request gate (workflow policy "PR labeling and human attention"):
# an `edit --add-reviewer` asks for human attention exactly like
# `pr-request-review`, so it carries the same gate — ALL automatic checks
# must pass first (the machine finishes its own verification before
# consuming human attention), and requests are EDGE-TRIGGERED: never
# re-request a reviewer who is already pending or has already approved (a
# re-request forces a second manual approval after every landing). Any other
# edit/ready/close is unaffected.
if [ "$ACTION" = "edit" ] && printf '%s\n' "${REST[@]}" | grep -qx -- "--add-reviewer"; then
  REASONS=()
  REVIEW_STATE="$(orc_lib_gh pr view "$PR" --repo "$REPO" --json reviewRequests,reviews --jq '
    {requests: [.reviewRequests[].login],
     approved: [.reviews[] | select(.state == "APPROVED") | .author.login] | unique}')" ||
    { echo "error: cannot read PR #$PR review state" >&2; exit "$ORC_ERR_UNRECOVERABLE"; }
  PENDING="$(jq -r '.requests | join(",")' <<<"$REVIEW_STATE")"
  APPROVED_BY="$(jq -r '.approved | join(",")' <<<"$REVIEW_STATE")"
  REVIEWERS_TO_ADD=()
  index=0
  while [ "$index" -lt "${#REST[@]}" ]; do
    if [ "${REST[$index]}" = "--add-reviewer" ]; then
      # gh pr edit accepts comma-separated operands; check EVERY reviewer in
      # the operand, not the operand as a whole.
      IFS=',' read -ra operand_reviewers <<< "${REST[$((index + 1))]:-}"
      for reviewer in "${operand_reviewers[@]}"; do
        [ -z "$reviewer" ] && continue
        if printf '%s' "$PENDING" | tr ',' '\n' | grep -qxF "$reviewer" ||
           printf '%s' "$APPROVED_BY" | tr ',' '\n' | grep -qxF "$reviewer"; then
          echo "{\"pr\":$PR,\"requested\":false,\"reviewer\":\"$reviewer\",\"note\":\"edge-triggered: reviewer already pending or approved; post a thread reply that the new head invalidates prior review convergence instead\"}" >&2
          exit "$ORC_ERR_BLOCKED"
        fi
        REVIEWERS_TO_ADD+=("$reviewer")
      done
    fi
    index=$((index + 1))
  done
  CHECKS_JSON="$(mktemp)"
  if ! "$SCRIPT_DIR/pr-checks" "$PR" --repo "$REPO" --json > "$CHECKS_JSON" 2>/dev/null; then
    REASONS+=("pr-checks could not classify checks")
  fi
  if [ -s "$CHECKS_JSON" ]; then
    ALL_PASSED="$(jq -r '.all_passed // false' "$CHECKS_JSON")"
    ANY_PENDING="$(jq -r '.any_pending // false' "$CHECKS_JSON")"
    ANY_FAILING="$(jq -r '.any_failing // false' "$CHECKS_JSON")"
    if [ "$ANY_FAILING" = "true" ]; then
      FAILING_NAMES="$(jq -r '[.checks[] | select(.classification == "fail") | .name] | join(", ")' "$CHECKS_JSON")"
      REASONS+=("checks failing: ${FAILING_NAMES:-unknown}")
    fi
    if [ "$ANY_PENDING" = "true" ]; then
      PENDING_NAMES="$(jq -r '[.checks[] | select(.classification == "pending") | .name] | join(", ")' "$CHECKS_JSON")"
      REASONS+=("checks pending: ${PENDING_NAMES:-unknown}")
    fi
    if [ "$ALL_PASSED" != "true" ] && [ "$ANY_FAILING" != "true" ] && [ "$ANY_PENDING" != "true" ]; then
      REASONS+=("checks not all passed (all_passed=$ALL_PASSED)")
    fi
  fi
  rm -f "$CHECKS_JSON"
  if [ "${#REASONS[@]}" -gt 0 ]; then
    echo "{\"pr\":$PR,\"requested\":false,\"reviewer\":\"--add-reviewer\",\"reasons\":[$(printf '"%s",' "${REASONS[@]}" | sed 's/,$//')]}" >&2
    exit "$ORC_ERR_BLOCKED"
  fi
fi

if [ "$OPT_DRY_RUN" = true ]; then
  echo "[dry-run] gh ${ARGS[*]}" >&2
  echo "[dry-run] (executed via 'orc github gh-env --' when github_app config is present)" >&2
  exit "$ORC_OK"
fi

# Mutating call: service route or typed failure — never silent personal auth.
OUT="$(orc_lib_run_or_dry_run ARGS gh)"
echo "PR #$PR $ACTION done" >&2
if [ -n "$OUT" ]; then
  printf '%s\n' "$OUT"
fi
