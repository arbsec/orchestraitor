#!/usr/bin/env bash
# pr-mutate: edit / ready / close a PR through the service-identity wrapper.
# Wraps `gh pr edit` / `gh pr ready` / `gh pr close` via orc_lib_gh_service so
# the write attributes to the arbsec-agent GitHub App service identity, never
# a personal account (AGENTS.md critical rules;
# .agents/project/orchestraitor-workflow.md "GitHub service identity").
# `gh pr edit|ready|close` are PR writes exactly like `pr create`/`comment`:
# direct invocation risks personal attribution — the defect this skill
# exists to prevent.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=_lib.sh
source "$SCRIPT_DIR/_lib.sh"

orc_lib_parse_common "$@"

if [ "$OPT_HELP" = true ]; then
  orc_lib_print_help "pr-mutate" "Edit, ready, or close a PR (gh pr edit / ready / close) through the service-identity wrapper. Subcommand is the FIRST positional: edit <pr> [--body <text>|--body-file <path>] [--add-reviewer <login>]... [--add-assignee <login>]... [--add-label <label>]... [--inject-checklist] | ready <pr> | close <pr> [reason flags]. Every body route carries the nine managed <!-- orc:* --> merge-checklist markers: --body/--body-file append them UNCHECKED when the supplied body carries none (a body that already carries a marker is set with its content unchanged; only trailing newlines are normalised), so replacing a PR body can never drop the checklist. --body-file is READ by the script and resolved through the trusted-root guard (workspace or temp directory; '-' reads the body from STDIN). A supplied body that ENDS inside an unclosed code fence is refused with exit 2 — appended markers would render as code and be hidden — so close the fence and rerun (append-specific: a body that already carries the checklist is set unchanged); the body is never reordered or repaired. --inject-checklist (edit only) is the same operation for a PR whose body is ALREADY SET: it reads the PR's CURRENT body, appends the markers when it carries none, and sets the body — the one-command remediation path for a PR that already exists and carries no markers (arbsec/orchestraitor#788). When the body already carries the checklist it skips only the body update and still executes any other edit flags."
  exit "$ORC_OK"
fi

REST=("${ORC_LIB_EXTRA_ARGS[@]:-}")
ACTION="${REST[0]:-}"
if [ -z "$ACTION" ]; then
  echo "error: subcommand required (edit | ready | close)" >&2
  exit "$ORC_ERR_CONFIG"
fi
case "$ACTION" in
  edit|ready|close) ;;
  *) echo "error: unknown subcommand \`$ACTION\` (edit | ready | close)" >&2; exit "$ORC_ERR_CONFIG" ;;
esac
REST=("${REST[@]:1}")

PR="${REST[0]:-}"
if [ -z "$PR" ]; then
  echo "error: PR number required" >&2
  exit "$ORC_ERR_CONFIG"
fi
if ! [[ "$PR" =~ ^[0-9]+$ ]]; then
  echo "error: PR number must be numeric, got \`$PR\`" >&2
  exit "$ORC_ERR_CONFIG"
fi
REST=("${REST[@]:1}")

# Body-flow validation (issue #587): `edit --body <value>`/`--body-file <path>`
# resolve `@file` expansion and refuse path-shaped values before the flag ever
# reaches gh — never post a path string as PR content.
#
# `--inject-checklist` is the REMEDIATION path for a PR that ALREADY exists
# and carries no managed marker (arbsec/orchestraitor#788): it reads the
# PR's current body, appends the managed checklist, and sets the body. It is
# extracted here (before the body-flow validation) so it never reaches gh as
# an unknown flag.
INJECT_CHECKLIST=0
if [ "$ACTION" = "edit" ]; then
  PR_MUTATE_REST=()
  index=0
  while [ "$index" -lt "${#REST[@]}" ]; do
    case "${REST[$index]}" in
      --inject-checklist) INJECT_CHECKLIST=1; index=$((index + 1)) ;;
      *) PR_MUTATE_REST+=("${REST[$index]}"); index=$((index + 1)) ;;
    esac
  done
  REST=("${PR_MUTATE_REST[@]}")
fi

# Both body routes ALSO carry the managed checklist (arbsec/orchestraitor#788):
# `pr-create` gives a NEW PR the checklist, `--inject-checklist` remediates a PR
# whose body is already set, and a plain `--body`/`--body-file` edit must not be
# able to UNDO that — a summary-only file would otherwise replace the whole body
# and drop the PR back to `checklist_markers_missing`. The SAME helper
# `pr-create` uses appends the markers (one implementation, no drift), and a
# supplied body that already carries a marker is set with its CONTENT
# unchanged — the routes resolve the body through a command substitution, so
# trailing newlines are normalised and nothing else is altered: author content
# is evidence, never something a helper edits.
PR_MUTATE_BODY_ROOT=""
pr_mutate_ensure_body() {
  orc_lib_ensure_checklist_markers "$1" "$PR_MUTATE_BODY_ROOT"
}
# The gh short-flag table for THIS action: `gh pr edit` can carry a body, so
# its clusters must be resolved; `gh pr ready`/`gh pr close` have no body flag
# at all, so their short tokens cannot carry one and are forwarded verbatim.
case "$ACTION" in
  edit)  PR_MUTATE_SHORT_VALUE="$ORC_LIB_SHORT_VALUE_EDIT"; PR_MUTATE_SHORT_BOOL="$ORC_LIB_SHORT_BOOL_EDIT" ;;
  ready) PR_MUTATE_SHORT_VALUE="$ORC_LIB_SHORT_VALUE_READY"; PR_MUTATE_SHORT_BOOL="$ORC_LIB_SHORT_BOOL_READY" ;;
  close) PR_MUTATE_SHORT_VALUE="$ORC_LIB_SHORT_VALUE_CLOSE"; PR_MUTATE_SHORT_BOOL="$ORC_LIB_SHORT_BOOL_CLOSE" ;;
esac
if [ "$ACTION" = "edit" ]; then
  PR_MUTATE_BODY_ROOT="$(orc_lib_git_toplevel)"
  # The body routes are resolved into a NEW array: a short-flag CLUSTER may
  # expand into several argv entries (its boolean parts plus the body), so the
  # original cannot be edited in place.
  PR_MUTATE_EDITED=()
  index=0
  while [ "$index" -lt "${#REST[@]}" ]; do
    case "${REST[$index]}" in
      --body)
        # A VALUE IS REQUIRED, an EMPTY VALUE IS NOT an error: `--body ""` is an
        # explicit empty body (it becomes the checklist-only body).
        [ "$((index + 1))" -lt "${#REST[@]}" ] || { echo "error: --body requires a value" >&2; exit "$ORC_ERR_CONFIG"; }
        # RESOLVE FIRST, in its OWN assignment. `X="$(f "$(g)")"` takes the
        # OUTER substitution's status, so `g`'s `exit 2` never trips `set -e`:
        # the guard's typed error was printed and the body was then rewritten
        # anyway, exit 0 (#788 gen-3 review — both adversarial sources). The
        # guard's status must BE the assignment's status.
        resolved="$(orc_lib_body_arg "--body" "${REST[$((index + 1))]}")"
        PR_MUTATE_EDITED+=("--body" "$(pr_mutate_ensure_body "$resolved")")
        index=$((index + 2)) ;;
      --body=*)
        resolved="$(orc_lib_body_arg "--body" "${REST[$index]#*=}")"
        PR_MUTATE_EDITED+=("--body=$(pr_mutate_ensure_body "$resolved")")
        index=$((index + 1)) ;;
      # `--body-file` is READ here, not forwarded: the checklist cannot be
      # appended to a path gh expands on its own side. The file itself is never
      # rewritten — the resolved content becomes an explicit `--body` value.
      #
      # The reader is `orc_lib_read_body_file`, NOT `cat`: the delta turned this
      # route from "gh reads the path" into "the script reads the path", so the
      # trusted-root guard has to follow the read. It is the same helper
      # `pr-create` uses, so both routes refuse an out-of-root path with exit 2
      # (#599), resolve symlinks on the FULL target, refuse an empty body, and
      # accept `-` for STDIN (#788 gen-3 review).
      --body-file)
        [ "$((index + 1))" -lt "${#REST[@]}" ] || { echo "error: --body-file requires a path" >&2; exit "$ORC_ERR_CONFIG"; }
        resolved="$(orc_lib_read_body_file "--body-file" "${REST[$((index + 1))]}")"
        PR_MUTATE_EDITED+=("--body=$(pr_mutate_ensure_body "$resolved")")
        index=$((index + 2)) ;;
      --body-file=*)
        resolved="$(orc_lib_read_body_file "--body-file" "${REST[$index]#*=}")"
        PR_MUTATE_EDITED+=("--body=$(pr_mutate_ensure_body "$resolved")")
        index=$((index + 1)) ;;
      --*)
        # Every other LONG flag is gh's to interpret: it is forwarded untouched.
        PR_MUTATE_EDITED+=("${REST[$index]}"); index=$((index + 1)) ;;
      -?*)
        # Every single-dash token is resolved with pflag's rules, so a CLUSTER
        # that carries a body (`-fbX`, `-dbX`, `-fF/path`) cannot slip past the
        # composition helper (arbsec/orchestraitor#799 R16).
        if ! orc_lib_split_short_cluster "${REST[$index]}" \
          "$PR_MUTATE_SHORT_VALUE" "$PR_MUTATE_SHORT_BOOL"; then
          echo "error: refusing to forward '${REST[$index]}': its short flags cannot be resolved, and it could carry a body" >&2
          echo "  gh accepts only the short flags this wrapper knows; an unresolved cluster is refused rather than forwarded unvalidated (arbsec/orchestraitor#799 R16)" >&2
          echo "  fix: pass the flag in its long form (--body, --body-file, --title, --milestone, --base)" >&2
          exit "$ORC_ERR_CONFIG"
        fi
        if [ "$ORC_LIB_CLUSTER_HAS_BODY" = true ]; then
          orc_cluster_value="$ORC_LIB_CLUSTER_BODY_VALUE"
          if [ "$ORC_LIB_CLUSTER_BODY_EXTERNAL" = true ]; then
            [ "$((index + 1))" -lt "${#REST[@]}" ] || { echo "error: ${REST[$index]} requires a value" >&2; exit "$ORC_ERR_CONFIG"; }
            orc_cluster_value="${REST[$((index + 1))]}"
            index=$((index + 1))
          fi
          case "$ORC_LIB_CLUSTER_BODY_KIND" in
            body)
              resolved="$(orc_lib_body_arg "--body" "$orc_cluster_value")"
              PR_MUTATE_EDITED+=("--body" "$(pr_mutate_ensure_body "$resolved")") ;;
            body-file)
              resolved="$(orc_lib_read_body_file "--body-file" "$orc_cluster_value")"
              PR_MUTATE_EDITED+=("--body" "$(pr_mutate_ensure_body "$resolved")") ;;
          esac
          # The boolean parts of the cluster keep their meaning and are
          # forwarded as their own tokens.
          if [ "${#ORC_LIB_CLUSTER_BOOLS[@]}" -gt 0 ]; then
            PR_MUTATE_EDITED+=("${ORC_LIB_CLUSTER_BOOLS[@]}")
          fi
        else
          PR_MUTATE_EDITED+=("${REST[$index]}")
        fi
        index=$((index + 1)) ;;
      *) PR_MUTATE_EDITED+=("${REST[$index]}"); index=$((index + 1)) ;;
    esac
  done
  REST=("${PR_MUTATE_EDITED[@]}")
fi

# `--inject-checklist` SETS the body itself; combining it with an explicit
# body is ambiguous (which body wins?) — refuse instead of guessing.
if [ "$INJECT_CHECKLIST" = "1" ]; then
  PR_MUTATE_BODY_CONFLICT=0
  index=0
  while [ "$index" -lt "${#REST[@]}" ]; do
    case "${REST[$index]}" in
      --body|--body=*|--body-file|--body-file=*) PR_MUTATE_BODY_CONFLICT=1 ;;
    esac
    index=$((index + 1))
  done
  if [ "$PR_MUTATE_BODY_CONFLICT" = "1" ]; then
    echo "error: --inject-checklist cannot be combined with --body/--body-file — it sets the body itself (current body + the managed checklist)" >&2
    exit "$ORC_ERR_CONFIG"
  fi
fi

# `edit` has no meaningful effect without at least one edit flag; refuse the
# no-op instead of letting gh error later with an ambiguous message.
if [ "$ACTION" = "edit" ] && [ "${#REST[@]}" -eq 0 ] && [ "$INJECT_CHECKLIST" != "1" ]; then
  echo "error: edit requires at least one edit flag (e.g. --add-reviewer <login>, or --inject-checklist)" >&2
  exit "$ORC_ERR_CONFIG"
fi

REPO="$(orc_lib_resolve_repo)"
ARGS=(pr "$ACTION" "$PR" --repo "$REPO")
[ "${#REST[@]}" -gt 0 ] && ARGS+=("${REST[@]}")

# --- Managed-checklist remediation for an ALREADY-OPEN PR (arbsec/orchestraitor#788) ---
# `convergence-status` FAILS CLOSED on a body with zero `<!-- orc:* -->`
# markers (`checklist_markers_missing`), and `pr-create` now gives a NEW PR
# the managed checklist. A PR that ALREADY EXISTS (opened before that rule, or
# opened by a bot) has no such body and would block forever — so this is the
# one-command remediation path for a body that is ALREADY SET: read the current
# body, append the managed checklist when it carries none, and set the body.
# (A summary being supplied right now does not need this flag: the `--body`/
# `--body-file` routes above carry the checklist themselves.)
#
# The nine markers land UNCHECKED (a checked box is a verified fact). A body
# that already carries the checklist is left unchanged — the operation is
# idempotent and never rewrites author content.
if [ "$ACTION" = "edit" ] && [ "$INJECT_CHECKLIST" = "1" ]; then
  if [ "$OPT_DRY_RUN" = true ]; then
    echo "[dry-run] would read PR #$PR's body, append the managed merge checklist, and set it (dry-run never reaches gh)" >&2
    exit "$ORC_OK"
  fi
  PR_MUTATE_BODY="$(orc_lib_gh pr view "$PR" --repo "$REPO" --json body --jq '.body // ""')" || {
    echo "error: cannot read PR #$PR body" >&2
    exit "$ORC_ERR_UNRECOVERABLE"
  }
  PR_MUTATE_NEW_BODY="$(pr_mutate_ensure_body "$PR_MUTATE_BODY")"
  if [ "$PR_MUTATE_NEW_BODY" = "$PR_MUTATE_BODY" ]; then
    # Only the BODY update is skipped: the caller may have asked for other
    # mutations in the same invocation (`--add-label`, `--add-assignee`,
    # `--add-reviewer`, …). Exiting here silently discarded them (#788 gen-3
    # review, CodeRabbit minor) — a no-op must be a no-op for the BODY only.
    echo "PR #$PR body already carries the managed merge checklist — body update skipped" >&2
    if [ "${#REST[@]}" -eq 0 ]; then
      echo "  (no other edit flag was given; nothing left to do)" >&2
      exit "$ORC_OK"
    fi
    echo "  the remaining edit flags are still executed" >&2
  else
    ARGS+=(--body "$PR_MUTATE_NEW_BODY")
    echo "NOTE: appending the managed merge checklist to PR #$PR's body (arbsec/orchestraitor#788)" >&2
  fi
fi

# Reviewer-request gate (workflow policy "PR labeling and human attention"):
# an `edit --add-reviewer` asks for human attention exactly like
# `pr-request-review`, so it carries the same gate — ALL automatic checks
# must pass first (the machine finishes its own verification before
# consuming human attention), and requests are EDGE-TRIGGERED: never
# re-request a reviewer who is already pending or has already approved (a
# re-request forces a second manual approval after every landing). Any other
# edit/ready/close is unaffected.
if [ "$ACTION" = "edit" ] && printf '%s\n' "${REST[@]}" | grep -qx -- "--add-reviewer"; then
  REASONS=()
  REVIEW_STATE="$(orc_lib_gh pr view "$PR" --repo "$REPO" --json reviewRequests,reviews --jq '
    {requests: [.reviewRequests[].login],
     approved: [.reviews[] | select(.state == "APPROVED") | .author.login] | unique}')" ||
    { echo "error: cannot read PR #$PR review state" >&2; exit "$ORC_ERR_UNRECOVERABLE"; }
  PENDING="$(jq -r '.requests | join(",")' <<<"$REVIEW_STATE")"
  APPROVED_BY="$(jq -r '.approved | join(",")' <<<"$REVIEW_STATE")"
  REVIEWERS_TO_ADD=()
  index=0
  while [ "$index" -lt "${#REST[@]}" ]; do
    if [ "${REST[$index]}" = "--add-reviewer" ]; then
      # gh pr edit accepts comma-separated operands; check EVERY reviewer in
      # the operand, not the operand as a whole.
      IFS=',' read -ra operand_reviewers <<< "${REST[$((index + 1))]:-}"
      operand_has_login=false
      for reviewer in "${operand_reviewers[@]}"; do
        [ -z "$reviewer" ] && continue
        operand_has_login=true
        if printf '%s' "$PENDING" | tr ',' '\n' | grep -qxF "$reviewer" ||
           printf '%s' "$APPROVED_BY" | tr ',' '\n' | grep -qxF "$reviewer"; then
          echo "{\"pr\":$PR,\"requested\":false,\"reviewer\":\"$reviewer\",\"note\":\"edge-triggered: reviewer already pending or approved; post a thread reply that the new head invalidates prior review convergence instead\"}" >&2
          exit "$ORC_ERR_BLOCKED"
        fi
        REVIEWERS_TO_ADD+=("$reviewer")
      done
      # An operand of only delimiters (",,") parses to zero reviewer names;
      # gh cli#7721 shows empty reviewer arrays REMOVE existing reviewers.
      # Reject the operand instead of forwarding it.
      if [ "$operand_has_login" = false ]; then
        echo "error: --add-reviewer operand '${REST[$((index + 1))]:-}' contains no reviewer login" >&2
        exit "$ORC_ERR_CONFIG"
      fi
    fi
    index=$((index + 1))
  done
  CHECKS_JSON="$(mktemp)"
  PR_CHECKS_ERR="$(mktemp)"
  # `bash`-invoke (not direct exec): the skill scripts are landed at mode
  # 100644 — a kept choice (#709), because the executable bit is not
  # guaranteed in every checkout. The RAW `createCommitOnBranch` payload cannot
  # express 100755 (#556; `orc github push-branch` lands a 100755 file through
  # the REST tree + commit transport, but the scripts stay 100644), so a
  # flattened checkout must still work. Read-only script, safe to run via bash.
  if ! bash "$SCRIPT_DIR/pr-checks" "$PR" --repo "$REPO" --json > "$CHECKS_JSON" 2>"$PR_CHECKS_ERR"; then
    # Surface WHY classification failed (e.g. CI-only stub/gh differences):
    # the stderr is bounded diagnostic text, safe to echo into the reason.
    PR_CHECKS_DETAIL="$(head -c 300 "$PR_CHECKS_ERR" | tr '\n' ' ')"
    REASONS+=("pr-checks could not classify checks (stderr: ${PR_CHECKS_DETAIL:-<empty>})")
  fi
  rm -f "$PR_CHECKS_ERR"
  if [ -s "$CHECKS_JSON" ]; then
    ALL_PASSED="$(jq -r '.all_passed // false' "$CHECKS_JSON")"
    ANY_PENDING="$(jq -r '.any_pending // false' "$CHECKS_JSON")"
    ANY_FAILING="$(jq -r '.any_failing // false' "$CHECKS_JSON")"
    if [ "$ANY_FAILING" = "true" ]; then
      FAILING_NAMES="$(jq -r '[.checks[] | select(.classification == "fail") | .name] | join(", ")' "$CHECKS_JSON")"
      REASONS+=("checks failing: ${FAILING_NAMES:-unknown}")
    fi
    if [ "$ANY_PENDING" = "true" ]; then
      PENDING_NAMES="$(jq -r '[.checks[] | select(.classification == "pending") | .name] | join(", ")' "$CHECKS_JSON")"
      REASONS+=("checks pending: ${PENDING_NAMES:-unknown}")
    fi
    if [ "$ALL_PASSED" != "true" ] && [ "$ANY_FAILING" != "true" ] && [ "$ANY_PENDING" != "true" ]; then
      REASONS+=("checks not all passed (all_passed=$ALL_PASSED)")
    fi
  fi
  rm -f "$CHECKS_JSON"
  if [ "${#REASONS[@]}" -gt 0 ]; then
    # jq builds the JSON so embedded quotes/backslashes/newlines in reason
    # text (e.g. pr-checks stderr) can never produce invalid JSON.
    printf '%s\n' "${REASONS[@]}" | jq -R . | jq -s \
      --argjson pr "$PR" \
      '{"pr":$pr,"requested":false,"reviewer":"--add-reviewer","reasons":.}' >&2
    exit "$ORC_ERR_BLOCKED"
  fi
fi

if [ "$OPT_DRY_RUN" = true ]; then
  echo "[dry-run] gh ${ARGS[*]}" >&2
  echo "[dry-run] (executed via 'orc github gh-env --' when github_app config is present)" >&2
  exit "$ORC_OK"
fi

# Mutating call: service route or typed failure — never silent personal auth.
OUT="$(orc_lib_run_or_dry_run ARGS gh)"
echo "PR #$PR $ACTION done" >&2
if [ -n "$OUT" ]; then
  printf '%s\n' "$OUT"
fi
