#!/usr/bin/env bash
# Regression tests for WHERE the review gate lives (arbsec/orchestraitor#733,
# rewired by arbsec/orchestraitor#799 R18).
#
# History: this file used to test the CREATE-time gate's base resolution — a
# fail-open defect where a stale local `main` became the gate's base. That gate
# is now DELETED, because `pr-create` no longer parses the caller's argv (R17) and
# therefore cannot know which base `gh` will use: `pr-create --base release`
# creates against `release` while a create-time gate could only validate evidence
# for the repository default, so evidence for `main` would authorise a `release`
# PR. A gate that cannot bind to the base it is gating is worse than no gate.
#
# What replaces it — and what this suite now asserts:
#   (a) NO create-time gate: a PR is created with no review record at all, in
#       EVERY checkout shape (normal worktree, no `origin` remote, a `--depth 1`
#       detached clone with no `origin/HEAD`) — the shapes whose differing exit
#       code made the old suite fail only in CI;
#   (b) `--skip-review-gate` is a NO-OP for compatibility: consumed, never
#       forwarded to gh, and changes nothing;
#   (c) a caller `--base` is forwarded VERBATIM and cannot influence anything —
#       there is no create-time gate to influence;
#   (d) the gate that DOES bind is the MERGE-time one: `convergence-status`
#       refuses a CLEAN record whose `- base OID:` differs from the PR's actual
#       `baseRefOid`, so a wrong-base record can never merge.
#
# Hermetic: local `git init` fixtures, stubbed `gh`/`orc`/`pr-checks`/
# `review-threads`/`reconcile-checklist` on PATH; no network, no credentials.
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT
mkdir -p "$TMP/bin" "$TMP/harness"
GIT_ID=(-c user.name=skills-test -c user.email=skills-test@example.invalid)

PASS=0; FAIL=0
assert() {
  if [ "$2" = "$3" ]; then PASS=$((PASS+1)); echo "PASS: $1"
  else FAIL=$((FAIL+1)); printf 'FAIL: %s\n  expected: %s\n  actual: %s\n' "$1" "$2" "$3"; fi
}
count() { grep -cF -- "$2" "$1" 2>/dev/null || true; }

# The scripts are driven from a copy OUTSIDE every fixture repo: files inside the
# work tree would otherwise be picked up by the fixtures' own `git add -A`.
cp -L -- "$SCRIPT_DIR/_lib.sh" "$SCRIPT_DIR/pr-create" "$SCRIPT_DIR/convergence-status" "$TMP/harness/"

# gh stub: records every call; `pr view` answers the two reads convergence-status
# makes. `pr create` prints a URL (pr-create only ever reaches it in --dry-run
# here, so a real invocation would be a defect).
cat > "$TMP/bin/gh" <<'STUB'
#!/usr/bin/env bash
printf '%s\n' "$*" >> "$GH_LOG"
case "$1/${2:-}" in
  auth/status) exit 0 ;;
  pr/view)
    json=""
    for a in "$@"; do case "$prev" in --json) json="$a" ;; esac; prev="$a"; done
    case "$json" in
      baseRefOid) jq -n --arg b "$TEST_BASE" '{baseRefOid:$b}' ;;
      reviewDecision,baseRefOid,headRefOid,isDraft)
        jq -n --arg h "$TEST_HEAD" --arg b "$TEST_BASE" \
          '{reviewDecision:"APPROVED",baseRefOid:$b,headRefOid:$h,isDraft:false}' ;;
      *) echo "unexpected gh pr view --json '$json'" >&2; exit 1 ;;
    esac ;;
  pr/create) printf 'https://example.invalid/pull/7\n' ;;
  *) echo "unexpected gh call: $*" >&2; exit 1 ;;
esac
STUB
cat > "$TMP/bin/orc" <<'STUB'
#!/usr/bin/env bash
case "$1/${2:-}" in
  config/validate) exit 0 ;;
  config/get) echo stub ;;
  github/gh-env) shift 3; exec "$@" ;;
  github/gh-env-pr-create-chain) shift 4; exec "$@" ;;
  *) exit 0 ;;
esac
STUB
chmod +x "$TMP/bin/gh" "$TMP/bin/orc"
export PATH="$TMP/bin:/usr/bin:/bin"
export ORC_BIN="$TMP/bin/orc" GH_BIN="$TMP/bin/gh"
export GH_LOG="$TMP/gh.log"
export ORC_GITHUB_APP_ENFORCEMENT=required
: > "$GH_LOG"
# convergence-status's other sub-checks are stubbed here; their own suites cover
# them. This suite only needs the REVIEW-RECORD leg.
cat > "$TMP/bin/pr-checks" <<'STUB'
#!/usr/bin/env bash
printf '%s\n' '{"all_passed":true,"any_pending":false}'
STUB
cat > "$TMP/bin/review-threads" <<'STUB'
#!/usr/bin/env bash
printf '%s\n' '{"unresolved_actionable":0}'
STUB
cat > "$TMP/bin/reconcile-checklist" <<'STUB'
#!/usr/bin/env bash
printf '%s\n' '{"markers_present":true,"marker_count":9,"all_checked":true,"unparseable":false,"unchecked":[]}'
STUB
chmod +x "$TMP/bin/pr-checks" "$TMP/bin/review-threads" "$TMP/bin/reconcile-checklist"

# --- (a) NO create-time gate, in EVERY checkout shape ---------------------------
# The three shapes are the ones whose differing gate exit code made the old suite
# green locally and red in CI: a normal worktree WITH `origin/HEAD`, a repo with
# NO `origin` remote, and a `--depth 1` detached clone with no `origin/HEAD`.
make_repo() { # <dir> [with-origin]
  local dir="$1" with_origin="${2:-yes}"
  git init -q -b main "$dir"
  printf 'base\n' > "$dir/file.txt"
  git -C "$dir" add -A
  git -C "$dir" "${GIT_ID[@]}" commit -q -m base
  if [ "$with_origin" = yes ]; then
    git init -q --bare "$dir-origin.git"
    git -C "$dir" remote add origin "$dir-origin.git"
    git -C "$dir" push -q origin main
    git -C "$dir" fetch -q origin
    git -C "$dir" remote set-head origin main
  fi
}
create_in() { # create_in <dir> [extra args...] : pr-create --dry-run, output captured
  local dir="$1"; shift
  ( cd "$dir" && bash "$TMP/harness/pr-create" --title t --body b \
      --repo test-org/repo --dry-run "$@" ) 2>&1
}

# (a1) a normal worktree: created, no gate message, no record needed.
make_repo "$TMP/a1" yes
: > "$GH_LOG"
OUT="$(create_in "$TMP/a1")"; RC=$?
assert 'normal worktree: pr-create exits 0 with NO review record' 0 "$RC"
case "$OUT" in *pre-review-gate*) GATE_MSG=yes ;; *) GATE_MSG=no ;; esac
assert 'normal worktree: no gate text on stderr' no "$GATE_MSG"
case "$OUT" in *'[dry-run] gh pr create'*) REACHED=yes ;; *) REACHED=no ;; esac
assert 'normal worktree: the create command is prepared' yes "$REACHED"

# (a2) NO `origin` remote at all: the old gate exited 6 here.
make_repo "$TMP/a2" no
OUT="$(create_in "$TMP/a2")"; RC=$?
assert 'no origin remote: pr-create still exits 0' 0 "$RC"
case "$OUT" in *'cannot resolve'*) RESOLVE_MSG=yes ;; *) RESOLVE_MSG=no ;; esac
assert 'no origin remote: no base-resolution refusal' no "$RESOLVE_MSG"

# (a3) a --depth 1 detached clone with no `origin/HEAD` (the CI shape).
git clone -q --depth 1 "file://$TMP/a2" "$TMP/a3" 2>/dev/null || cp -a "$TMP/a2" "$TMP/a3"
( cd "$TMP/a3" && git checkout -q --detach HEAD 2>/dev/null && git remote set-head origin -d 2>/dev/null ) || true
OUT="$(create_in "$TMP/a3")"; RC=$?
assert 'CI shape (shallow, detached, no origin/HEAD): pr-create exits 0' 0 "$RC"
assert 'CI shape: no gate message' 0 "$(grep -c 'pre-review-gate' <<<"$OUT" || true)"

# --- (b) --skip-review-gate is a NO-OP ------------------------------------------
: > "$GH_LOG"
OUT="$(create_in "$TMP/a1" --skip-review-gate)"; RC=$?
assert 'skip flag: still exits 0' 0 "$RC"
case "$OUT" in *--skip-review-gate*) FORWARDED=yes ;; *) FORWARDED=no ;; esac
assert 'skip flag: consumed, never forwarded to gh' no "$FORWARDED"
assert 'skip flag: no gate notice either' 0 "$(grep -c 'SKIPPED via --skip-review-gate' <<<"$OUT" || true)"

# --- (c) a caller --base is forwarded verbatim and gates nothing ----------------
OUT="$(create_in "$TMP/a1" --base release)"
case "$OUT" in *'pr create --repo test-org/repo --title t --body b --base release'*)
  BASE_FWD=yes ;; *) BASE_FWD=no ;; esac
assert 'caller --base: forwarded verbatim, in the caller order' yes "$BASE_FWD"
assert 'caller --base: no base-resolution text anywhere' 0 "$(grep -c 'refs/remotes/origin' <<<"$OUT" || true)"

# --- (d) the gate that BINDS is the MERGE-time one ------------------------------
# convergence-status requires the CLEAN record's `- base OID:` to equal the PR's
# ACTUAL baseRefOid. A record for a different base must NOT pass — that is what
# makes a wrong-base PR unmergeable now that creation is ungated.
#
# The scripts live INSIDE the fixture repo and are committed into the base, because
# convergence-status refuses to run policy that is not the trusted base's copy
# (`orc_lib_require_policy_current`): a copy outside a checkout is refused (exit 6)
# before any verdict, which is a different assertion than the one this section makes.
make_repo "$TMP/d1" yes
D_REPO_SCRIPTS="$TMP/d1/.agents/skills/github-pr-lifecycle/scripts"
mkdir -p "$D_REPO_SCRIPTS"
cp -L -- "$TMP/harness/_lib.sh" "$TMP/harness/convergence-status" "$D_REPO_SCRIPTS/"
cp -L -- "$TMP/bin/pr-checks" "$TMP/bin/review-threads" "$TMP/bin/reconcile-checklist" "$D_REPO_SCRIPTS/"
git -C "$TMP/d1" add -A
git -C "$TMP/d1" "${GIT_ID[@]}" commit -q -m 'fixture: review policy at the base'
D_HEAD="$(git -C "$TMP/d1" rev-parse HEAD)"
git -C "$TMP/d1" checkout -q -b feature
printf 'feature\n' > "$TMP/d1/feature.txt"
git -C "$TMP/d1" add -A
git -C "$TMP/d1" "${GIT_ID[@]}" commit -q -m feature
TEST_HEAD="$(git -C "$TMP/d1" rev-parse HEAD)"
TEST_BASE="$D_HEAD"
export TEST_HEAD TEST_BASE
# Sanity: the fixture must exercise the guard, not a refusal — the committed policy
# copy and the running copy are the same bytes.
assert 'merge-time fixture: the running policy is the base copy' \
  "$(git -C "$TMP/d1" rev-parse "HEAD:.agents/skills/github-pr-lifecycle/scripts/convergence-status")" \
  "$(git -C "$TMP/d1" hash-object -- "$D_REPO_SCRIPTS/convergence-status")"
mkdir -p "$TMP/d1/.orchestraitor/reviews"
write_record() { # <base-oid>
  cat > "$TMP/d1/.orchestraitor/reviews/7-$(git -C "$TMP/d1" rev-parse --short=7 "$TEST_HEAD").md" <<EOF
# Agent review record: PR #7 @ $(git -C "$TMP/d1" rev-parse --short=7 "$TEST_HEAD")

- verdict: CLEAN
- reviewer-agent: test
- head SHA: $TEST_HEAD
- base OID: $1
- findings: 0
EOF
}
run_conv() {
  ( cd "$TMP/d1" && bash "$D_REPO_SCRIPTS/convergence-status" 7 --repo test-org/repo --json )
}
# (d1) a record for the WRONG base (the pre-fork commit) is refused.
write_record "$(git -C "$TMP/d1" rev-parse "$D_HEAD^")"
OUT="$(run_conv)"; RC=$?
assert 'merge-time: a wrong-base record BLOCKS convergence' 5 "$RC"
assert 'merge-time: and the reason is the review record' 1 \
  "$(grep -c 'agent_review_not_clean_at_head' <<<"$OUT")"
# (d2) the same record with the RIGHT base passes.
write_record "$TEST_BASE"
OUT="$(run_conv)"; RC=$?
assert 'merge-time: the right-base record converges' 0 "$RC"

printf '\n=== gate-base: %s passed, %s failed ===\n' "$PASS" "$FAIL"
[ "$FAIL" -eq 0 ]
