#!/usr/bin/env bash
# pr-thread-reply: reply to an inline PR review comment ON ITS THREAD through
# the service-identity wrapper.
#
# Owner directive (2026-10-07): when commenting on a fixed conversation, the
# agent comments IN that conversation — never as a standalone main-thread PR
# comment. Main-thread comments belong to pr-comment; this script exists so
# remediation answers land on the review-comment thread they answer.
#
# When NOT to use this script:
#   - PR-level summaries, formal resolutions of non-thread findings, gate
#     verdicts -> pr-comment (main-thread).
#   - Resolving a thread WITHOUT replying -> `review-threads` is fetch-only;
#     resolve via GraphQL (see references/review-thread-reply.md) or pass
#     --resolve here after posting the reply.
#
# Usage:
#   pr-thread-reply <pr-number> <comment-id> <body-file> [-R repo] [--resolve <thread-id>]
#   pr-thread-reply <pr-number> <comment-id> -f body=<text> [-R repo] [--resolve <thread-id>]
#
# The reply is POSTed to the REST replies endpoint:
#   POST repos/{owner}/{repo}/pulls/{pull_number}/comments/{comment-id}/replies -f body=...
# With --resolve <thread-id>, additionally runs the GraphQL mutation:
#   mutation { resolveReviewThread(input: { threadId: $threadId }) { thread { id isResolved } } }
#
# Mutating: routes through orc_lib_gh_service (fails closed without the
# service identity — never personal auth). --dry-run prints the exact calls.
#
# Exit codes: 0 ok | 1 unrecoverable | 2 config/state | 3 policy | 4 concurrent | 5 blocked.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=_lib.sh
source "$SCRIPT_DIR/_lib.sh"

orc_lib_parse_common "$@"

if [ "$OPT_HELP" = true ]; then
  orc_lib_print_help "pr-thread-reply" "Reply to an inline review comment on its thread (REST replies endpoint) via the service-identity wrapper. Positional: <pr-number> <comment-id> <body-file | -f body=...>. Flags: --resolve <thread-id>."
  exit "$ORC_OK"
fi

BODY=""
BODY_FILE=""
RESOLVE_THREAD_ID=""
REST=()
while [ "${#ORC_LIB_EXTRA_ARGS[@]}" -gt 0 ]; do
  case "${ORC_LIB_EXTRA_ARGS[0]}" in
    -f)
      [ -n "${ORC_LIB_EXTRA_ARGS[1]:-}" ] || { echo "error: -f requires a key=value argument" >&2; exit "$ORC_ERR_CONFIG"; }
      case "${ORC_LIB_EXTRA_ARGS[1]}" in
        body=*) BODY="${ORC_LIB_EXTRA_ARGS[1]#body=}" ;;
        *) echo "error: -f expects body=<text>, got \`${ORC_LIB_EXTRA_ARGS[1]}\`" >&2; exit "$ORC_ERR_CONFIG" ;;
      esac
      ORC_LIB_EXTRA_ARGS=("${ORC_LIB_EXTRA_ARGS[@]:2}") ;;
    -f=*)
      # `-f=body=<text>`: strip only the `-f=` prefix, then apply the same
      # key=value contract as the bare `-f` form (reject non-body keys).
      kv="${ORC_LIB_EXTRA_ARGS[0]#-f=}"
      case "$kv" in
        body=*) BODY="${kv#body=}" ;;
        *) echo "error: -f expects body=<text>, got \`${ORC_LIB_EXTRA_ARGS[0]}\`" >&2; exit "$ORC_ERR_CONFIG" ;;
      esac
      ORC_LIB_EXTRA_ARGS=("${ORC_LIB_EXTRA_ARGS[@]:1}") ;;
    --resolve)
      [ -n "${ORC_LIB_EXTRA_ARGS[1]:-}" ] || { echo "error: --resolve requires a thread ID" >&2; exit "$ORC_ERR_CONFIG"; }
      RESOLVE_THREAD_ID="${ORC_LIB_EXTRA_ARGS[1]}"; ORC_LIB_EXTRA_ARGS=("${ORC_LIB_EXTRA_ARGS[@]:2}") ;;
    --resolve=*) RESOLVE_THREAD_ID="${ORC_LIB_EXTRA_ARGS[0]#*=}"; ORC_LIB_EXTRA_ARGS=("${ORC_LIB_EXTRA_ARGS[@]:1}") ;;
    *)      REST+=("${ORC_LIB_EXTRA_ARGS[0]}"); ORC_LIB_EXTRA_ARGS=("${ORC_LIB_EXTRA_ARGS[@]:1}") ;;
  esac
done

PR="${REST[0]:-}"
COMMENT_ID="${REST[1]:-}"
BODY_FILE="${REST[2]:-}"
if [ -z "$PR" ] || ! [[ "$PR" =~ ^[0-9]+$ ]]; then
  echo "error: numeric PR number required as the first positional" >&2
  exit "$ORC_ERR_CONFIG"
fi
if [ -z "$COMMENT_ID" ] || ! [[ "$COMMENT_ID" =~ ^[0-9]+$ ]]; then
  echo "error: numeric review-comment ID required as the second positional" >&2
  exit "$ORC_ERR_CONFIG"
fi
if [ -z "$BODY" ] && [ -z "$BODY_FILE" ]; then
  echo "error: a body file path or -f body=<text> is required" >&2
  exit "$ORC_ERR_CONFIG"
fi
if [ -n "$BODY_FILE" ] && [ ! -f "$BODY_FILE" ]; then
  echo "error: body file not found: $BODY_FILE" >&2
  exit "$ORC_ERR_CONFIG"
fi

REPO="$(orc_lib_resolve_repo)"
# A reply to a reply is posted on the THREAD ROOT: GitHub's replies endpoint
# requires the top-level comment ID (`in_reply_to_id` must name the root), so
# a caller-supplied reply ID is resolved to its thread root first. The GET
# endpoint for a SINGLE review comment is repos/$REPO/pulls/comments/<id>
# (no pulls/$PR segment); a failure to LOOK UP the comment is a typed error,
# never silently treated as a root comment.
THREAD_ROOT_ID="$COMMENT_ID"
IN_REPLY_TO="$(ORC_GITHUB_APP_ENFORCEMENT=required orc_lib_gh_service api "repos/$REPO/pulls/comments/$COMMENT_ID" --jq '.in_reply_to_id // empty')" || {
  echo "error: cannot look up review comment $COMMENT_ID (GET repos/$REPO/pulls/comments/$COMMENT_ID failed)" >&2
  exit "$ORC_ERR_UNRECOVERABLE"
}
if [ -n "$IN_REPLY_TO" ]; then
  THREAD_ROOT_ID="$IN_REPLY_TO"
fi

if [ -n "$BODY_FILE" ]; then
  REPLY_ARGS=(api "repos/$REPO/pulls/$PR/comments/$THREAD_ROOT_ID/replies" -F body=@"$BODY_FILE")
else
  REPLY_ARGS=(api "repos/$REPO/pulls/$PR/comments/$THREAD_ROOT_ID/replies" -f body="$BODY")
fi

if [ "$OPT_DRY_RUN" = true ]; then
  echo "[dry-run] gh ${REPLY_ARGS[*]}" >&2
  echo "[dry-run] (executed via 'orc github gh-env --' when github_app config is present)" >&2
  if [ -n "$RESOLVE_THREAD_ID" ]; then
    RESOLVE_ARGS=(-f query='mutation($threadId: ID!) { resolveReviewThread(input: { threadId: $threadId }) { thread { id isResolved } } }' -F threadId="$RESOLVE_THREAD_ID")
    echo "[dry-run] gh api graphql ${RESOLVE_ARGS[*]}" >&2
  fi
  exit "$ORC_OK"
fi

# Mutating call: service route or typed failure — never silent personal auth.
# ORC_GITHUB_APP_ENFORCEMENT=required is pinned (env wins over layered config):
# even when the github_app config is absent/incomplete, the labelled
# personal-account fallback is refused — the reply/resolve mutations MUST
# attribute to the App service identity (owner mandate 2026-10-02).
REPLY_OUT="$(ORC_GITHUB_APP_ENFORCEMENT=required orc_lib_run_or_dry_run REPLY_ARGS gh)" || {
  echo "error: failed to post the thread reply on PR #$PR comment $COMMENT_ID" >&2
  exit "$ORC_ERR_UNRECOVERABLE"
}
REPLY_URL="$(printf '%s' "$REPLY_OUT" | jq -r '.html_url // empty' 2>/dev/null)" || REPLY_URL=""
echo "Replied on PR #$PR comment thread $COMMENT_ID${REPLY_URL:+: $REPLY_URL}" >&2

if [ -n "$RESOLVE_THREAD_ID" ]; then
  # Thread-identity guard: the resolved thread must CONTAIN the comment that
  # was replied to (its root or any of its replies). Resolving an unrelated
  # thread would mark a conversation as addressed that this reply never
  # answered. Query the SUPPLIED thread by its GraphQL id directly (no
  # pagination over the PR's thread list) and verify it belongs to this PR
  # and contains the comment that was replied to; a mismatch is a typed
  # failure, never a silent resolve.
  THREAD_CHECK="$(ORC_GITHUB_APP_ENFORCEMENT=required orc_lib_gh_service api graphql 2>/dev/null \
    -f id="$RESOLVE_THREAD_ID" \
    -f query='query($id:ID!){node(id:$id){... on PullRequestReviewThread{id isResolved comments(first:100){nodes{databaseId}} pullRequest{number repository{name owner{login}}}}}}')" || THREAD_CHECK=""
  if [ -z "$THREAD_CHECK" ]; then
    echo "error: cannot verify thread identity for $RESOLVE_THREAD_ID (thread read failed)" >&2
    exit "$ORC_ERR_UNRECOVERABLE"
  fi
  if ! printf '%s' "$THREAD_CHECK" | jq -e \
       --argjson cid "$COMMENT_ID" --argjson pr "$PR" --arg repo "${REPO#*/}" --arg owner "${REPO%%/*}" '
        (.data.node.pullRequest.number == $pr)
        and (.data.node.pullRequest.repository.name == $repo)
        and (.data.node.pullRequest.repository.owner.login == $owner)
        and any(.data.node.comments.nodes[]; .databaseId == $cid)' >/dev/null 2>&1; then
    echo "error: --resolve thread $RESOLVE_THREAD_ID is not a thread of PR #$PR containing comment $COMMENT_ID — refusing to resolve an unrelated conversation" >&2
    exit "$ORC_ERR_CONFIG"
  fi
  RESOLVE_ARGS=(-f query='mutation($threadId: ID!) { resolveReviewThread(input: { threadId: $threadId }) { thread { id isResolved } } }' -F threadId="$RESOLVE_THREAD_ID")
  RESULT="$(ORC_GITHUB_APP_ENFORCEMENT=required orc_lib_run_or_dry_run RESOLVE_ARGS graphql)" || {
    echo "error: reply posted but resolveReviewThread failed for thread $RESOLVE_THREAD_ID" >&2
    exit "$ORC_ERR_UNRECOVERABLE"
  }
  IS_RESOLVED="$(printf '%s' "$RESULT" | jq -r '.data.resolveReviewThread.thread.isResolved // false' 2>/dev/null)" || IS_RESOLVED=false
  if [ "$IS_RESOLVED" != "true" ]; then
    echo "error: resolveReviewThread returned isResolved != true for thread $RESOLVE_THREAD_ID" >&2
    exit "$ORC_ERR_UNRECOVERABLE"
  fi
  echo "Resolved thread $RESOLVE_THREAD_ID" >&2
fi

[ -n "$REPLY_URL" ] && printf '%s\n' "$REPLY_URL"
exit "$ORC_OK"
