#!/usr/bin/env bash
# pr-create: open a pull request through the service-identity wrapper.
# Wraps `gh pr create` via orc_lib_gh_service so the PR's author is the
# arbsec-agent GitHub App service identity, never a personal account
# (AGENTS.md critical rules; .agents/project/orchestraitor-workflow.md).
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=_lib.sh
source "$SCRIPT_DIR/_lib.sh"

orc_lib_parse_common "$@"

if [ "$OPT_HELP" = true ]; then
  orc_lib_print_help "pr-create" "Open a PR (gh pr create) through the service-identity wrapper. Positional: pass any gh pr create arguments (--title, --body, --body-file, --fill, --base, ...). THE RULE: the wrapper does NOT interpret gh's argv. Every argument is forwarded to gh VERBATIM, in order, unchanged: nothing is inspected, rewritten, composed or refused, and gh validates its own flags. The only token this script recognises is its OWN --skip-review-gate (which gh does not have); a gh flag VALUE that is exactly that string is taken as the flag, which is the one residual ambiguity. CONSEQUENCE: pr-create does NOT compose the managed checklist any more — every PR it creates must be remediated with pr-mutate edit <pr> --inject-checklist, which the post-create note names (the PR number is parsed from the URL gh printed; when it cannot be parsed the note says so and uses a placeholder). A pre-PR local review gate runs before creation: a CLEAN pr-review-agent generation must exist at the current (head, base) pair unless --skip-review-gate is passed or the diff is docs-only. The gate NEVER reads the base from the caller's arguments — a token that looks like a flag can be another flag's value, and a wrong base validates the wrong review evidence; it uses \$PR_CREATE_BASE_BRANCH (a wrapper-only override), then branch.<current>.gh-merge-base, then refs/remotes/origin/HEAD, and fails closed with exit 6 when none resolves."
  exit "$ORC_OK"
fi

# THE RULE (arbsec/orchestraitor#799 R17): this wrapper does NOT INTERPRET
# `gh`'s argv. It used to re-implement pflag's argument grammar in bash — the
# body spellings, then the `=value` forms, then attached values, then short-flag
# clusters — and every round moved the failure instead of fixing it, up to a
# GATE-INTEGRITY bug: `--title '--base=release' --base main --body summary` made
# the review gate select `release` (it read the caller's argv for `--base`) while
# gh consumed that token as the TITLE and created the PR against `main`.
#
# So the interpreter is GONE. This parser recognises exactly ONE token — our own
# `--skip-review-gate`, which gh does not have — and copies EVERY other argument
# into `REST` in order, byte for byte. No body handling, no cluster splitting, no
# short-flag tables, no `--body`/`--body-file` handling, no refusals of gh's
# combinations: gh validates its own argv.
#
# Consequence, stated plainly: **`pr-create` no longer composes the managed
# checklist.** Every PR it creates must be remediated with
# `pr-mutate edit <pr> --inject-checklist`, which the post-create note names.
# That is a convenience regression accepted in exchange for deleting an
# unbounded parser and closing the gate-integrity hole above.
#
# The one residual ambiguity is deliberate and narrow: a gh flag VALUE that is
# EXACTLY the string `--skip-review-gate` is taken as our flag. Any other value
# (`--title '--base=release'`, `--body 'Summary'`, `-urgent`) is just a token and
# is forwarded untouched.
REST=()
while [ "${#ORC_LIB_EXTRA_ARGS[@]}" -gt 0 ]; do
  case "${ORC_LIB_EXTRA_ARGS[0]}" in
    --skip-review-gate) SKIP_REVIEW_GATE=1; PR_CREATE_EXPLICIT_SKIP=1 ;;
    *) REST+=("${ORC_LIB_EXTRA_ARGS[0]}") ;;
  esac
  ORC_LIB_EXTRA_ARGS=("${ORC_LIB_EXTRA_ARGS[@]:1}")
done

# --- Pre-PR local review gate ----------------------------------------------------
# Before creating the PR, verify a recorded CLEAN local review generation exists
# for the CURRENT (head, base) pair, where base is the freshly fetched remote
# base tip (`refs/remotes/origin/<base>`) — the same OID the record producers
# write as `- base OID:` (#733). The gate runs BEFORE any PR creation: a
# refusal here leaves no partial PR behind. Besides that one `git fetch` of the
# base branch it reads only local state (git + .orchestraitor/reviews/) and
# never depends on the orc gh-env chain route.
#
# Escapes:
#   --skip-review-gate  explicit override (docs-only PRs where CodeRabbit is
#                       not applicable, or an explicit owner directive) —
#                       prints a loud notice and proceeds. It is evaluated
#                       BEFORE base resolution and skips it along with the
#                       record check: an explicit decision must not be vetoed
#                       by an unreachable origin. Never silently proceeds —
#                       the notice says the PR is unreviewed.
#   docs-only diff      automatic skip when `git diff --name-only
#                       <merge-base>..HEAD` contains only *.md files. This one
#                       still NEEDS a resolvable base: it is inferred from the
#                       diff, not decided by the operator.
#
# A gate failure is exit 2 (ORC_ERR_CONFIG, the script's config/state error
# class) with a typed message naming the exact remediation command. A base that
# cannot be resolved from the remote ref is a distinct refusal: exit 6
# (PR_CREATE_EXIT_BASE_UNRESOLVED) — never a local-branch fallback and never a
# silent empty merge-base (#733). The gate has NO env-var bypass: the
# SKILL_CASE harness contract below is scoped to the gh-env-wrapper test suite
# only.
# SKILL_CASE=1 (the gh-env-wrapper harness contract) disables the gate
# ENTIRELY — including base resolution — before any git probing: the harness
# drives pr-create from a SHALLOW checkout (no origin/HEAD symref, no
# origin/main ref, no review-record fixture) and asserts the labeling-chain
# service route itself, so base resolution would fail there for reasons the
# chain test does not exercise.
if [ -z "${SKILL_CASE:-}" ]; then
PR_CREATE_REPO_ROOT="$(orc_lib_git_toplevel)"
if [ -z "$PR_CREATE_REPO_ROOT" ]; then
  echo "error: pr-create requires running from the target git checkout" >&2
  exit "$ORC_ERR_CONFIG"
fi
PR_CREATE_HEAD_SHA="$(git rev-parse HEAD)"
# Explicit operator override, evaluated BEFORE any base resolution: the
# operator has already made the decision, so an unreachable or unresolvable
# base must not veto it (#735 review — the fail-closed fetch had made
# `--skip-review-gate` itself fail in exactly the environment where the escape
# hatch is needed). Base resolution, the docs-only inference and the
# review-record check are all skipped together with it.
# The docs-only auto-skip below is deliberately NOT hoisted: it is INFERRED
# from the diff, and inferring it requires a resolvable base.
if [ "${PR_CREATE_EXPLICIT_SKIP:-0}" = "1" ]; then
  echo "NOTICE: pre-PR local review gate SKIPPED via --skip-review-gate (per owner directive or docs-only policy)" >&2
  echo "        base resolution and the review-record check are skipped with it" >&2
  echo "        this PR has NO recorded CLEAN review generation — CodeRabbit must still review it" >&2
else
# THE BASE IS NEVER READ FROM THE CALLER'S ARGV (arbsec/orchestraitor#799 R17).
# The gate used to scan the pass-through args for `--base`, which a caller
# token could spoof: `--title '--base=release' --base main` made the gate
# validate review evidence against `release` while gh consumed that token as the
# TITLE and created the PR against `main` — a CLEAN record for the wrong base
# could satisfy the gate. The three sources below are all outside the argv:
#
#   1. $PR_CREATE_BASE_BRANCH — an explicit WRAPPER-ONLY environment override
#      (gh has no such variable, so no gh argv token can set it);
#   2. `branch.<name>.gh-merge-base` — the repository's own configuration, which
#      is also gh's documented precedence (a config value, never a token);
#   3. `refs/remotes/origin/HEAD` — the repository's default branch.
#
# If none resolves, the gate FAILS CLOSED with a clear message (exit 6), naming
# the override, rather than guessing from an argument. The head branch's `@{u}`
# is never a substitute: a pushed feature branch tracks itself.
PR_CREATE_TARGET_BASE="${PR_CREATE_BASE_BRANCH:-}"
if [ -z "$PR_CREATE_TARGET_BASE" ]; then
  PR_CREATE_TARGET_BASE="$(git config --get "branch.$(git rev-parse --abbrev-ref HEAD).gh-merge-base" 2>/dev/null)" || true
fi
if [ -z "$PR_CREATE_TARGET_BASE" ]; then
  PR_CREATE_TARGET_BASE="$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||')" || true
fi
if [ -z "$PR_CREATE_TARGET_BASE" ]; then
  echo "pre-review-gate: cannot resolve the target base branch from the repository (no PR_CREATE_BASE_BRANCH, no branch.<name>.gh-merge-base, no origin/HEAD)" >&2
  echo "  the gate deliberately does NOT read --base (or any other caller argument): a token that looks like a flag can be another flag's value, and a wrong base silently validates the wrong review evidence (arbsec/orchestraitor#799 R17)" >&2
  echo "  fix: set PR_CREATE_BASE_BRANCH=<branch>, or configure branch.<current>.gh-merge-base, or repair refs/remotes/origin/HEAD" >&2
  exit 6
fi
# Normalize a possibly ref-qualified value to the branch name `gh pr create`
# expects. The base COMMIT is then resolved from a fully-qualified remote ref
# below, never from this bare name.
case "$PR_CREATE_TARGET_BASE" in
  refs/remotes/origin/*) PR_CREATE_TARGET_BASE="${PR_CREATE_TARGET_BASE#refs/remotes/origin/}" ;;
  refs/heads/*)          PR_CREATE_TARGET_BASE="${PR_CREATE_TARGET_BASE#refs/heads/}" ;;
  origin/*)              PR_CREATE_TARGET_BASE="${PR_CREATE_TARGET_BASE#origin/}" ;;
esac

# --- Base resolution (fail closed; arbsec/orchestraitor#733) ---------------------
# PR_CREATE_BASE_OID is the CURRENT TIP of the remote base branch, which is the
# same quantity the review-record producers write and the merge gates compare:
# `pr-review-agent` records the PR's `baseRefOid` (`- base OID:`), and
# `convergence-status` / `merge-gate` require that record to equal the PR's
# current `baseRefOid`. `gh pr view --json baseRefOid` is the authoritative
# source but does not exist yet — this gate runs BEFORE the PR — so the freshly
# fetched remote tip is the only correct local quantity, and it is exactly what
# GitHub will report as `baseRefOid` for the PR about to be created.
# The comparison used to be `git merge-base <bare-base> HEAD`, which disagreed
# with the producers by construction AND resolved the bare name to
# `refs/heads/<base>` first (git rev-parse prefers a local branch over
# `refs/remotes/origin/<base>`): a checkout's long-lived local `main` is
# routinely stale, is an ancestor of both `origin/main` and `HEAD`, and so
# yielded a plausible-but-wrong base OID. Refuse rather than guess.
PR_CREATE_EXIT_BASE_UNRESOLVED=6   # distinct from ORC_ERR_CONFIG (review record missing)
PR_CREATE_BASE_REF="refs/remotes/origin/$PR_CREATE_TARGET_BASE"
# Bound the fetch: against a blackholed remote it would otherwise hang until
# the OS TCP timeout. Portable per-transport config (no `timeout`, which is
# GNU coreutils and absent on a stock macOS); ignored by non-HTTP transports.
set +e
PR_CREATE_FETCH_ERR="$(git -c http.lowSpeedLimit=1000 -c http.lowSpeedTime=10 \
  fetch --quiet --no-tags origin "+refs/heads/$PR_CREATE_TARGET_BASE:$PR_CREATE_BASE_REF" 2>&1)"
PR_CREATE_FETCH_RC=$?
set -e
PR_CREATE_BASE_OID=""
if [ "$PR_CREATE_FETCH_RC" -eq 0 ]; then
  PR_CREATE_BASE_OID="$(git rev-parse --verify --quiet "$PR_CREATE_BASE_REF^{commit}")" || PR_CREATE_BASE_OID=""
fi
if [ -z "$PR_CREATE_BASE_OID" ]; then
  # Redact any userinfo a credentialized remote URL could carry before echoing
  # git's own first error line (errors never contain secrets).
  PR_CREATE_FETCH_MSG="$(printf '%s\n' "$PR_CREATE_FETCH_ERR" |
    sed -E 's#(://)[^/@[:space:]]*@#\1***@#g' | sed -n 1p)"
  echo "pre-review-gate: cannot resolve the base branch '$PR_CREATE_TARGET_BASE' from '$PR_CREATE_BASE_REF' (git fetch exit $PR_CREATE_FETCH_RC) — refusing instead of falling back to a local branch" >&2
  [ -n "$PR_CREATE_FETCH_MSG" ] && echo "  git: $PR_CREATE_FETCH_MSG" >&2
  echo "  run: git fetch origin $PR_CREATE_TARGET_BASE   (and check that 'origin' is configured and reachable)" >&2
  echo "  a stale or unrelated local branch named '$PR_CREATE_TARGET_BASE' is NOT used: this gate only ever reads '$PR_CREATE_BASE_REF'" >&2
  exit "$PR_CREATE_EXIT_BASE_UNRESOLVED"
fi
# Fork point, used ONLY for the docs-only diff: what THIS branch changes is
# merge-base(base tip, HEAD)..HEAD. Diffing base-tip..HEAD instead would also
# show (in reverse) every commit the base gained since the branch was cut.
PR_CREATE_MERGE_BASE="$(git merge-base HEAD "$PR_CREATE_BASE_REF" 2>/dev/null)" || PR_CREATE_MERGE_BASE=""
if [ -z "$PR_CREATE_MERGE_BASE" ]; then
  echo "pre-review-gate: HEAD $PR_CREATE_HEAD_SHA shares no history with '$PR_CREATE_BASE_REF' ($PR_CREATE_BASE_OID) — refusing instead of falling back to a local branch" >&2
  echo "  a stale or unrelated local branch named '$PR_CREATE_TARGET_BASE' is NOT used: this gate only ever reads '$PR_CREATE_BASE_REF'" >&2
  echo "  check that '$PR_CREATE_TARGET_BASE' is the branch this work was cut from (set PR_CREATE_BASE_BRANCH to override)" >&2
  exit "$PR_CREATE_EXIT_BASE_UNRESOLVED"
fi
# The real-world #733 confusion, made visible: a local branch of the same name
# exists but is not what the gate used.
PR_CREATE_LOCAL_OID="$(git rev-parse --verify --quiet "refs/heads/$PR_CREATE_TARGET_BASE^{commit}")" || PR_CREATE_LOCAL_OID=""
if [ -n "$PR_CREATE_LOCAL_OID" ] && [ "$PR_CREATE_LOCAL_OID" != "$PR_CREATE_BASE_OID" ]; then
  echo "pre-review-gate: ignoring local branch '$PR_CREATE_TARGET_BASE' at $PR_CREATE_LOCAL_OID — using $PR_CREATE_BASE_REF at $PR_CREATE_BASE_OID" >&2
fi

# Docs-only auto-skip: every changed path vs the merge-base ends in .md.
# (An empty diff — no changes vs the merge-base — still reaches the gate:
# a no-diff PR has nothing for CodeRabbit to review, but also nothing to
# refuse; treat it like docs-only so a stray empty PR can still be opened.)
if [ "$(git diff --name-only "$PR_CREATE_MERGE_BASE"..HEAD -- | wc -l)" -gt 0 ] &&
   [ -z "$(git diff --name-only "$PR_CREATE_MERGE_BASE"..HEAD -- | grep -v '\.md$')" ]; then
  echo "pre-review-gate: docs-only diff (only *.md changed vs $PR_CREATE_TARGET_BASE) — local review gate skipped" >&2
  SKIP_REVIEW_GATE=1
fi

if [ "${SKIP_REVIEW_GATE:-0}" != "1" ]; then
  # Only the docs-only inference can set SKIP_REVIEW_GATE here: the explicit
  # --skip-review-gate flag was hoisted above base resolution.
  PR_CREATE_GATE_RECORD=""
  for PR_CREATE_CANDIDATE in "$PR_CREATE_REPO_ROOT"/.orchestraitor/reviews/*-"$(git rev-parse --short=7 HEAD)".md; do
    [ -f "$PR_CREATE_CANDIDATE" ] || continue
    # Compare against PR_CREATE_BASE_OID (the remote base tip), which is what
    # `pr-review-agent` writes as `- base OID:` and what `convergence-status` /
    # `merge-gate` compare to the PR's `baseRefOid` — not the fork point.
    if grep -q "^- verdict: CLEAN$" "$PR_CREATE_CANDIDATE" &&
       grep -q "^- head SHA: $PR_CREATE_HEAD_SHA$" "$PR_CREATE_CANDIDATE" &&
       grep -q "^- base OID: $PR_CREATE_BASE_OID$" "$PR_CREATE_CANDIDATE"; then
      PR_CREATE_GATE_RECORD="$PR_CREATE_CANDIDATE"
      break
    fi
  done
  if [ -z "$PR_CREATE_GATE_RECORD" ]; then
    echo "pre-review-gate: no clean local review generation at HEAD $PR_CREATE_HEAD_SHA (base $PR_CREATE_BASE_OID = $PR_CREATE_BASE_REF) — run pr-review-local first" >&2
    echo "  (gate reads CLEAN records from $PR_CREATE_REPO_ROOT/.orchestraitor/reviews/; a stale or wrong-pair record does not pass)" >&2
    echo "  bash .agents/skills/github-pr-lifecycle/scripts/pr-review-local" >&2
    exit "$ORC_ERR_CONFIG"
  fi
  echo "pre-review-gate: clean local review generation found at HEAD $PR_CREATE_HEAD_SHA (base $PR_CREATE_BASE_OID = $PR_CREATE_BASE_REF)" >&2
fi
fi # explicit --skip-review-gate (hoisted above base resolution)
fi # SKILL_CASE gate wrapper

# --- argv: the caller's, verbatim -------------------------------------------------
# Nothing is composed, injected, refused or rewritten. `gh` validates its own
# argv; the wrapper only prepends the subcommand and the repository it resolved
# through the service identity (`--repo` is idempotent when the caller passed it
# too — gh accepts a repeated flag and takes the last one, which is exactly what
# the caller wrote).
ARGS=(pr create --repo "$(orc_lib_resolve_repo)")
ARGS+=("${REST[@]}")

if [ "$OPT_DRY_RUN" = true ]; then
  echo "[dry-run] gh ${ARGS[*]}" >&2
  echo "[dry-run] (executed via 'orc github gh-env --' when github_app config is present)" >&2
  exit "$ORC_OK"
fi

# Mutating call: service route or typed failure — never silent personal auth.
# In REQUIRED enforcement with a COMPLETE github_app config the dedicated
# `gh-env-pr-create-chain` subcommand is used: orc executes the labeling
# obligation ITSELF after the PR exists — no caller attestation. Every other
# shape (absent/partial config, enforcement read failure) keeps the plain
# service/fallback routing with the wrapper's own fail-closed gates.
if orc_lib_has_github_app_config &&
   orc_lib_enforcement_required &&
   [ "$(orc_lib_enforcement_probe_status)" -eq 0 ]; then
  PR_URL="$("${ORC_BIN:-orc}" github gh-env-pr-create-chain "$(orc_lib_resolve_repo)" -- "${GH_BIN:-gh}" "${ARGS[@]}")"
  # The chain subcommand ALREADY ran both labeling steps; the shell-side
  # chain below must not rerun them (idempotent, but the warnings would
  # double).
  CHAINED=1
else
  PR_URL="$(orc_lib_run_or_dry_run ARGS gh)"
fi
echo "Created PR: $PR_URL" >&2

# The managed checklist is NOT composed here any more (arbsec/orchestraitor#799
# R17), so every created PR owes one remediation command. The PR number is parsed
# from the URL gh printed; when it cannot be parsed the note says so and uses a
# placeholder rather than guessing a number.
case "$PR_URL" in
  */pull/*)
    PR_URL_NUMBER="${PR_URL##*/}"
    case "$PR_URL_NUMBER" in
      ''|*[!0-9]*) PR_URL_NUMBER="" ;;
    esac ;;
  *) PR_URL_NUMBER="" ;;
esac
echo "next: bash $SCRIPT_DIR/pr-mutate edit ${PR_URL_NUMBER:-<the PR you just created>} --inject-checklist" >&2
if [ -z "$PR_URL_NUMBER" ]; then
  echo "      (the PR number could not be parsed from '$PR_URL' — replace <the PR you just created> with it)" >&2
fi

# --- Deterministic labeling chain (arbsec/orchestraitor#469) --------------------
# A created PR MUST NOT depend on worker discretion for its labels: run
# `pr-labels` (attribution: agent-created / needs-human-review) and then
# `pr-labels-from-issue` (process labels copied from the PR's closing
# (Closes/Fixes/Resolves) and related (Part of/Refs) issue references) right
# here. The PR already exists, so a labeling failure must never orphan it —
# each step is non-fatal: on failure it prints a warning
# naming the PR and the exact manual command, and pr-create still succeeds.
# SKIPPED when the chain route above ran: `gh-env-pr-create-chain` already
# executed both steps (CHAINED=1) — rerunning would only double warnings.
PR_NUMBER="${PR_URL##*/}"
case "$PR_NUMBER" in
  ''|*[!0-9]*) PR_NUMBER="" ;;
esac
if [ "${CHAINED:-0}" = "1" ]; then
  : # labeling already enforced by gh-env-pr-create-chain
elif [ -n "$PR_NUMBER" ]; then
  if ! bash "$SCRIPT_DIR/pr-labels" "$PR_NUMBER" --repo "$(orc_lib_resolve_repo)" >&2; then
    echo "WARNING: automatic labeling of PR #$PR_NUMBER failed (pr-labels); apply manually:" >&2
    echo "  bash $SCRIPT_DIR/pr-labels $PR_NUMBER --repo $(orc_lib_resolve_repo)" >&2
  fi
  if ! bash "$SCRIPT_DIR/pr-labels-from-issue" "$PR_NUMBER" --repo "$(orc_lib_resolve_repo)" >&2; then
    echo "WARNING: linked-issue label copy for PR #$PR_NUMBER failed (pr-labels-from-issue); apply manually:" >&2
    echo "  bash $SCRIPT_DIR/pr-labels-from-issue $PR_NUMBER --repo $(orc_lib_resolve_repo)" >&2
  fi
else
  echo "WARNING: could not derive a PR number from '$PR_URL'; automatic labeling was skipped — apply manually with pr-labels and pr-labels-from-issue" >&2
fi

printf '%s\n' "$PR_URL"
