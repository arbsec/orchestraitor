#!/usr/bin/env bash
# pr-create: open a pull request through the service-identity wrapper.
# Wraps `gh pr create` via orc_lib_gh_service so the PR's author is the
# arbsec-agent GitHub App service identity, never a personal account
# (AGENTS.md critical rules; .agents/project/orchestraitor-workflow.md).
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=_lib.sh
source "$SCRIPT_DIR/_lib.sh"

orc_lib_parse_common "$@"

if [ "$OPT_HELP" = true ]; then
  orc_lib_print_help "pr-create" "Open a PR (gh pr create) through the service-identity wrapper. Positional: --title <text> --body <text> (or pass through any gh pr create flags after --). A pre-PR local review gate runs before creation: a CLEAN pr-review-local generation must exist at the current (head, base) pair unless --skip-review-gate is passed or the diff is docs-only."
  exit "$ORC_OK"
fi

# Extract --title/--body from extra args (body may span several words); the
# remaining args are passed through to `gh pr create` verbatim (e.g. --draft,
# --base, --head, --reviewer, --, --body-file).
TITLE=""
BODY=""
REST=()
while [ "${#ORC_LIB_EXTRA_ARGS[@]}" -gt 0 ]; do
  case "${ORC_LIB_EXTRA_ARGS[0]}" in
    --title)
      [ -n "${ORC_LIB_EXTRA_ARGS[1]:-}" ] || { echo "error: --title requires a value" >&2; exit "$ORC_ERR_CONFIG"; }
      TITLE="${ORC_LIB_EXTRA_ARGS[1]}"; ORC_LIB_EXTRA_ARGS=("${ORC_LIB_EXTRA_ARGS[@]:2}") ;;
    --title=*) TITLE="${ORC_LIB_EXTRA_ARGS[0]#*=}"; ORC_LIB_EXTRA_ARGS=("${ORC_LIB_EXTRA_ARGS[@]:1}") ;;
    --body)
      [ -n "${ORC_LIB_EXTRA_ARGS[1]:-}" ] || { echo "error: --body requires a value" >&2; exit "$ORC_ERR_CONFIG"; }
      BODY="${ORC_LIB_EXTRA_ARGS[1]}"; ORC_LIB_EXTRA_ARGS=("${ORC_LIB_EXTRA_ARGS[@]:2}") ;;
    --body=*)  BODY="${ORC_LIB_EXTRA_ARGS[0]#*=}"; ORC_LIB_EXTRA_ARGS=("${ORC_LIB_EXTRA_ARGS[@]:1}") ;;
    --skip-review-gate) SKIP_REVIEW_GATE=1; PR_CREATE_EXPLICIT_SKIP=1; ORC_LIB_EXTRA_ARGS=("${ORC_LIB_EXTRA_ARGS[@]:1}") ;;
    *)         REST+=("${ORC_LIB_EXTRA_ARGS[0]}"); ORC_LIB_EXTRA_ARGS=("${ORC_LIB_EXTRA_ARGS[@]:1}") ;;
  esac
done

# --- Pre-PR local review gate ----------------------------------------------------
# Before creating the PR, verify a recorded CLEAN local review generation exists
# for the CURRENT (head, base) pair. The gate runs BEFORE any PR creation: a
# refusal here leaves no partial PR behind. It reads only local state (git +
# .orchestraitor/reviews/) and never depends on the orc gh-env chain route.
#
# Escapes:
#   --skip-review-gate  explicit override (docs-only PRs where CodeRabbit is
#                       not applicable, or an explicit owner directive) —
#                       prints a loud notice and proceeds.
#   docs-only diff      automatic skip when `git diff --name-only
#                       <merge-base>..HEAD` contains only *.md files.
#
# A gate failure is exit 2 (ORC_ERR_CONFIG, the script's config/state error
# class) with a typed message naming the exact remediation command.
# SKILL_CASE=1 (the gh-env-wrapper harness contract) disables the gate: the
# harness drives pr-create from the real checkout with synthetic orc/gh stubs
# and no review-record fixture, so a gate refusal there would test nothing
# about the labeling chain it actually targets.
PR_CREATE_REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || PR_CREATE_REPO_ROOT=""
if [ -z "$PR_CREATE_REPO_ROOT" ]; then
  echo "error: pr-create requires running from the target git checkout" >&2
  exit "$ORC_ERR_CONFIG"
fi
PR_CREATE_TARGET_BASE="${PR_CREATE_BASE_BRANCH:-}"
if [ -z "$PR_CREATE_TARGET_BASE" ]; then
  # Resolve the effective `gh pr create` base from the pass-through args:
  # an explicit --base <v> / --base=<v> wins (the gate must check the SAME
  # diff the PR will propose); otherwise fall back to gh's own precedence —
  # the branch's configured gh-merge-base, then the repo default branch.
  # The head branch's @{u} is NEVER a substitute: a pushed feature branch
  # tracks itself and would make the gate diff empty/wrong.
  PR_CREATE_I=0
  while [ "$PR_CREATE_I" -lt "${#REST[@]}" ]; do
    case "${REST[$PR_CREATE_I]}" in
      --base)
        PR_CREATE_TARGET_BASE="${REST[$((PR_CREATE_I + 1))]:-}"; break ;;
      --base=*)
        PR_CREATE_TARGET_BASE="${REST[$PR_CREATE_I]#--base=}"; break ;;
    esac
    PR_CREATE_I=$((PR_CREATE_I + 1))
  done
fi
if [ -z "$PR_CREATE_TARGET_BASE" ]; then
  PR_CREATE_TARGET_BASE="$(git config --get "branch.$(git rev-parse --abbrev-ref HEAD).gh-merge-base" 2>/dev/null)" || true
fi
if [ -z "$PR_CREATE_TARGET_BASE" ]; then
  PR_CREATE_TARGET_BASE="$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||')" || true
fi
if [ -z "$PR_CREATE_TARGET_BASE" ]; then
  echo "pre-review-gate: cannot resolve the target base branch (no --base, no gh-merge-base, no origin/HEAD) — pass --base explicitly" >&2
  exit "$ORC_ERR_CONFIG"
fi
# Normalize "origin/main" style values to the branch name gh pr create expects.
PR_CREATE_TARGET_BASE="${PR_CREATE_TARGET_BASE#origin/}"
PR_CREATE_MERGE_BASE="$(git merge-base "$PR_CREATE_TARGET_BASE" HEAD 2>/dev/null)" || PR_CREATE_MERGE_BASE=""
if [ -z "$PR_CREATE_MERGE_BASE" ] && [ "$PR_CREATE_TARGET_BASE" = "$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||')" ]; then
  # The resolved default branch may exist only as a remote ref (fresh clone
  # without a local branch of the same name) — retry with the remote form.
  PR_CREATE_MERGE_BASE="$(git merge-base "origin/$PR_CREATE_TARGET_BASE" HEAD 2>/dev/null)" || PR_CREATE_MERGE_BASE=""
fi
if [ -z "$PR_CREATE_MERGE_BASE" ]; then
  echo "pre-review-gate: cannot compute a merge-base with base branch '$PR_CREATE_TARGET_BASE' — is the branch based on it?" >&2
  exit "$ORC_ERR_CONFIG"
fi
PR_CREATE_HEAD_SHA="$(git rev-parse HEAD)"

# Docs-only auto-skip: every changed path vs the merge-base ends in .md.
# (An empty diff — no changes vs the merge-base — still reaches the gate:
# a no-diff PR has nothing for CodeRabbit to review, but also nothing to
# refuse; treat it like docs-only so a stray empty PR can still be opened.)
if [ "$(git diff --name-only "$PR_CREATE_MERGE_BASE"..HEAD -- | wc -l)" -gt 0 ] &&
   [ -z "$(git diff --name-only "$PR_CREATE_MERGE_BASE"..HEAD -- | grep -v '\.md$')" ]; then
  echo "pre-review-gate: docs-only diff (only *.md changed vs $PR_CREATE_TARGET_BASE) — local review gate skipped" >&2
  SKIP_REVIEW_GATE=1
fi

if [ "${SKIP_REVIEW_GATE:-0}" != "1" ] && [ -z "${SKILL_CASE:-}" ]; then
  # SKILL_CASE=1 is set by the gh-env-wrapper harness (see the comment block
  # above): the harness asserts the labeling-chain service route itself, with
  # no review-record fixture, so the gate must not refuse there.
  PR_CREATE_GATE_RECORD=""
  for PR_CREATE_CANDIDATE in "$PR_CREATE_REPO_ROOT"/.orchestraitor/reviews/*-"$(git rev-parse --short=7 HEAD)".md; do
    [ -f "$PR_CREATE_CANDIDATE" ] || continue
    if grep -q "^- verdict: CLEAN$" "$PR_CREATE_CANDIDATE" &&
       grep -q "^- head SHA: $PR_CREATE_HEAD_SHA$" "$PR_CREATE_CANDIDATE" &&
       grep -q "^- base OID: $PR_CREATE_MERGE_BASE$" "$PR_CREATE_CANDIDATE"; then
      PR_CREATE_GATE_RECORD="$PR_CREATE_CANDIDATE"
      break
    fi
  done
  if [ -z "$PR_CREATE_GATE_RECORD" ]; then
    echo "pre-review-gate: no clean local review generation at HEAD $PR_CREATE_HEAD_SHA (base $PR_CREATE_MERGE_BASE) — run pr-review-local first" >&2
    echo "  (gate reads CLEAN records from $PR_CREATE_REPO_ROOT/.orchestraitor/reviews/; a stale or wrong-pair record does not pass)" >&2
    echo "  bash .agents/skills/github-pr-lifecycle/scripts/pr-review-local" >&2
    exit "$ORC_ERR_CONFIG"
  fi
  echo "pre-review-gate: clean local review generation found at HEAD $PR_CREATE_HEAD_SHA (base $PR_CREATE_MERGE_BASE)" >&2
elif [ "${PR_CREATE_EXPLICIT_SKIP:-0}" = "1" ]; then
  echo "NOTICE: pre-PR local review gate SKIPPED via --skip-review-gate (per owner directive or docs-only policy)" >&2
  echo "        this PR has NO recorded CLEAN review generation — CodeRabbit must still review it" >&2
fi

ARGS=(pr create --repo "$(orc_lib_resolve_repo)")
[ -n "$TITLE" ] && ARGS+=(--title "$TITLE")
[ -n "$BODY" ] && ARGS+=(--body "$BODY")
ARGS+=("${REST[@]}")

if [ "$OPT_DRY_RUN" = true ]; then
  echo "[dry-run] gh ${ARGS[*]}" >&2
  echo "[dry-run] (executed via 'orc github gh-env --' when github_app config is present)" >&2
  exit "$ORC_OK"
fi

# Mutating call: service route or typed failure — never silent personal auth.
# In REQUIRED enforcement with a COMPLETE github_app config the dedicated
# `gh-env-pr-create-chain` subcommand is used: orc executes the labeling
# obligation ITSELF after the PR exists — no caller attestation. Every other
# shape (absent/partial config, enforcement read failure) keeps the plain
# service/fallback routing with the wrapper's own fail-closed gates.
if orc_lib_has_github_app_config &&
   orc_lib_enforcement_required &&
   [ "$(orc_lib_enforcement_probe_status)" -eq 0 ]; then
  PR_URL="$("${ORC_BIN:-orc}" github gh-env-pr-create-chain "$(orc_lib_resolve_repo)" -- "${GH_BIN:-gh}" "${ARGS[@]}")"
  # The chain subcommand ALREADY ran both labeling steps; the shell-side
  # chain below must not rerun them (idempotent, but the warnings would
  # double).
  CHAINED=1
else
  PR_URL="$(orc_lib_run_or_dry_run ARGS gh)"
fi
echo "Created PR: $PR_URL" >&2

# --- Deterministic labeling chain (arbsec/orchestraitor#469) --------------------
# A created PR MUST NOT depend on worker discretion for its labels: run
# `pr-labels` (attribution: agent-created / needs-human-review) and then
# `pr-labels-from-issue` (process labels copied from Closes/Fixes/Resolves
# issues) right here. The PR already exists, so a labeling failure must
# never orphan it — each step is non-fatal: on failure it prints a warning
# naming the PR and the exact manual command, and pr-create still succeeds.
# SKIPPED when the chain route above ran: `gh-env-pr-create-chain` already
# executed both steps (CHAINED=1) — rerunning would only double warnings.
PR_NUMBER="${PR_URL##*/}"
case "$PR_NUMBER" in
  ''|*[!0-9]*) PR_NUMBER="" ;;
esac
if [ "${CHAINED:-0}" = "1" ]; then
  : # labeling already enforced by gh-env-pr-create-chain
elif [ -n "$PR_NUMBER" ]; then
  if ! bash "$SCRIPT_DIR/pr-labels" "$PR_NUMBER" --repo "$(orc_lib_resolve_repo)" >&2; then
    echo "WARNING: automatic labeling of PR #$PR_NUMBER failed (pr-labels); apply manually:" >&2
    echo "  bash $SCRIPT_DIR/pr-labels $PR_NUMBER --repo $(orc_lib_resolve_repo)" >&2
  fi
  if ! bash "$SCRIPT_DIR/pr-labels-from-issue" "$PR_NUMBER" --repo "$(orc_lib_resolve_repo)" >&2; then
    echo "WARNING: linked-issue label copy for PR #$PR_NUMBER failed (pr-labels-from-issue); apply manually:" >&2
    echo "  bash $SCRIPT_DIR/pr-labels-from-issue $PR_NUMBER --repo $(orc_lib_resolve_repo)" >&2
  fi
else
  echo "WARNING: could not derive a PR number from '$PR_URL'; automatic labeling was skipped — apply manually with pr-labels and pr-labels-from-issue" >&2
fi

printf '%s\n' "$PR_URL"
