#!/usr/bin/env bash
# pr-create: open a pull request through the service-identity wrapper.
# Wraps `gh pr create` via orc_lib_gh_service so the PR's author is the
# arbsec-agent GitHub App service identity, never a personal account
# (AGENTS.md critical rules; .agents/project/orchestraitor-workflow.md).
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=_lib.sh
source "$SCRIPT_DIR/_lib.sh"

orc_lib_parse_common "$@"

if [ "$OPT_HELP" = true ]; then
  orc_lib_print_help "pr-create" "Open a PR (gh pr create) through the service-identity wrapper. Positional: pass any gh pr create arguments (--title, --body, --body-file, --fill, --base, ...). THE RULE: the wrapper does NOT interpret gh's argv. Every argument is forwarded to gh VERBATIM, in order, unchanged: nothing is inspected, rewritten, composed or refused, and gh validates its own flags. The only token this script recognises is its OWN --skip-review-gate (which gh does not have), kept as a NO-OP for compatibility; a gh flag VALUE that is exactly that string is taken as the flag, which is the one residual ambiguity. CONSEQUENCE: pr-create does NOT compose the managed checklist any more, and there is NO create-time review gate — a PR can be created at any time, but it cannot MERGE until a CLEAN review record exists for its exact (head, base): convergence-status and merge-gate require a record whose base OID equals the PR's actual baseRefOid, which is the gate that can bind. Every PR created through this wrapper needs one remediation command afterwards: pr-mutate edit <pr> --inject-checklist, which the post-create note names (the PR number is parsed from the URL gh printed; when it cannot be parsed the note says so and uses a placeholder)."
  exit "$ORC_OK"
fi

# THE RULE (arbsec/orchestraitor#799 R17): this wrapper does NOT INTERPRET
# `gh`'s argv. It used to re-implement pflag's argument grammar in bash — the
# body spellings, then the `=value` forms, then attached values, then short-flag
# clusters — and every round moved the failure instead of fixing it, up to a
# GATE-INTEGRITY bug: `--title '--base=release' --base main --body summary` made
# the review gate select `release` (it read the caller's argv for `--base`) while
# gh consumed that token as the TITLE and created the PR against `main`.
#
# So the interpreter is GONE. This parser recognises exactly ONE token — our own
# `--skip-review-gate`, which gh does not have — and copies EVERY other argument
# into `REST` in order, byte for byte. No body handling, no cluster splitting, no
# short-flag tables, no `--body`/`--body-file` handling, no refusals of gh's
# combinations: gh validates its own argv.
#
# Consequence, stated plainly: **`pr-create` no longer composes the managed
# checklist.** Every PR it creates must be remediated with
# `pr-mutate edit <pr> --inject-checklist`, which the post-create note names.
# That is a convenience regression accepted in exchange for deleting an
# unbounded parser and closing the gate-integrity hole above.
#
# The one residual ambiguity is deliberate and narrow: a gh flag VALUE that is
# EXACTLY the string `--skip-review-gate` is taken as our flag. Any other value
# (`--title '--base=release'`, `--body 'Summary'`, `-urgent`) is just a token and
# is forwarded untouched.
REST=()
while [ "${#ORC_LIB_EXTRA_ARGS[@]}" -gt 0 ]; do
  case "${ORC_LIB_EXTRA_ARGS[0]}" in
    # KEPT AS A NO-OP: the create-time review gate was deleted (R18), so this
    # flag has nothing left to skip. It is still CONSUMED (never forwarded to
    # gh, which would reject it) so existing callers keep working.
    --skip-review-gate) : ;;
    *) REST+=("${ORC_LIB_EXTRA_ARGS[0]}") ;;
  esac
  ORC_LIB_EXTRA_ARGS=("${ORC_LIB_EXTRA_ARGS[@]:1}")
done

# --- The review gate lives at MERGE time, not here -------------------------------
# arbsec/orchestraitor#799 R18 deleted the create-time review gate. It could not be
# CORRECT: `pr-create` no longer parses the caller's argv (R17), so it cannot know
# which base `gh` will use — `pr-create --base release` creates against `release`
# while a create-time gate could only validate evidence for the repository's
# default base, so evidence for `main` would authorise a `release` PR. A gate that
# cannot bind to the base it is gating is worse than no gate.
#
# The binding gate is the MERGE-time one: `convergence-status` and `merge-gate`
# require a CLEAN record whose `- base OID:` equals the PR's ACTUAL `baseRefOid`
# (read from GitHub), and whose head SHA equals the current head. A PR can
# therefore be created at any time; it cannot MERGE until a CLEAN record exists
# for its exact (head, base).
#
# `--skip-review-gate` is kept as a NO-OP for callers that still pass it (the
# flag is consumed, never forwarded to gh, and has nothing left to skip).


# --- argv: the caller's, verbatim -------------------------------------------------
# Nothing is composed, injected, refused or rewritten. `gh` validates its own
# argv; the wrapper only prepends the subcommand and the repository it resolved
# through the service identity (`--repo` is idempotent when the caller passed it
# too — gh accepts a repeated flag and takes the last one, which is exactly what
# the caller wrote).
ARGS=(pr create --repo "$(orc_lib_resolve_repo)")
ARGS+=("${REST[@]}")

if [ "$OPT_DRY_RUN" = true ]; then
  echo "[dry-run] gh ${ARGS[*]}" >&2
  echo "[dry-run] (executed via 'orc github gh-env --' when github_app config is present)" >&2
  exit "$ORC_OK"
fi

# Mutating call: service route or typed failure — never silent personal auth.
# In REQUIRED enforcement with a COMPLETE github_app config the dedicated
# `gh-env-pr-create-chain` subcommand is used: orc executes the labeling
# obligation ITSELF after the PR exists — no caller attestation. Every other
# shape (absent/partial config, enforcement read failure) keeps the plain
# service/fallback routing with the wrapper's own fail-closed gates.
if orc_lib_has_github_app_config &&
   orc_lib_enforcement_required &&
   [ "$(orc_lib_enforcement_probe_status)" -eq 0 ]; then
  PR_URL="$("${ORC_BIN:-orc}" github gh-env-pr-create-chain "$(orc_lib_resolve_repo)" -- "${GH_BIN:-gh}" "${ARGS[@]}")"
  # The chain subcommand ALREADY ran both labeling steps; the shell-side
  # chain below must not rerun them (idempotent, but the warnings would
  # double).
  CHAINED=1
else
  PR_URL="$(orc_lib_run_or_dry_run ARGS gh)"
fi
echo "Created PR: $PR_URL" >&2

# The managed checklist is NOT composed here any more (arbsec/orchestraitor#799
# R17), so every created PR owes one remediation command. The PR number is parsed
# from the URL gh printed; when it cannot be parsed the note says so and uses a
# placeholder rather than guessing a number.
case "$PR_URL" in
  */pull/*)
    PR_URL_NUMBER="${PR_URL##*/}"
    case "$PR_URL_NUMBER" in
      ''|*[!0-9]*) PR_URL_NUMBER="" ;;
    esac ;;
  *) PR_URL_NUMBER="" ;;
esac
echo "next: bash $SCRIPT_DIR/pr-mutate edit ${PR_URL_NUMBER:-<the PR you just created>} --inject-checklist" >&2
if [ -z "$PR_URL_NUMBER" ]; then
  echo "      (the PR number could not be parsed from '$PR_URL' — replace <the PR you just created> with it)" >&2
fi

# --- Deterministic labeling chain (arbsec/orchestraitor#469) --------------------
# A created PR MUST NOT depend on worker discretion for its labels: run
# `pr-labels` (attribution: agent-created / needs-human-review) and then
# `pr-labels-from-issue` (process labels copied from the PR's closing
# (Closes/Fixes/Resolves) and related (Part of/Refs) issue references) right
# here. The PR already exists, so a labeling failure must never orphan it —
# each step is non-fatal: on failure it prints a warning
# naming the PR and the exact manual command, and pr-create still succeeds.
# SKIPPED when the chain route above ran: `gh-env-pr-create-chain` already
# executed both steps (CHAINED=1) — rerunning would only double warnings.
PR_NUMBER="${PR_URL##*/}"
case "$PR_NUMBER" in
  ''|*[!0-9]*) PR_NUMBER="" ;;
esac
if [ "${CHAINED:-0}" = "1" ]; then
  : # labeling already enforced by gh-env-pr-create-chain
elif [ -n "$PR_NUMBER" ]; then
  if ! bash "$SCRIPT_DIR/pr-labels" "$PR_NUMBER" --repo "$(orc_lib_resolve_repo)" >&2; then
    echo "WARNING: automatic labeling of PR #$PR_NUMBER failed (pr-labels); apply manually:" >&2
    echo "  bash $SCRIPT_DIR/pr-labels $PR_NUMBER --repo $(orc_lib_resolve_repo)" >&2
  fi
  if ! bash "$SCRIPT_DIR/pr-labels-from-issue" "$PR_NUMBER" --repo "$(orc_lib_resolve_repo)" >&2; then
    echo "WARNING: linked-issue label copy for PR #$PR_NUMBER failed (pr-labels-from-issue); apply manually:" >&2
    echo "  bash $SCRIPT_DIR/pr-labels-from-issue $PR_NUMBER --repo $(orc_lib_resolve_repo)" >&2
  fi
else
  echo "WARNING: could not derive a PR number from '$PR_URL'; automatic labeling was skipped — apply manually with pr-labels and pr-labels-from-issue" >&2
fi

printf '%s\n' "$PR_URL"
