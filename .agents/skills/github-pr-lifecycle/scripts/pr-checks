#!/usr/bin/env bash
# pr-checks: read CI check status and classify each as pass/fail/pending/skip.
# Wraps gh pr checks --json and adds a classification summary.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=_lib.sh
source "$SCRIPT_DIR/_lib.sh"

orc_lib_parse_common "$@"

if [ "$OPT_HELP" = true ]; then
  orc_lib_print_help "pr-checks" "Read PR CI checks and classify each as pass/fail/pending/skip. Use --required to filter."
  exit "$ORC_OK"
fi

PR="${ORC_LIB_EXTRA_ARGS[0]:-}"
if [ -z "$PR" ]; then
  echo "error: PR number or URL required" >&2
  exit "$ORC_ERR_CONFIG"
fi

orc_lib_require_gh_scope
REPO="$(orc_lib_resolve_repo)"

CHECK_ARGS=(pr checks "$PR" --repo "$REPO" --json name,state,bucket,workflow,link,startedAt,completedAt)

if [ "$OPT_DRY_RUN" = true ]; then
  echo "[dry-run] gh ${CHECK_ARGS[*]}" >&2
  exit "$ORC_OK"
fi

RAW="$(orc_lib_gh "${CHECK_ARGS[@]}")" || EXIT_CODE=$?

# gh pr checks exits 8 when pending; capture the JSON regardless.
EXIT_CODE=${EXIT_CODE:-0}
if [ -z "$RAW" ] && [ "$EXIT_CODE" -eq 8 ]; then
  echo '{"checks":[],"all_passed":false,"pending":true}'
  exit 0
fi

# Known-disabled jobs: workflow jobs deliberately disabled repo-side via `if: false`
# (state SKIPPED, conclusion skipped). They are classified "not-applicable" and
# excluded from the all_passed gate — they can never report pass. Genuinely
# skipped-but-optioned checks are NOT in this list and still fail the gate.
#   - "Docs Consistency": replaced by `xtask docs-check` (manual evidence).
#   - "Documentation":    disabled repo-side.
# See arbsec/orchestraitor#404.
KNOWN_DISABLED_JOBS='["Docs Consistency","Documentation"]'

# Classify checks.
echo "$RAW" | jq --argjson known_disabled "$KNOWN_DISABLED_JOBS" '
  def disabled($name): ($known_disabled | index($name)) != null;
  {
  checks: map({
    name: .name,
    state: .state,
    bucket: .bucket,
    workflow: .workflow,
    link: .link,
    classification: (
      if disabled(.name) then "not-applicable"
      elif .bucket == "pass" then "pass"
      elif .bucket == "fail" then "fail"
      elif .bucket == "pending" then "pending"
      elif .bucket == "skipping" then "skip"
      elif .bucket == "cancel" then "fail"
      else "unknown"
      end
    )
  }),
  all_passed: all(.[]; .bucket == "pass" or disabled(.name)),
  any_failing: any(.[]; .bucket == "fail" or .bucket == "cancel"),
  any_pending: any(.[]; .bucket == "pending")
}'
