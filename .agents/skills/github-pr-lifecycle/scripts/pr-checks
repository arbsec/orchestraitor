#!/usr/bin/env bash
# pr-checks: read CI check status and classify each as pass/fail/pending/skip.
# Wraps gh pr checks --json and adds a classification summary.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=_lib.sh
source "$SCRIPT_DIR/_lib.sh"

orc_lib_parse_common "$@"

if [ "$OPT_HELP" = true ]; then
  orc_lib_print_help "pr-checks" "Read PR CI checks and classify each as pass/fail/pending/skip. Structurally unavailable jobs (disabled, bot-authored CodeRabbit) become not-applicable with a skip_reason."
  exit "$ORC_OK"
fi

PR="${ORC_LIB_EXTRA_ARGS[0]:-}"
if [ -z "$PR" ]; then
  echo "error: PR number or URL required" >&2
  exit "$ORC_ERR_CONFIG"
fi

orc_lib_require_gh_scope
REPO="$(orc_lib_resolve_repo)"

# PR author, used only to decide whether a CodeRabbit skip is the structural
# bot-author no-op (see below). A failed read yields "" and the exemption fails
# closed: an unknown author is never treated as a bot.
PR_AUTHOR="$(orc_lib_gh pr view "$PR" --repo "$REPO" --json author --jq '.author.login // ""' 2>/dev/null || true)"

CHECK_ARGS=(pr checks "$PR" --repo "$REPO" --json name,state,bucket,workflow,link,startedAt,completedAt,description)

if [ "$OPT_DRY_RUN" = true ]; then
  echo "[dry-run] gh ${CHECK_ARGS[*]}" >&2
  exit "$ORC_OK"
fi

# Review-policy provenance (arbsec/orchestraitor#748): a classifier that is not
# the trusted base's copy produces a confident WRONG answer — the #740/#748
# symptom is a pre-#707 copy reporting `checks_not_passing` for a MERGEABLE PR.
# Refuse (exit 6) instead; never emit a classification from a stale policy.
# Raw JSON is read then filtered locally (like `orc_lib_require_mergeable`): a
# gh that ignores/tests-without `--jq` still yields parseable state.
PR_BASE_JSON="$(orc_lib_gh pr view "$PR" --repo "$REPO" --json baseRefOid 2>/dev/null || true)"
PR_BASE_SHA="$(echo "$PR_BASE_JSON" | jq -r '.baseRefOid // ""' 2>/dev/null || true)"
POLICY_MODE=text
[ "$OPT_JSON" = true ] && POLICY_MODE=json
orc_lib_require_policy_current "$POLICY_MODE" "$PR_BASE_SHA" "pr-checks" \
  "$PR --repo $REPO --json" "$SCRIPT_DIR/pr-checks"

RAW="$(orc_lib_gh "${CHECK_ARGS[@]}")" || EXIT_CODE=$?

# gh pr checks exits 8 when pending; capture the JSON regardless.
EXIT_CODE=${EXIT_CODE:-0}
if [ -z "$RAW" ] && [ "$EXIT_CODE" -eq 8 ]; then
  echo '{"checks":[],"all_passed":false,"pending":true}'
  exit 0
fi

# Known-disabled jobs: workflow jobs deliberately disabled repo-side via `if: false`
# (state SKIPPED, conclusion skipped). They are classified "not-applicable" and
# excluded from the all_passed gate — they can never report pass. Genuinely
# skipped-but-optioned checks are NOT in this list and still fail the gate.
#   - "Docs Consistency": replaced by `xtask docs-check` (manual evidence).
#   - "Documentation":    event-gated in code.yml (`if: github.event_name ==
#     'push'`), so it never runs on pull-request events; excluded only while
#     it reports the skipped state — a failing or pending run still fails the
#     gate. Re-enabling on PRs means removing the name from this list.
# See arbsec/orchestraitor#404.
KNOWN_DISABLED_JOBS='["Docs Consistency","Documentation"]'

# Structural bot-author skip (arbsec/orchestraitor#706): CodeRabbit reports
# SKIPPED on every PR authored by a GitHub App/bot user. Its check-run output
# title is "Review skipped: bot user not eligible for review"; the GitHub-side
# check therefore can never run on bot-authored PRs. That is also consistent
# with the owner directive that the LOCAL CodeRabbit CLI is the review
# mechanism (references/pr-convergence.md), so the GitHub check is a no-op
# there regardless. Exempt it as "not-applicable" with
# `skip_reason: "bot-author"` so the widening is explicit, never silent.
#
# The exemption requires ALL of: the `CodeRabbit` name, the skipping bucket,
# and a bot/App PR author login (`app/...` or `<slug>[bot]`). An empty or
# unknown author fails closed. `gh pr checks --json description` accepts the
# field but returns "" for these runs — the real reason lives only in the
# check-run output, which `gh pr checks` does not surface — so the AUTHOR is
# the discriminator, not the reason. A non-empty description that does not
# match the bot-author reason (rate limit, config error, out of credits) is a
# narrowing on top and is NOT exempted; it is the only usable reason signal if
# gh ever populates the field.
#
# Classify checks. An exemption requires BOTH the exempting name/reason AND the
# skipped bucket: a known-disabled job or CodeRabbit that actually ran and
# failed/passed/pended is classified from its state, never "not-applicable"
# (state-blind exemption would launder real failures). `skip_reason` is null
# for every non-exempt entry, so an unexplained skip fails closed.
# The aggregate flags are computed in a separate `|` stage over the classified
# array — an older jq/jaq grammar (CI) rejects `key: (a) and (b)` inside an
# object construction, but accepts the same expression applied to a stream.
echo "$RAW" | jq --argjson known_disabled "$KNOWN_DISABLED_JOBS" --arg pr_author "$PR_AUTHOR" '
  def disabled($name): ($known_disabled | index($name)) != null;
  def bot_author_pr: ($pr_author | test("(\\[bot\\]$|^app/)"));
  def bot_author_description: ((.description // "") | test("(?i)^review skipped.*bot user"));
  def bot_author_skip:
    (.name == "CodeRabbit") and (.bucket == "skipping") and bot_author_pr
    and (((.description // "") == "") or bot_author_description);
  def skip_reason:
    if disabled(.name) and .bucket == "skipping" then "known-disabled-job"
    elif bot_author_skip then "bot-author"
    else null
    end;
  map(skip_reason as $reason | {
    name: .name,
    state: .state,
    bucket: .bucket,
    workflow: .workflow,
    link: .link,
    classification: (
      if $reason != null then "not-applicable"
      elif .bucket == "pass" then "pass"
      elif .bucket == "fail" then "fail"
      elif .bucket == "pending" then "pending"
      elif .bucket == "skipping" then "skip"
      elif .bucket == "cancel" then "fail"
      else "unknown"
      end
    ),
    skip_reason: $reason
  })
  | {
  checks: .,
  all_passed: ((length > 0) and all(.[]; .classification == "pass" or .classification == "not-applicable")),
  any_failing: any(.[]; .classification == "fail"),
  any_pending: any(.[]; .classification == "pending")
}'
