#!/usr/bin/env bash
# pr-labels-from-issue: copy process labels from a PR's linked issues
# (arbsec/orchestraitor#469). A PR that references issues with a closing
# keyword (`Closes #N` / `Fixes #N` / `Resolves #N`) or a related keyword
# (`Part of #N` / `Refs #N` — arbsec/orchestraitor#744) inherits the PROCESS
# labels its linked issues already carry — the classification the issue
# triage produced — instead of relying on a worker to re-derive it (or forget
# to). A related reference propagates labels but never closes anything.
#
# A related reference is recognised only where a reader would SEE it: the
# related family is read from the body's Markdown PROSE, so a reference
# quoted inside code (a fenced block, an indented block, an inline code
# span), hidden inside an HTML comment, or buried in a link destination is
# not a reference. The closing family is read from the RAW body (unchanged,
# byte for byte) — see the note below.
#
# Only the process-classification allowlist is copied, and only when the
# issue actually carries the label: non-process labels (attribution,
# lifecycle noise) are never copied, and the script never removes any label.
# Application is idempotent: a label already on the PR is not re-added.
#
# Positional: <pr-number>. Flags: --repo <owner/name>, --dry-run.
# All gh calls — reads and mutations alike — route through the
# service-identity wrapper (orc_lib_gh_service) so every read and write uses
# the configured App identity.
#
# Exit codes: 0 ok (including "no linked issues" and per-issue skips that
# only warned) | 1 PR read failure | 2 usage/config error.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=_lib.sh
source "$SCRIPT_DIR/_lib.sh"

orc_lib_parse_common "$@"

if [ "$OPT_HELP" = true ]; then
  orc_lib_print_help "pr-labels-from-issue" "Copy process labels from the PR's linked issues onto the PR, idempotently. References read: closing (Closes/Fixes/Resolves #N, from the raw body) and related (Part of/Refs #N, with optional ':', from the body's Markdown prose) — related references propagate labels but never close an issue; bare #N mentions are ignored. A related reference counts only where a reader would see it: fenced code blocks, indented code blocks, inline code spans, HTML comments and link destinations are ignored (the link TEXT is prose). Positional: <pr-number>. Flags: --repo <owner/name>."
  exit "$ORC_OK"
fi

PR="${ORC_LIB_EXTRA_ARGS[0]:-}"
if [ -z "$PR" ] || ! [[ "$PR" =~ ^[0-9]+$ ]]; then
  echo "error: numeric PR number required" >&2
  exit "$ORC_ERR_CONFIG"
fi

orc_lib_require_gh_scope
REPO="$(orc_lib_resolve_repo)"

# Process-classification allowlist: labels the repo uses to classify WORK
# (what kind of task this is, what blocks it). Intersected with each linked
# issue's labels verbatim — an issue label not on this list is never copied.
# The `needs-human-review` label is deliberately NOT copied from issues: it
# is the §21.1 human gate derived from the PR's own diff by `pr-labels`; an
# issue carrying it must not impose that gate on a PR whose diff may not
# warrant one. The script never removes any label.
PROCESS_LABELS=(
  "MVP"
  "task"
  "epic"
  "spike"
  "bug"
  "documentation"
  "test"
  "dependencies"
  "github-actions"
  "spec"
  "blocked:arbitraitor"
  "blocked:orchestraitor"
)

# --- Read the PR body ----------------------------------------------------------
BODY_FILE="$(mktemp "${TMPDIR:-/tmp}/pr-labels-from-issue-body.XXXXXX")"
PROSE_FILE="$(mktemp "${TMPDIR:-/tmp}/pr-labels-from-issue-prose.XXXXXX")"
trap 'rm -f "$BODY_FILE" "$PROSE_FILE"' EXIT
orc_lib_gh_service pr view "$PR" --repo "$REPO" --json body --jq '.body // ""' > "$BODY_FILE" ||
  { echo "error: cannot read PR #$PR body" >&2; exit "$ORC_ERR_UNRECOVERABLE"; }

# --- Reference grammar (arbsec/orchestraitor#744) ------------------------------
# TWO families of reference, distinguished by what they MEAN:
#
#   closing  `Closes #N` / `Fixes #N` / `Resolves #N` — case-insensitive, with
#            singular, plural and past-tense forms and an optional `:` between
#            keyword and number. GitHub closes the issue when the PR merges:
#            the reference is a completion claim.
#   related  `Part of #N` / `Refs #N` — same case/colon tolerance, so
#            `Part of: #N` and `Refs: #N` match too. The PR lands only part of
#            the issue, or merely tracks it (#741/#764 is the canonical case;
#            SKILL.md already tells authors to use a bare `Refs #N` for a
#            partial landing): merging must NOT close the issue.
#
# Labels propagate from BOTH families — a partial landing needs the issue's
# work classification exactly as much as a completing one — but a related
# reference is never turned into a closing one: this script closes nothing (no
# `gh issue close` anywhere), and auto-close is GitHub's own body parser acting
# on the closing keywords in the body text, which this change does not touch.
# The consumers that could hold a second, conflicting closing-keyword parser
# were audited and hold none: `pr-checks` (checks/author only),
# `reconcile-checklist` (only `<!-- orc:* -->` markers), `convergence-status`
# (threads/records/checks), `merge-gate` (delegates to convergence-status and
# matches head/base SHAs), `pr-create` (only chains this script), and orc's
# `gh-env-pr-create-chain` (only invokes the two label scripts).
#
# Two bounds are kept from the original grammar:
#   - a bare `#N` is still NOT a link: incidental mentions must not label the
#     PR (SKILL.md documents that bare mentions are invisible);
#   - `See #N` / `Related to #N` stay OUT: they are advisory prose rather than
#     a tracked link, so accepting them would label PRs from a courtesy
#     mention.
# Word boundaries: the `(^|[^[:alnum:]_])` prefix is what keeps `Subpart of
# #12` (and `Crossrefs #12`) from matching at all.
CLOSING_RE='(^|[^[:alnum:]_])(closes?|closed|fixes?|fixed|resolves?|resolved)([[:space:]]*:[[:space:]]*|[[:space:]]+)#[0-9]+'
RELATED_RE='(^|[^[:alnum:]_])(part[[:space:]]+of|refs?)([[:space:]]*:[[:space:]]*|[[:space:]]+)#[0-9]+'

# Keyword matches -> unique issue numbers in body order (awk dedups without
# reordering, so a repeated reference is fetched exactly once).
refs_from() {
  local file="$1" keyword_re="$2"
  { grep -ioE "$keyword_re" "$file" || true; } |
    { grep -ioE '#[0-9]+' || true; } |
    tr -d '#' |
    awk 'NF && !seen[$0]++'
}

# Closing references are read from the RAW body, which keeps the closing path
# byte-identical to its pre-#744 behaviour (pinned by the suite).
CLOSING_NUMBERS=()
mapfile -t CLOSING_NUMBERS < <(refs_from "$BODY_FILE" "$CLOSING_RE")

# Related references are read from PROSE ONLY: a fenced block, an indented
# block, an HTML comment, a link destination or an inline code span that
# QUOTES `Part of #N` as an example must not gain labels. Mirroring the same
# guard onto the closing path would change closing label sets, so that
# unification is deliberately a separate change rather than a silent
# behaviour shift here (the closing path's pre-existing gap is tracked in
# arbsec/orchestraitor#765).
#
# The extractor is Markdown-AWARE (awk only — no new dependency; the skill
# scripts stay bash + awk + sed). It emits the text a Markdown renderer would
# show and replaces every construct that is NOT rendered text with
# WHITESPACE, never with the empty string, so two prose fragments can never
# be concatenated into a reference the rendered body does not contain. The
# rules, in the order they are applied (block first, then inline):
#
#   block   fenced code blocks — a run of three or more backticks or tildes
#           opens a fence; only a run of the SAME character that is at
#           least as long as the opener and that carries no info string
#           closes it (a shorter run is content, and so is a fence of the
#           other character). A backtick fence's info string may not
#           contain a backtick, so a one-line "```Part of #1```" is an
#           inline code span, not a fence, and the prose after it survives;
#   block   indented code blocks — four columns of indentation, or a tab;
#   block   HTML comments — "<!-- ... -->", including the multi-line block
#           form that starts with "<!--" at the start of a line;
#   block   link reference definitions — a "[label]: ..." line;
#   inline  HTML comments that sit inside a prose line;
#   inline  link destinations — the "(...)" of an inline link or image,
#           including the "<...>" destination form inside it. The link TEXT
#           stays prose: it is what the reader sees;
#   inline  code spans — a backtick run is closed by the next run of the
#           SAME length, and runs are maximal, so a single backtick inside
#           a longer run is never a delimiter.
#
# Everything the extractor cannot resolve is DROPPED (fail closed): an
# unterminated construct swallows the rest of its line, and a reference the
# extractor cannot see is never recognised. Two narrow consequences are
# accepted rather than guessed at: a four-column-indented line is treated as
# code even where a renderer would read it as paragraph or list continuation,
# and an elided construct that sits BETWEEN the two words of a keyword
# ("Part`x` of #N") leaves whitespace behind, which the keyword grammar
# still accepts.
awk '
  # Column width of the leading whitespace; a tab advances to the next
  # multiple of four.
  function indent_width(s,   i, c, w) {
    w = 0
    for (i = 1; i <= length(s); i++) {
      c = substr(s, i, 1)
      if (c == " ") w++
      else if (c == "\t") w = int(w / 4) * 4 + 4
      else break
    }
    return w
  }

  # TRUE when the line OPENS a fenced code block; sets FCHAR and FLEN.
  # At most three spaces of indentation, then a run of three or more
  # backticks or tildes; the rest of the line is the info string, which for
  # a backtick fence may not contain a backtick.
  function opens_fence(s,   i, c, run, rest) {
    i = 1
    while (i <= length(s) && substr(s, i, 1) == " ") i++
    if (i - 1 > 3) return 0
    c = substr(s, i, 1)
    if (c != "`" && c != "~") return 0
    run = 0
    while (substr(s, i + run, 1) == c) run++
    if (run < 3) return 0
    rest = substr(s, i + run)
    if (c == "`" && index(rest, "`") > 0) return 0
    FCHAR = c
    FLEN = run
    return 1
  }

  # TRUE when the line CLOSES the open fence: the same character, a run at
  # least as long as the opener, and nothing but whitespace after it (a
  # closing fence carries no info string).
  function closes_fence(s,   i, c, run, rest) {
    i = 1
    while (i <= length(s) && substr(s, i, 1) == " ") i++
    if (i - 1 > 3) return 0
    c = substr(s, i, 1)
    if (c != FCHAR) return 0
    run = 0
    while (substr(s, i + run, 1) == c) run++
    if (run < FLEN) return 0
    rest = substr(s, i + run)
    if (rest ~ /[^ \t]/) return 0
    return 1
  }

  # TRUE when the line opens an HTML comment block: "<!--" at the start of
  # the line (up to three spaces of indentation). The block runs to the
  # line containing "-->".
  function opens_html_block(s,   i) {
    i = 1
    while (i <= length(s) && substr(s, i, 1) == " ") i++
    if (i - 1 > 3) return 0
    return substr(s, i, 4) == "<!--"
  }

  # TRUE when the line is a link reference definition ("[label]: ..."); its
  # destination is not rendered text.
  function is_link_ref_def(s) {
    return s ~ /^ {0,3}\[[^]]*\]:/
  }

  # Remove the inline HTML comments of a line. A "<!--" that is not closed
  # on the same line swallows the rest of the line and sets IN_COMMENT, so
  # the comment continues on the following lines (fail closed).
  function strip_html_comments(s,   out, i, n, at, close_at) {
    out = ""; i = 1; n = length(s)
    while (i <= n) {
      at = index(substr(s, i), "<!--")
      if (at == 0) { out = out substr(s, i); break }
      out = out substr(s, i, at - 1)
      i = i + at - 1
      close_at = index(substr(s, i + 4), "-->")
      if (close_at == 0) {
        IN_COMMENT = 1
        return out " "
      }
      i = i + close_at + 6
      out = out " "
    }
    return out
  }

  # Remove the inline link destinations of a line: the "(...)" that follows
  # a "]" is the destination (plus an optional title) of an inline link or
  # image and is not rendered text. The link TEXT is kept: it is prose. An
  # unterminated destination swallows the rest of the line (fail closed).
  function strip_link_destinations(s,   out, i, n, c, j, k, depth, inangle, end) {
    out = ""; i = 1; n = length(s)
    while (i <= n) {
      c = substr(s, i, 1)
      if (c == "]" && i < n && substr(s, i + 1, 1) == "(") {
        j = i + 2
        k = j
        while (k <= n && substr(s, k, 1) ~ /[ \t]/) k++
        depth = 1
        inangle = (k <= n && substr(s, k, 1) == "<")
        end = -1
        while (j <= n) {
          c = substr(s, j, 1)
          if (c == "\\" && j < n) { j += 2; continue }
          if (inangle) {
            if (c == ">") inangle = 0
          } else if (c == "(") {
            depth++
          } else if (c == ")") {
            depth--
            if (depth == 0) { end = j; break }
          }
          j++
        }
        if (end < 0) return out " "
        out = out " "
        i = end + 1
        continue
      }
      out = out c
      i++
    }
    return out
  }

  # Remove the inline code spans of a line: a run of N backticks is closed
  # by the NEXT run of exactly N backticks, and the span (both runs
  # included) becomes a space. A run with no such closer swallows the rest
  # of the line (fail closed). Runs are maximal, so a single backtick
  # inside a longer run is never a delimiter.
  function strip_code_spans(s,   out, i, n, runlen, j, r, found) {
    out = ""; i = 1; n = length(s)
    while (i <= n) {
      if (substr(s, i, 1) != "`") { out = out substr(s, i, 1); i++; continue }
      runlen = 0
      while (substr(s, i + runlen, 1) == "`") runlen++
      j = i + runlen
      found = 0
      while (j <= n) {
        if (substr(s, j, 1) != "`") { j++; continue }
        r = 0
        while (substr(s, j + r, 1) == "`") r++
        if (r == runlen) { found = 1; break }
        j = j + r
      }
      if (!found) return out " "
      out = out " "
      i = j + runlen
    }
    return out
  }

  BEGIN { FCHAR = ""; FLEN = 0; IN_COMMENT = 0 }

  {
    raw = $0
    if (IN_COMMENT) {
      if (index(raw, "-->") > 0) IN_COMMENT = 0
      print ""
      next
    }
    if (FCHAR != "") {
      if (closes_fence(raw)) { FCHAR = ""; FLEN = 0 }
      print ""
      next
    }
    if (indent_width(raw) >= 4) { print ""; next }
    if (opens_fence(raw)) { print ""; next }
    if (opens_html_block(raw)) {
      if (index(raw, "-->") == 0) IN_COMMENT = 1
      print ""
      next
    }
    if (is_link_ref_def(raw)) { print ""; next }
    line = strip_html_comments(raw)
    line = strip_link_destinations(line)
    line = strip_code_spans(line)
    print line
  }
' "$BODY_FILE" > "$PROSE_FILE"
RELATED_NUMBERS=()
mapfile -t RELATED_NUMBERS < <(refs_from "$PROSE_FILE" "$RELATED_RE")

# One propagation list: closing refs first (their order is the pre-#744
# receipt order), then related refs, deduplicated ACROSS families — a body
# carrying both `Closes #A` and `Part of #A` fetches and copies A once. The
# receipt keeps its single `issues` array: the propagation ACTION is identical
# for both families, so the split lives in the grammar above, not in the
# output contract.
ISSUE_NUMBERS=()
declare -A SEEN_NUMBERS=()
for num in "${CLOSING_NUMBERS[@]}" "${RELATED_NUMBERS[@]}"; do
  [ -z "$num" ] && continue
  [ -n "${SEEN_NUMBERS[$num]+x}" ] && continue
  SEEN_NUMBERS["$num"]=1
  ISSUE_NUMBERS+=("$num")
done

if [ "${#ISSUE_NUMBERS[@]}" -eq 0 ]; then
  echo "note: PR #$PR body has no closing (Closes/Fixes/Resolves #N) or related (Part of/Refs #N) references; nothing to copy" >&2
  echo '{"pr":'"$PR"',"issues":[],"labels_added":[]}'
  exit "$ORC_OK"
fi

# Comma-joined issue numbers for the JSON receipt (never space-joined).
ISSUES_JSON='['
for index in "${!ISSUE_NUMBERS[@]}"; do
  [ "$index" -gt 0 ] && ISSUES_JSON+=','
  ISSUES_JSON+="${ISSUE_NUMBERS[$index]}"
done
ISSUES_JSON+=']'

# --- Copy process labels, issue by issue ---------------------------------------
# Per-issue reads ride the routed transport (same route as the mutating
# calls); a failing issue read is non-fatal — the remaining issues still
# contribute their labels.
declare -A TO_ADD=()
declare -A SKIPPED=()
for issue in "${ISSUE_NUMBERS[@]}"; do
  issue_labels=""
  if ! issue_labels="$(orc_lib_gh_service api "repos/$REPO/issues/$issue" --jq '.labels[].name' 2>/dev/null)"; then
    echo "warning: could not read labels of issue #$issue (skipped; remaining references unaffected)" >&2
    SKIPPED["$issue"]=1
    continue
  fi
  if [ -z "$issue_labels" ] || [ "$issue_labels" = "[]" ] || [ "$issue_labels" = "null" ]; then
    echo "note: issue #$issue has no labels; nothing to copy from it" >&2
    continue
  fi
  # Label names are kept as WHOLE values (gh emits one raw value per line);
  # a label containing a comma is never split into fragments.
  while IFS= read -r label; do
    [ -z "$label" ] && continue
    for allowed in "${PROCESS_LABELS[@]}"; do
      if [ "$label" = "$allowed" ]; then
        TO_ADD["$label"]=1
        break
      fi
    done
  done <<< "$issue_labels"
done

if [ "${#TO_ADD[@]}" -eq 0 ]; then
  # All issue reads failed: the copy is INCOMPLETE, not merely empty — report
  # the skip with the retry command before the (still non-fatal) exit 0.
  if [ "${#SKIPPED[@]}" -gt 0 ]; then
    echo "WARNING: pr-labels-from-issue could not read ${#SKIPPED[@]} linked issue(s) (${!SKIPPED[*]}); the label copy is INCOMPLETE — retry manually:" >&2
    echo "  bash \"$SCRIPT_DIR/pr-labels-from-issue\" $PR --repo $REPO" >&2
  fi
  echo "note: no allowlisted process labels found on the linked issues; nothing to add" >&2
  echo '{"pr":'"$PR"',"issues":'"$ISSUES_JSON"',"labels_added":[]}'
  exit "$ORC_OK"
fi

EXISTING="$(orc_lib_gh_service pr view "$PR" --repo "$REPO" --json labels --jq '.labels[].name')" ||
  { echo "error: cannot read PR #$PR labels" >&2; exit "$ORC_ERR_UNRECOVERABLE"; }

# Idempotency: a label already present on the PR (in any case GitHub stored
# it) is not re-added. Names are read as WHOLE values (one per line) — a
# label name containing a comma is never split into fragments.
declare -A EXISTING_SET=()
while IFS= read -r label; do
  [ -z "$label" ] && continue
  EXISTING_SET["$label"]=1
done <<< "$EXISTING"

ADD=()
for label in "${!TO_ADD[@]}"; do
  if [ -z "${EXISTING_SET[$label]+x}" ]; then
    ADD+=("$label")
  fi
done
# Deterministic application order: bash hash iteration must not decide which
# label lands first (and the JSON receipt must be reproducible run to run).
IFS=$'\n' read -r -d '' -a ADD < <(printf '%s\n' "${ADD[@]}" | sort && printf '\0') || true

ADDED_JSON='['
first=true
for label in "${ADD[@]}"; do
  $first || ADDED_JSON+=','
  first=false
  ADDED_JSON+='"'"$label"'"'
done
ADDED_JSON+=']'

if [ "${#ADD[@]}" -eq 0 ]; then
  # Partial failure: some issue reads were skipped — the label copy is
  # INCOMPLETE even though this run succeeded for the rest. Warn with the
  # exact manual retry command; still exit 0 (a partial label copy never
  # orphans the PR).
  if [ "${#SKIPPED[@]}" -gt 0 ]; then
    echo "WARNING: pr-labels-from-issue could not read ${#SKIPPED[@]} linked issue(s) (${!SKIPPED[*]}); the label copy is INCOMPLETE — retry manually:" >&2
    echo "  bash \"$SCRIPT_DIR/pr-labels-from-issue\" $PR --repo $REPO" >&2
  fi
  echo "note: all process labels already present on PR #$PR; nothing to add (idempotent)" >&2
  echo '{"pr":'"$PR"',"issues":'"$ISSUES_JSON"',"labels_added":[]}'
  exit "$ORC_OK"
fi

if [ "${#SKIPPED[@]}" -gt 0 ]; then
  echo "WARNING: pr-labels-from-issue could not read ${#SKIPPED[@]} linked issue(s) (${!SKIPPED[*]}); the label copy is INCOMPLETE — retry manually:" >&2
  echo "  bash \"$SCRIPT_DIR/pr-labels-from-issue\" $PR --repo $REPO" >&2
fi

if [ "$OPT_DRY_RUN" = true ]; then
  echo "[dry-run] gh pr edit $PR --repo $REPO --add-label ${ADD[*]}" >&2
  echo "$ADDED_JSON"
  exit "$ORC_OK"
fi

ADD_ARGS=()
for label in "${ADD[@]}"; do
  ADD_ARGS+=(--add-label "$label")
done
orc_lib_gh_service pr edit "$PR" --repo "$REPO" "${ADD_ARGS[@]}" >/dev/null

echo '{"pr":'"$PR"',"issues":'"$ISSUES_JSON"',"labels_added":'"$ADDED_JSON"'}'
