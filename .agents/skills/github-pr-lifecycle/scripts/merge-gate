#!/usr/bin/env bash
# merge-gate: final merge-eligibility check. Exits 0 ONLY when the PR is safe to merge.
# Combines convergence-status with a head-SHA match check (refuse merge if head moved
# between the gate check and the merge call). Never uses --admin.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=_lib.sh
source "$SCRIPT_DIR/_lib.sh"

orc_lib_parse_common "$@"

if [ "$OPT_HELP" = true ]; then
  orc_lib_print_help "merge-gate" "Check if a PR is safe to squash-merge. Exits 0=mergeable, 6=stale review policy (refused BEFORE any merge). Never uses --admin."
  exit "$ORC_OK"
fi

PR="${ORC_LIB_EXTRA_ARGS[0]:-}"
if [ -z "$PR" ]; then
  echo "error: PR number required" >&2
  exit "$ORC_ERR_CONFIG"
fi

orc_lib_require_gh_scope
REPO="$(orc_lib_resolve_repo)"

# Review-policy provenance (arbsec/orchestraitor#748) — FIRST, before anything
# that could merge. `merge-gate` performs the merge, so a stale copy must fail
# closed here: the guard needs only the PR's baseRefOid (the trusted base
# commit) and local git objects, and it runs before convergence-status and
# before any `gh pr merge` invocation is even constructed.
MG_BASE_JSON="$(orc_lib_gh pr view "$PR" --repo "$REPO" --json baseRefOid 2>/dev/null || true)"
MG_BASE_SHA="$(echo "$MG_BASE_JSON" | jq -r '.baseRefOid // ""' 2>/dev/null || true)"
orc_lib_require_policy_current text "$MG_BASE_SHA" "merge-gate" \
  "$PR --repo $REPO --json" "$SCRIPT_DIR/pr-checks" "$SCRIPT_DIR/convergence-status" \
  "$SCRIPT_DIR/merge-gate"

# Run convergence-status first (once; stderr captured for diagnostics).
# This includes the persisted CLEAN agent-review record at the current HEAD.
CONV_ERR_FILE="$(mktemp)"
CONVERGENCE=""
CONV_EXIT=0
CONVERGENCE="$(bash "$SCRIPT_DIR/convergence-status" "$PR" --repo "$REPO" --json 2>"$CONV_ERR_FILE")" || CONV_EXIT=$?
if [ "$CONV_EXIT" -eq "$ORC_ERR_STALE_POLICY" ] ||
   [ "$(echo "$CONVERGENCE" | jq -r '.error // empty' 2>/dev/null)" = "stale-review-policy" ]; then
  # A stale-policy refusal is not a verdict: propagate the typed code and its
  # message, never the "has not converged" (5) shape. Unreachable while this
  # script's own guard covers the same files; kept so a narrower sibling guard
  # can never be laundered into a blocked verdict here.
  sed 's/^/  /' "$CONV_ERR_FILE" >&2
  rm -f "$CONV_ERR_FILE"
  exit "$ORC_ERR_STALE_POLICY"
fi
if ! echo "$CONVERGENCE" | jq -e . >/dev/null 2>&1; then
  # convergence-status hard-failed (no usable JSON) — surface the sub-check's
  # name and stderr instead of reporting an empty reason list.
  echo "error: sub-check 'convergence-status' failed (exit $CONV_EXIT):" >&2
  sed 's/^/  /' "$CONV_ERR_FILE" >&2
  rm -f "$CONV_ERR_FILE"
  exit "$ORC_ERR_UNRECOVERABLE"
fi
rm -f "$CONV_ERR_FILE"
if [ "$(echo "$CONVERGENCE" | jq -r '.mergeable')" != "true" ]; then
  REASONS="$(echo "$CONVERGENCE" | jq -r '.reasons // [] | join(", ")')"
  echo "error: PR has not converged. Reasons: $REASONS" >&2
  if [ "$OPT_DRY_RUN" = true ]; then
    echo "[dry-run] Would NOT merge: convergence check failed." >&2
  fi
  exit "$ORC_ERR_BLOCKED"
fi

# Read the head SHA for --match-head-commit and re-check BOTH anchors: a
# changed head invalidates the review generation outright, and a changed
# base changes the diff the generation reviewed even at an unchanged head
# (a stale clean run must not pass on a base advance).
PR_STATE="$(orc_lib_gh pr view "$PR" --repo "$REPO" --json baseRefOid,headRefOid)"
HEAD_SHA="$(jq -r '.headRefOid' <<<"$PR_STATE")"
if [ "$HEAD_SHA" != "$(jq -r '.head_sha' <<<"$CONVERGENCE")" ] ||
   [ "$(jq -r '.baseRefOid' <<<"$PR_STATE")" != "$(jq -r '.base_oid' <<<"$CONVERGENCE")" ]; then
  echo "error: PR head or base changed after convergence; rerun review and the merge gate" >&2
  exit "$ORC_ERR_CONCURRENT"
fi

if [ "$OPT_DRY_RUN" = true ]; then
  echo "[dry-run] gh pr merge $PR --repo $REPO --squash --delete-branch --match-head-commit $HEAD_SHA" >&2
  echo "[dry-run] (executed via 'orc github gh-env --' when github_app config is present)" >&2
  echo "[dry-run] PR is mergeable at HEAD $HEAD_SHA." >&2
  exit "$ORC_OK"
fi

# Perform the merge.
echo "Merging PR #$PR (squash, HEAD=$HEAD_SHA)..." >&2
ARGS=(pr merge "$PR" --repo "$REPO" --squash --delete-branch --match-head-commit "$HEAD_SHA")
orc_lib_gh_service "${ARGS[@]}"

echo "Merged. Cleaning up worktree..." >&2
echo "Done. Post-merge: close linked issue, remove worktree, set issue Status=Done." >&2
