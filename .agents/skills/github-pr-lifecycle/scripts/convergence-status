#!/usr/bin/env bash
# convergence-status: compute whether a PR has converged (mergeable) by combining
# pr-checks + review-threads + reconcile-checklist + review-generation state.
# Exits 0 only when all four are true.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=_lib.sh
source "$SCRIPT_DIR/_lib.sh"

orc_lib_parse_common "$@"

if [ "$OPT_HELP" = true ]; then
  orc_lib_print_help "convergence-status" "Compute PR convergence (mergeable?) by combining checks + threads + checklist + review state. Exit 0=mergeable, 5=blocked, 6=stale review policy (refused; no verdict emitted)."
  exit "$ORC_OK"
fi

PR="${ORC_LIB_EXTRA_ARGS[0]:-}"
if [ -z "$PR" ]; then
  echo "error: PR number required" >&2
  exit "$ORC_ERR_CONFIG"
fi

orc_lib_require_gh_scope
REPO="$(orc_lib_resolve_repo)"

# Every verdict input is initialised EMPTY and every sub-read is validated
# before it is used. An empty value is never a verdict: a failed or malformed
# sub-read FAILS the script (exit 1) instead of rendering as `0` / `false` in
# the `--json` block (the `tonumber? // 0` coercion did exactly that for a
# failed `review-threads`, arbsec/orchestraitor#799 round 8).
ALL_CHECKS_PASS=""
CHECKS_PENDING=""
UNRESOLVED_THREADS=""
ALL_CHECKED=""
UNCHECKED_COUNT=""
MARKERS_PRESENT=""
MARKER_COUNT=""
CHECKLIST_UNPARSEABLE=""
CHECKLIST_UNPARSEABLE_LINE=""
REVIEW_DECISION=""
IS_DRAFT=""

# Reads one scalar from a sub-read's JSON into SUB_READ_VALUE. A jq failure or
# an absent (null) field FAILS the script unless the field is legitimately
# nullable: an unread fact must never become a clean verdict input, and it must
# never be inferred as `0` / `false` (the `tonumber? // 0` coercion rendered a
# failed `review-threads` as `unresolved_actionable_threads: 0`,
# arbsec/orchestraitor#799 round 8). Called WITHOUT a command substitution so an
# `exit` here ends the script rather than a subshell.
SUB_READ_VALUE=""
sub_read() { # <json> <jq field> <label> [nullable: yes]  -> sets SUB_READ_VALUE
  local json="$1" field="$2" label="$3" nullable="${4:-no}" value
  if ! value="$(printf '%s' "$json" | jq -r ".$field")"; then
    echo "error: $label: sub-read JSON is malformed — no readable .$field; refusing to infer a value" >&2
    exit "$ORC_ERR_UNRECOVERABLE"
  fi
  if [ -z "$value" ] || [ "$value" = "null" ]; then
    if [ "$nullable" != "yes" ]; then
      echo "error: $label: sub-read JSON carries no .$field — refusing to infer a value" >&2
      exit "$ORC_ERR_UNRECOVERABLE"
    fi
    value=""
  fi
  SUB_READ_VALUE="$value"
}

# 0. Anchor + review-policy provenance. The PR's baseRefOid is the trusted base
# commit, and review policy MUST come from it, never from this checkout
# (AGENTS.md). A stale sibling `pr-checks`/`convergence-status` is refused
# (exit 6) BEFORE any verdict is computed — the #740/#748 defect was a stale
# copy reporting `checks_not_passing` for a MERGEABLE PR. Reading the anchors
# first is also what makes the refusal name the base it should match.
PR_STATE_JSON="$(orc_lib_gh pr view "$PR" --repo "$REPO" --json reviewDecision,baseRefOid,headRefOid,isDraft)" || {
  echo "error: failed to read PR state" >&2
  exit "$ORC_ERR_UNRECOVERABLE"
}
# `reviewDecision` is legitimately EMPTY when no review is required (GitHub
# reports it as null), so it is read as nullable and normalised to ""; the anchors
# and the draft flag are required to be present.
sub_read "$PR_STATE_JSON" reviewDecision "PR state" yes
REVIEW_DECISION="$SUB_READ_VALUE"
sub_read "$PR_STATE_JSON" isDraft "PR state"
IS_DRAFT="$SUB_READ_VALUE"
sub_read "$PR_STATE_JSON" headRefOid "PR state"
HEAD_SHA="$SUB_READ_VALUE"
sub_read "$PR_STATE_JSON" baseRefOid "PR state"
BASE_SHA="$SUB_READ_VALUE"

POLICY_MODE=text
[ "$OPT_JSON" = true ] && POLICY_MODE=json
orc_lib_require_policy_current "$POLICY_MODE" "$BASE_SHA" "convergence-status" \
  "$PR --repo $REPO --json" "$SCRIPT_DIR/pr-checks" "$SCRIPT_DIR/convergence-status"

# 1. Checks: all required + non-optional must pass.
CHECKS_JSON="$(bash "$SCRIPT_DIR/pr-checks" "$PR" --repo "$REPO" --json 2>/dev/null)" || {
  echo "error: failed to read PR checks" >&2
  exit "$ORC_ERR_UNRECOVERABLE"
}
sub_read "$CHECKS_JSON" all_passed "pr-checks"
ALL_CHECKS_PASS="$SUB_READ_VALUE"
sub_read "$CHECKS_JSON" any_pending "pr-checks"
CHECKS_PENDING="$SUB_READ_VALUE"

# 2. Review threads: all actionable threads must be resolved.
THREADS_JSON="$(bash "$SCRIPT_DIR/review-threads" "$PR" --repo "$REPO" --json 2>/dev/null)" || {
  echo "error: failed to read review threads" >&2
  exit "$ORC_ERR_UNRECOVERABLE"
}
# A failed read never reaches here (the guard above exits), and a missing count
# fails closed instead of rendering as `0`.
sub_read "$THREADS_JSON" unresolved_actionable "review-threads"
UNRESOLVED_THREADS="$SUB_READ_VALUE"
case "$UNRESOLVED_THREADS" in
  ''|*[!0-9]*)
    echo "error: review-threads: .unresolved_actionable is not a count ('$UNRESOLVED_THREADS')" >&2
    exit "$ORC_ERR_UNRECOVERABLE" ;;
esac

# 3. Checklist: the body must carry the managed orc:* markers AND all of them
# must be checked. A body with ZERO markers is MISSING evidence, never a vacuous
# pass: it blocks with the distinct reason `checklist_markers_missing` (#788 —
# the defect was `all_checked: true` for an empty set, which reached
# merge-gate's `.mergeable` and merged a PR with no checklist evidence at all).
CHECKLIST_JSON="$(bash "$SCRIPT_DIR/reconcile-checklist" "$PR" --repo "$REPO" --json 2>/dev/null)" || {
  echo "error: failed to reconcile checklist" >&2
  exit "$ORC_ERR_UNRECOVERABLE"
}
sub_read "$CHECKLIST_JSON" all_checked "reconcile-checklist"
ALL_CHECKED="$SUB_READ_VALUE"
sub_read "$CHECKLIST_JSON" 'unchecked | length' "reconcile-checklist"
UNCHECKED_COUNT="$SUB_READ_VALUE"
sub_read "$CHECKLIST_JSON" markers_present "reconcile-checklist"
MARKERS_PRESENT="$SUB_READ_VALUE"
sub_read "$CHECKLIST_JSON" marker_count "reconcile-checklist"
MARKER_COUNT="$SUB_READ_VALUE"
# A body whose fenced scope is INDETERMINATE cannot be read at all: an opener
# indented 1-3 spaces may belong to a list item or a block quote, and the
# scanner has no container model (#809). Fail closed — never guess. The
# condition is STICKY: it applies whether or not the region closes, because a
# closer can end the region earlier for the renderer than for the scan, so a
# swallowed marker can still be visible to a human.
sub_read "$CHECKLIST_JSON" unparseable "reconcile-checklist"
CHECKLIST_UNPARSEABLE="$SUB_READ_VALUE"
sub_read "$CHECKLIST_JSON" unparseable_line "reconcile-checklist" yes
CHECKLIST_UNPARSEABLE_LINE="$SUB_READ_VALUE"

# 4. Require persisted CLEAN review evidence for the exact current HEAD.
# The record's fixed metadata header is authoritative; finding text below it
# must never be interpreted as verdict or SHA metadata. The PR state (and thus
# the head/base anchors verified above in step 0) is read once, before the
# sub-checks run.
AGENT_REVIEW_CLEAN=false
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  echo "error: convergence-status requires running from the target git checkout" >&2
  exit "$ORC_ERR_CONFIG"
}
RECORDS_DIR="$REPO_ROOT/.orchestraitor/reviews"
RECORD_PATH="$RECORDS_DIR/${PR}-${HEAD_SHA:0:7}.md"
if [[ "$HEAD_SHA" =~ ^[0-9a-f]{40}$ ]] && [[ "$BASE_SHA" =~ ^[0-9a-f]{40}$ ]] && [ -f "$RECORD_PATH" ]; then
  if [ "$(sed -n '3p' "$RECORD_PATH")" = "- verdict: CLEAN" ] &&
     [ "$(sed -n '5p' "$RECORD_PATH")" = "- head SHA: $HEAD_SHA" ] &&
     [ "$(sed -n '6p' "$RECORD_PATH")" = "- base OID: $BASE_SHA" ]; then
    AGENT_REVIEW_CLEAN=true
  fi
fi

# Compute verdict.
REASONS=""
[ "$AGENT_REVIEW_CLEAN" != "true" ] && REASONS="${REASONS}agent_review_not_clean_at_head, "
[ "$ALL_CHECKS_PASS" != "true" ] && REASONS="${REASONS}checks_not_passing, "
[ "$CHECKS_PENDING" = "true" ] && REASONS="${REASONS}checks_pending, "
[ "$UNRESOLVED_THREADS" != "0" ] && REASONS="${REASONS}unresolved_threads(${UNRESOLVED_THREADS}), "
# Two distinct checklist failures: a marker-less body is MISSING evidence
# (`checklist_markers_missing`) and a marker-bearing body with unticked boxes is
# `unchecked_items(N)` — never collapsed into one code (#788). An INDETERMINATE
# fenced scope is a third, distinct code (`checklist_unparseable`): the scan
# cannot say what is code, so no checklist reading is trusted (#809). There is NO
# author-granted opt-out: a body that carries no marker always blocks, because
# the author cannot grant themselves the exemption (an exemption needs an
# authority they lack — arbsec/orchestraitor#801).
if [ "$CHECKLIST_UNPARSEABLE" = "true" ]; then
  REASONS="${REASONS}checklist_unparseable, "
elif [ "$MARKERS_PRESENT" = "true" ]; then
  [ "$ALL_CHECKED" != "true" ] && REASONS="${REASONS}unchecked_items(${UNCHECKED_COUNT}), "
else
  REASONS="${REASONS}checklist_markers_missing, "
fi
[ "$REVIEW_DECISION" = "REVIEW_REQUIRED" ] && REASONS="${REASONS}review_required, "
[ "$IS_DRAFT" = "true" ] && REASONS="${REASONS}is_draft, "
REASONS="${REASONS%, }"

MERGEABLE="true"
[ -n "$REASONS" ] && MERGEABLE="false"

# The explanatory line for an indeterminate fence scope: it NAMES the construct
# and the fix. Printed on stdout in text mode and on stderr in JSON mode (the
# JSON stdout stays a pure typed payload).
UNPARSEABLE_EXPLANATION="checklist_unparseable: the PR body opens a fenced code block indented 1-3 spaces (line ${CHECKLIST_UNPARSEABLE_LINE:-?}), closed or not; its container scope — top level, list item, or block quote — is indeterminate, so the checklist cannot be read. Fix: dedent the fence opener to column 0."
if [ "$CHECKLIST_UNPARSEABLE" = "true" ] && [ "$OPT_JSON" = true ]; then
  echo "$UNPARSEABLE_EXPLANATION" >&2
fi

if [ "$OPT_JSON" = true ]; then
  jq -n \
    --arg mergeable "$MERGEABLE" \
    --arg reasons "$REASONS" \
    --arg head_sha "$HEAD_SHA" \
    --arg base_oid "$BASE_SHA" \
    --arg all_checks_pass "$ALL_CHECKS_PASS" \
    --arg unresolved "$UNRESOLVED_THREADS" \
    --arg unchecked "$UNCHECKED_COUNT" \
    --arg marker_count "$MARKER_COUNT" \
    --arg markers_present "$MARKERS_PRESENT" \
    --arg unparseable "$CHECKLIST_UNPARSEABLE" \
    --arg unparseable_line "$CHECKLIST_UNPARSEABLE_LINE" \
    --arg review_decision "$REVIEW_DECISION" \
    --arg is_draft "$IS_DRAFT" \
    '{
      mergeable: ($mergeable == "true"),
      reasons: ($reasons | split(", ") | map(select(length > 0))),
      head_sha: $head_sha,
      base_oid: $base_oid,
      checks_all_passed: ($all_checks_pass == "true"),
      unresolved_actionable_threads: ($unresolved | tonumber),
      unchecked_checklist_items: ($unchecked | tonumber),
      checklist_marker_count: ($marker_count | tonumber),
      checklist_markers_present: ($markers_present == "true"),
      checklist_unparseable: ($unparseable == "true"),
      checklist_unparseable_line: (if $unparseable_line == "" then null else ($unparseable_line | tonumber) end),
      review_decision: $review_decision,
      is_draft: ($is_draft == "true")
    }'
else
  if [ "$MERGEABLE" = "true" ]; then
    echo "CONVERGED: PR #$PR is mergeable at HEAD $HEAD_SHA."
  else
    echo "NOT CONVERGED: PR #$PR is blocked."
    echo "  Reasons: $REASONS"
    [ "$CHECKLIST_UNPARSEABLE" = "true" ] && echo "  $UNPARSEABLE_EXPLANATION"
  fi
fi

if [ "$MERGEABLE" = "true" ]; then
  exit "$ORC_OK"
else
  exit "$ORC_ERR_BLOCKED"
fi
