#!/usr/bin/env bash
# convergence-status: compute whether a PR has converged (mergeable) by combining
# pr-checks + review-threads + reconcile-checklist + review-generation state.
# Exits 0 only when all four are true.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=_lib.sh
source "$SCRIPT_DIR/_lib.sh"

orc_lib_parse_common "$@"

if [ "$OPT_HELP" = true ]; then
  orc_lib_print_help "convergence-status" "Compute PR convergence (mergeable?) by combining checks + threads + checklist + review state. Exit 0=mergeable, 5=blocked, 6=stale review policy (refused; no verdict emitted)."
  exit "$ORC_OK"
fi

PR="${ORC_LIB_EXTRA_ARGS[0]:-}"
if [ -z "$PR" ]; then
  echo "error: PR number required" >&2
  exit "$ORC_ERR_CONFIG"
fi

orc_lib_require_gh_scope
REPO="$(orc_lib_resolve_repo)"

# 0. Anchor + review-policy provenance. The PR's baseRefOid is the trusted base
# commit, and review policy MUST come from it, never from this checkout
# (AGENTS.md). A stale sibling `pr-checks`/`convergence-status` is refused
# (exit 6) BEFORE any verdict is computed — the #740/#748 defect was a stale
# copy reporting `checks_not_passing` for a MERGEABLE PR. Reading the anchors
# first is also what makes the refusal name the base it should match.
PR_STATE_JSON="$(orc_lib_gh pr view "$PR" --repo "$REPO" --json reviewDecision,baseRefOid,headRefOid,isDraft)" || {
  echo "error: failed to read PR state" >&2
  exit "$ORC_ERR_UNRECOVERABLE"
}
REVIEW_DECISION="$(echo "$PR_STATE_JSON" | jq -r '.reviewDecision')"
IS_DRAFT="$(echo "$PR_STATE_JSON" | jq -r '.isDraft')"
HEAD_SHA="$(echo "$PR_STATE_JSON" | jq -r '.headRefOid')"
BASE_SHA="$(echo "$PR_STATE_JSON" | jq -r '.baseRefOid')"

POLICY_MODE=text
[ "$OPT_JSON" = true ] && POLICY_MODE=json
orc_lib_require_policy_current "$POLICY_MODE" "$BASE_SHA" "convergence-status" \
  "$PR --repo $REPO --json" "$SCRIPT_DIR/pr-checks" "$SCRIPT_DIR/convergence-status"

# 1. Checks: all required + non-optional must pass.
CHECKS_JSON="$(bash "$SCRIPT_DIR/pr-checks" "$PR" --repo "$REPO" --json 2>/dev/null)" || {
  echo "error: failed to read PR checks" >&2
  exit "$ORC_ERR_UNRECOVERABLE"
}
ALL_CHECKS_PASS="$(echo "$CHECKS_JSON" | jq -r '.all_passed')"
CHECKS_PENDING="$(echo "$CHECKS_JSON" | jq -r '.any_pending')"

# 2. Review threads: all actionable threads must be resolved.
THREADS_JSON="$(bash "$SCRIPT_DIR/review-threads" "$PR" --repo "$REPO" --json 2>/dev/null)" || {
  echo "error: failed to read review threads" >&2
  exit "$ORC_ERR_UNRECOVERABLE"
}
UNRESOLVED_THREADS="$(echo "$THREADS_JSON" | jq -r '.unresolved_actionable')"

# 3. Checklist: all orc:* markers must be checked.
CHECKLIST_JSON="$(bash "$SCRIPT_DIR/reconcile-checklist" "$PR" --repo "$REPO" --json 2>/dev/null)" || {
  echo "error: failed to reconcile checklist" >&2
  exit "$ORC_ERR_UNRECOVERABLE"
}
ALL_CHECKED="$(echo "$CHECKLIST_JSON" | jq -r '.all_checked')"
UNCHECKED_COUNT="$(echo "$CHECKLIST_JSON" | jq -r '.unchecked | length')"

# 4. Require persisted CLEAN review evidence for the exact current HEAD.
# The record's fixed metadata header is authoritative; finding text below it
# must never be interpreted as verdict or SHA metadata. The PR state (and thus
# the head/base anchors verified above in step 0) is read once, before the
# sub-checks run.
AGENT_REVIEW_CLEAN=false
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || {
  echo "error: convergence-status requires running from the target git checkout" >&2
  exit "$ORC_ERR_CONFIG"
}
RECORDS_DIR="$REPO_ROOT/.orchestraitor/reviews"
RECORD_PATH="$RECORDS_DIR/${PR}-${HEAD_SHA:0:7}.md"
if [[ "$HEAD_SHA" =~ ^[0-9a-f]{40}$ ]] && [[ "$BASE_SHA" =~ ^[0-9a-f]{40}$ ]] && [ -f "$RECORD_PATH" ]; then
  if [ "$(sed -n '3p' "$RECORD_PATH")" = "- verdict: CLEAN" ] &&
     [ "$(sed -n '5p' "$RECORD_PATH")" = "- head SHA: $HEAD_SHA" ] &&
     [ "$(sed -n '6p' "$RECORD_PATH")" = "- base OID: $BASE_SHA" ]; then
    AGENT_REVIEW_CLEAN=true
  fi
fi

# Compute verdict.
REASONS=""
[ "$AGENT_REVIEW_CLEAN" != "true" ] && REASONS="${REASONS}agent_review_not_clean_at_head, "
[ "$ALL_CHECKS_PASS" != "true" ] && REASONS="${REASONS}checks_not_passing, "
[ "$CHECKS_PENDING" = "true" ] && REASONS="${REASONS}checks_pending, "
[ "$UNRESOLVED_THREADS" != "0" ] && REASONS="${REASONS}unresolved_threads(${UNRESOLVED_THREADS}), "
[ "$ALL_CHECKED" != "true" ] && REASONS="${REASONS}unchecked_items(${UNCHECKED_COUNT}), "
[ "$REVIEW_DECISION" = "REVIEW_REQUIRED" ] && REASONS="${REASONS}review_required, "
[ "$IS_DRAFT" = "true" ] && REASONS="${REASONS}is_draft, "
REASONS="${REASONS%, }"

MERGEABLE="true"
[ -n "$REASONS" ] && MERGEABLE="false"

if [ "$OPT_JSON" = true ]; then
  jq -n \
    --arg mergeable "$MERGEABLE" \
    --arg reasons "$REASONS" \
    --arg head_sha "$HEAD_SHA" \
    --arg base_oid "$BASE_SHA" \
    '{
      mergeable: ($mergeable == "true"),
      reasons: ($reasons | split(", ") | map(select(length > 0))),
      head_sha: $head_sha,
      base_oid: $base_oid,
      checks_all_passed: ($mergeable == "true" or true),
      unresolved_actionable_threads: 0,
      unchecked_checklist_items: 0,
      review_decision: "",
      is_draft: false
    }'
else
  if [ "$MERGEABLE" = "true" ]; then
    echo "CONVERGED: PR #$PR is mergeable at HEAD $HEAD_SHA."
  else
    echo "NOT CONVERGED: PR #$PR is blocked."
    echo "  Reasons: $REASONS"
  fi
fi

if [ "$MERGEABLE" = "true" ]; then
  exit "$ORC_OK"
else
  exit "$ORC_ERR_BLOCKED"
fi
