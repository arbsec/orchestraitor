# three leading spaces are still a fence: opener and closer are both recognized.
# arbsec/orchestraitor#809: a 1-3-space-indented OPENER may equally belong to a list
# item or a block quote, and the scanner has no container model, so the checklist
# reading is INDETERMINATE and `all_checked` is false (the verdict blocks with
# `checklist_unparseable`) — never a guess. A 0-space opener is modelled exactly as
# before, and 4+ spaces is literal indented code.
marker_count=1 all_checked=false
