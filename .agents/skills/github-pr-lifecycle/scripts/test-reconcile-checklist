#!/usr/bin/env bash
# Regression tests for the managed-checklist contract (arbsec/orchestraitor#788):
# a PR body with ZERO `<!-- orc:* -->` markers is MISSING evidence, never a
# vacuous pass. Before this, `reconcile-checklist` reported `all_checked: true`
# for an empty set (jq's `all()` over `[]` is true), `convergence-status` read
# that as green, and `merge-gate` merged a PR with no checklist evidence at all
# — reproduced with the exact merged #767 body.
#
# Also pins the other half of the fix: the gate must stay SATISFIABLE (#683), so
# `pr-create` appends the nine managed markers to a wholesale body, and the
# template/fallback copies cannot drift. A PR that ALREADY exists carries no
# marker, so `pr-mutate --inject-checklist` is the one-command remediation path
# for it.
#
# There is NO author-granted opt-out: a body that carries no marker always
# fails closed with `checklist_markers_missing`. A body sentinel
# (`<!-- orc:none -->`) is INERT — an exemption may only come from an authority
# the author does not hold (arbsec/orchestraitor#801).
#
# Synthetic `gh` responses; no network or provider calls.
#
# Covers:
#   (a) marker-less body -> marker_count 0, markers_present false,
#       all_checked false, items [], no waiver (the vacuous-pass defect)
#   (a2) text mode names the missing state instead of printing nothing
#   (b) convergence-status BLOCKS a marker-less body, exit 5, with the DISTINCT
#       reason `checklist_markers_missing` (never `unchecked_items(0)`)
#   (c) markers present and all checked -> mergeable, exit 0
#   (d) markers present with one unticked -> exit 5, `unchecked_items(1)`
#   (e) the JSON telemetry is COMPUTED (the `or true` stub and the constants
#       are gone): checks_all_passed, unresolved_actionable_threads,
#       unchecked_checklist_items, checklist_marker_count, review_decision,
#       is_draft
#   (f) NO author-granted opt-out: a body sentinel waives nothing, is never
#       reported as a waiver, and never masks a partially-checked checklist
#   (f2) a marker inside a FENCED code region is an example, not evidence
#   (f3) the box character set is exactly `x`, `X` and a space
#   (f4) KNOWN GAP: one ticked marker satisfies the gate today (#800)
#   (f5) the SHARED cross-engine verdict corpus
#       (scripts/tests/checklist-corpus/): every case is asserted by THIS suite
#       and by the Rust engine in crates/orchestraitor-mcp/src/pr_status.rs, so
#       a fence-scanner divergence in either engine fails CI (#799 F16/F17)
#   (f6) fence recognition is INDENTATION-correct (at most three leading
#       spaces; four spaces or a tab is an indented code block) and INFO-STRING
#       correct (a backtick fence may not carry a backtick in its info string,
#       a tilde fence may) — with the inverse (three-space fences) pinned too
#   (g) the `_lib.sh` fallback checklist equals the repository template
#       verbatim (drift guard), and the nine lines are always landed UNCHECKED
#   (h) pr-create injects the markers into a wholesale `--body`, `--body-file`
#       and `--body-file -`, and gives a bodyless PR the checklist too; a body
#       that already carries markers is left verbatim, and `--body` +
#       `--body-file` together are refused
#   (i) pr-mutate --inject-checklist remediates an EXISTING PR: it appends the
#       checklist, is idempotent, refuses to be combined with an explicit body,
#       and its dry-run never reaches gh
#   (k) EVERY pr-mutate body route carries the checklist: `edit --body` and
#       `edit --body-file` append the nine markers to a body that carries none,
#       set an already-checklisted body with its content unchanged, and the
#       bodyless-PR note names exactly that route (pinned by running the advice
#       it prints)
#   (k2) a REFUSED body argument STOPS the script: an out-of-root `@file`, a
#       path-shaped value and their `=` forms exit 2 and never reach gh (a
#       nested command substitution used to swallow the guard's status)
#   (k3) pr-mutate `--body-file` reads through the SAME trusted-root guard as
#       pr-create, supports `-` STDIN, and refuses a terminal on STDIN
#   (k4) a body ending inside an UNCLOSED fence (backtick or tilde) is refused
#       with an error naming the fence; a CLOSED fence at the end still appends
#   (k5) `--inject-checklist` skips only the body update: other edit flags run
#   (k6) the `=` forms of both body routes carry the checklist
#   (j) the fixture's git calls ignore an ambient git LOCATION (GIT_DIR /
#       GIT_WORK_TREE / GIT_INDEX_FILE): `git -C` does not isolate the git
#       location, so an inherited location would commit the CALLER's tree
set -uo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/../../../.." && pwd)"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT
mkdir -p "$TMP/repo/scripts" "$TMP/repo/.github" "$TMP/bin" "$TMP/files"

# --- (j) git helper: the ambient git LOCATION is scrubbed ------------------------
# `git -C <dir>` does NOT isolate the git location: a hook-exported
# GIT_DIR/GIT_WORK_TREE wins over `-C`, so an inherited location resolves the
# "repository" to the CALLER's repo — and in a fixture makes the fixture's own
# `git add -A` / `git commit` stage and commit the CALLER's working tree.
# GIT_INDEX_FILE has the same effect on the index. Every git call in this
# fixture goes through `git_repo`, which scrubs those variables.
#
# GIT_REPO_ENV holds `NAME=VALUE` assignments that are exported INTO the git
# child BEFORE the scrub, so a test can simulate a hostile ambient location.
# The scrub is applied last and therefore always wins: the overrides exist to
# prove the scrub works, never to defeat it.
GIT_REPO_ENV=()
git_repo() {
  local repo="$1"; shift
  (
    for assignment in "${GIT_REPO_ENV[@]}"; do
      export "${assignment?}"
    done
    unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE \
      GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES \
      GIT_COMMON_DIR GIT_NAMESPACE
    git -C "$repo" "$@"
  )
}

# The suite itself runs with a clean git location: a hook-exported GIT_DIR
# would otherwise redirect the fixture's own git calls (see (j)).
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE \
  GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES \
  GIT_COMMON_DIR GIT_NAMESPACE

for script in _lib.sh reconcile-checklist convergence-status pr-create pr-mutate; do
  cp -L -- "$SCRIPT_DIR/$script" "$TMP/repo/scripts/"
done
cp -L -- "$ROOT/.github/PULL_REQUEST_TEMPLATE.md" "$TMP/repo/.github/"
chmod +x "$TMP/repo/scripts/"*

# Only the checklist leg is under test here: convergence-status's other
# sub-checks are stubbed, and their own suites cover them.
cat > "$TMP/repo/scripts/pr-checks" <<'STUB'
#!/usr/bin/env bash
cat "$CHECKS_FIXTURE"
STUB
cat > "$TMP/repo/scripts/review-threads" <<'STUB'
#!/usr/bin/env bash
cat "$THREADS_FIXTURE"
STUB
chmod +x "$TMP/repo/scripts/pr-checks" "$TMP/repo/scripts/review-threads"
printf '%s\n' '{"all_passed":true,"any_pending":false}' > "$TMP/checks-ok.json"
printf '%s\n' '{"all_passed":false,"any_pending":false}' > "$TMP/checks-fail.json"
printf '%s\n' '{"unresolved_actionable":0}' > "$TMP/threads-none.json"
printf '%s\n' '{"unresolved_actionable":2}' > "$TMP/threads-two.json"
export CHECKS_FIXTURE="$TMP/checks-ok.json" THREADS_FIXTURE="$TMP/threads-none.json"

# The gh stub answers the reads the gate makes and records the body a
# `gh pr edit` would have set.
cat > "$TMP/bin/gh" <<'STUB'
#!/usr/bin/env bash
case "$1/${2:-}" in
  auth/status) exit 0 ;;
  pr/view)
    json=""; prev=""; jq_expr=""
    for a in "$@"; do
      case "$prev" in
        --json) json="$a" ;;
        --jq) jq_expr="$a" ;;
      esac
      prev="$a"
    done
    case "$json" in
      body)
        # With a --jq filter the caller wants the FILTERED value (the raw body
        # text for `.body // ""`), not the JSON envelope.
        if [ -n "$jq_expr" ]; then cat "$BODY_FIXTURE"; else jq -n --rawfile b "$BODY_FIXTURE" '{body:$b}'; fi ;;
      baseRefOid) jq -n --arg b "$TEST_BASE" '{baseRefOid:$b}' ;;
      reviewDecision,baseRefOid,headRefOid,isDraft)
        jq -n --arg h "$TEST_HEAD" --arg b "$TEST_BASE" \
          '{reviewDecision:"APPROVED",baseRefOid:$b,headRefOid:$h,isDraft:false}' ;;
      *) echo "unexpected gh pr view --json '$json'" >&2; exit 1 ;;
    esac ;;
  pr/edit)
    # Record the body this edit would set AND the full argv, so the test can
    # assert both on the value gh receives and on the flags it receives.
    printf '%s\n' "$@" > "${GH_EDIT_ARGV_FILE:-/dev/null}"
    prev=""; body=""
    for a in "$@"; do
      case "$a" in
        --body=*) body="${a#--body=}" ;;
      esac
      if [ "$prev" = "--body" ]; then body="$a"; fi
      prev="$a"
    done
    printf '%s' "$body" > "${GH_EDIT_BODY_FILE:-/dev/null}"
    exit 0 ;;
  *) echo "unexpected gh call: $*" >&2; exit 1 ;;
esac
STUB
chmod +x "$TMP/bin/gh"
cat > "$TMP/bin/orc" <<'STUB'
#!/usr/bin/env bash
case "$1/${2:-}" in
  config/validate) exit 0 ;;
  config/get) echo stub-config ;;
  github/gh-env) shift 3; exec "$@" ;;
  *) exit 1 ;;
esac
STUB
chmod +x "$TMP/bin/orc"
export PATH="$TMP/bin:/usr/bin:/bin"
export ORC_BIN="$TMP/bin/orc" GH_BIN="$TMP/bin/gh"
export ORC_GITHUB_APP_ENFORCEMENT=required
export GH_EDIT_BODY_FILE="$TMP/edited-body.md"
export GH_EDIT_ARGV_FILE="$TMP/edited-argv.txt"

# Review-policy provenance fixture (#748): the trusted base commit — reported as
# the PR's `baseRefOid` — holds exactly the copies the gate is about to run, so
# no spurious stale-policy refusal fires.
GIT_ID=(-c user.name=skills-test -c user.email=skills-test@example.invalid)
git_repo "$TMP/repo" init -q
git_repo "$TMP/repo" "${GIT_ID[@]}" add -A
git_repo "$TMP/repo" "${GIT_ID[@]}" commit -q -m "base: current review policy"
TEST_HEAD=abcdef1234567890abcdef1234567890abcdef12
TEST_BASE="$(git_repo "$TMP/repo" rev-parse HEAD)"
export TEST_HEAD TEST_BASE
mkdir -p "$TMP/repo/.orchestraitor/reviews"
# convergence-status record format: line 3 verdict, line 5 head, line 6 base.
cat > "$TMP/repo/.orchestraitor/reviews/7-abcdef1.md" <<EOF
# Agent review record: PR #7 @ abcdef1

- verdict: CLEAN
- reviewer-agent: test
- head SHA: $TEST_HEAD
- base OID: $TEST_BASE
- findings: 0

EOF

# --- body fixtures -------------------------------------------------------------
# (a) The #767 shape: prose that MENTIONS a marker, and zero checklist items.
cat > "$TMP/files/no-markers.md" <<'EOF'
## Summary

The body was rewritten to replace a false quantitative claim with honest numbers.

| script | note |
|---|---|
| reconcile-checklist | none (parses only <!-- orc:* --> markers) |
EOF
# (c) the nine managed markers, every box ticked.
grep -oP '^\s*-\s*\[[ xX]\]\s*<!--\s*orc:[A-Za-z0-9_-]+\s*-->.*$' \
  "$TMP/repo/.github/PULL_REQUEST_TEMPLATE.md" \
  | sed -E 's/^([[:space:]]*)-[[:space:]]*\[[ xX]\]/\1- [x]/' > "$TMP/files/all-checked.md"
# (d) the same nine, the first one unticked.
sed -E '1s/^- \[x\]/- [ ]/' "$TMP/files/all-checked.md" > "$TMP/files/one-unticked.md"
# (f) the body sentinel, with and without a justification. It is NOT an
# opt-out: an author cannot grant themselves the exemption.
{ cat "$TMP/files/no-markers.md"; printf '\n<!-- orc:none --> machine-authored release-notes body\n'; } \
  > "$TMP/files/sentinel.md"
{ cat "$TMP/files/no-markers.md"; printf '\n<!-- orc:none -->\n'; } > "$TMP/files/bare-sentinel.md"
# (f) a sentinel beside a partially-checked checklist is INERT.
{ printf '<!-- orc:none --> sneaky waiver\n'; cat "$TMP/files/one-unticked.md"; } \
  > "$TMP/files/sentinel-plus-markers.md"
# (h) a body that already carries its own marker: never rewritten.
printf '%s\n' '- [x] <!-- orc:issue --> linked' > "$TMP/files/own-marker.md"
# (f2) a marker inside a fenced code region is an EXAMPLE, not evidence.
cat > "$TMP/files/fenced-marker.md" <<'EOF'
Here is the shape of a managed checklist:

```markdown
- [x] <!-- orc:issue --> example only
```

No real checklist here.
EOF
# (f2) a marker AFTER a closed fence IS a real checklist item.
cat > "$TMP/files/fenced-then-marker.md" <<'EOF'
```markdown
- [x] <!-- orc:issue --> example only
```

- [x] <!-- orc:tests --> a real item
EOF
# (f2) an unclosed fence runs to the end of the body.
cat > "$TMP/files/unclosed-fence.md" <<'EOF'
```markdown
- [x] <!-- orc:issue --> example only
- [x] <!-- orc:tests --> another example
EOF
# (f2) a tilde fence is a fence too.
cat > "$TMP/files/tilde-fence.md" <<'EOF'
~~~text
- [x] <!-- orc:issue --> example only
~~~
EOF
# (f2) a DIFFERENT fence character never closes a region.
cat > "$TMP/files/mixed-fence.md" <<'EOF'
```markdown
- [x] <!-- orc:issue --> example only
~~~
- [x] <!-- orc:tests --> still inside the region
```

- [x] <!-- orc:docs --> a real item after the fence closed
EOF
# (f3) the box character set is exactly `x`, `X` and a space.
printf '%s\n' '- [x] <!-- orc:issue --> lower x' > "$TMP/files/box-lower.md"
printf '%s\n' '- [X] <!-- orc:issue --> upper X' > "$TMP/files/box-upper.md"
printf '%s\n' '- [ ] <!-- orc:issue --> a space' > "$TMP/files/box-space.md"
printf '%s\n' '- [y] <!-- orc:issue --> a nonsense box' > "$TMP/files/box-nonsense.md"
# (f4) a single ticked marker: the KNOWN GAP (arbsec/orchestraitor#800).
printf '%s\n' '- [x] <!-- orc:issue --> only one marker, ticked' > "$TMP/files/one-ticked-only.md"

PASS=0; FAIL=0
assert() {
  if [ "$2" = "$3" ]; then PASS=$((PASS+1)); echo "PASS: $1"
  else FAIL=$((FAIL+1)); printf 'FAIL: %s\n  expected: %s\n  actual:   %s\n' "$1" "$2" "$3"; fi
}
run() {
  OUT="$(cd "$TMP/repo" && bash "scripts/$1" "${@:2}" 2>"$TMP/stderr")"; RC=$?
}
exists() { if [ -e "$1" ]; then echo 1; else echo 0; fi; }
ensure() { # ensure <body> -> prints the body with the managed checklist applied
  bash -c 'source "$1"; orc_lib_ensure_checklist_markers "$2" "$3"' _ \
    "$SCRIPT_DIR/_lib.sh" "$1" "$2"
}
dry_run() { # dry_run <pr-create args...> -> dry-run argv on stdout
  ( cd "$TMP/repo" && SKILL_CASE=1 bash scripts/pr-create --repo test-org/repo --dry-run "$@" 2>&1 )
}

# --- (a) reconcile-checklist: the marker-less body ------------------------------
export BODY_FIXTURE="$TMP/files/no-markers.md"
run reconcile-checklist 7 --repo test-org/repo --json
assert 'a: exits 0' 0 "$RC"
assert 'a: marker_count is 0' 0 "$(jq -r .marker_count <<<"$OUT")"
assert 'a: markers_present false' false "$(jq -r .markers_present <<<"$OUT")"
assert 'a: all_checked false (the vacuous pass)' false "$(jq -r .all_checked <<<"$OUT")"
assert 'a: items stays the empty-parse contract' 0 "$(jq -r '.items | length' <<<"$OUT")"
assert 'a: no unchecked items' 0 "$(jq -r '.unchecked | length' <<<"$OUT")"
# There is NO author-granted opt-out: the waiver fields do not exist at all.
assert 'a: no waiver field' false "$(jq -r 'has("waived")' <<<"$OUT")"
assert 'a: no waiver_reason field' false "$(jq -r 'has("waiver_reason")' <<<"$OUT")"

# --- (a2) text mode names the missing state ------------------------------------
run reconcile-checklist 7 --repo test-org/repo
assert 'a2: exits 0' 0 "$RC"
assert 'a2: names the unsubstantiated checklist' 1 \
  "$(grep -cF 'checklist UNSUBSTANTIATED' <<<"$OUT")"

# --- (b) convergence-status blocks it ------------------------------------------
run convergence-status 7 --repo test-org/repo --json
assert 'b: blocks (exit 5)' 5 "$RC"
assert 'b: mergeable false' false "$(jq -r .mergeable <<<"$OUT")"
assert 'b: the DISTINCT reason' '["checklist_markers_missing"]' \
  "$(jq -c .reasons <<<"$OUT")"
assert 'b: telemetry marker_count 0' 0 "$(jq -r .checklist_marker_count <<<"$OUT")"
assert 'b: telemetry markers_present false' false "$(jq -r .checklist_markers_present <<<"$OUT")"
assert 'b: telemetry carries no waiver field' false "$(jq -r 'has("checklist_waived")' <<<"$OUT")"
assert 'b: telemetry carries no waiver reason field' false \
  "$(jq -r 'has("checklist_waiver_reason")' <<<"$OUT")"
assert 'b: telemetry unchecked 0 (never a vacuous 0)' 0 \
  "$(jq -r .unchecked_checklist_items <<<"$OUT")"

# --- (c) all nine checked converges --------------------------------------------
export BODY_FIXTURE="$TMP/files/all-checked.md"
run reconcile-checklist 7 --repo test-org/repo --json
assert 'c: marker_count 9' 9 "$(jq -r .marker_count <<<"$OUT")"
assert 'c: markers_present true' true "$(jq -r .markers_present <<<"$OUT")"
assert 'c: all_checked true' true "$(jq -r .all_checked <<<"$OUT")"
run convergence-status 7 --repo test-org/repo --json
assert 'c: converges (exit 0)' 0 "$RC"
assert 'c: mergeable true' true "$(jq -r .mergeable <<<"$OUT")"
assert 'c: no reasons' '[]' "$(jq -c .reasons <<<"$OUT")"
assert 'c: telemetry marker_count 9' 9 "$(jq -r .checklist_marker_count <<<"$OUT")"
assert 'c: telemetry unchecked 0' 0 "$(jq -r .unchecked_checklist_items <<<"$OUT")"

# --- (d) one unticked keeps the ITEM-COUNT reason ------------------------------
export BODY_FIXTURE="$TMP/files/one-unticked.md"
run convergence-status 7 --repo test-org/repo --json
assert 'd: blocks (exit 5)' 5 "$RC"
assert 'd: unchecked_items(1), not markers_missing' '["unchecked_items(1)"]' \
  "$(jq -c .reasons <<<"$OUT")"
assert 'd: telemetry unchecked 1' 1 "$(jq -r .unchecked_checklist_items <<<"$OUT")"

# --- (e) the telemetry is COMPUTED, not stubbed --------------------------------
# The pre-#788 shapes were `checks_all_passed: ($mergeable == "true" or true)`
# (always true), `unresolved_actionable_threads: 0`, `unchecked_checklist_items:
# 0`, `review_decision: ""`, `is_draft: false` — constants. A gate that reports a
# false diagnostic invites a wrong decision later (#429 item 1).
export BODY_FIXTURE="$TMP/files/all-checked.md"
export CHECKS_FIXTURE="$TMP/checks-fail.json" THREADS_FIXTURE="$TMP/threads-two.json"
run convergence-status 7 --repo test-org/repo --json
assert 'e: blocks on checks and threads' 5 "$RC"
assert 'e: both reasons reported in order' \
  '["checks_not_passing","unresolved_threads(2)"]' "$(jq -c .reasons <<<"$OUT")"
assert 'e: checks_all_passed is real' false "$(jq -r .checks_all_passed <<<"$OUT")"
assert 'e: unresolved count is real' 2 "$(jq -r .unresolved_actionable_threads <<<"$OUT")"
assert 'e: review_decision is real' APPROVED "$(jq -r .review_decision <<<"$OUT")"
assert 'e: is_draft is real' false "$(jq -r .is_draft <<<"$OUT")"
export CHECKS_FIXTURE="$TMP/checks-ok.json" THREADS_FIXTURE="$TMP/threads-none.json"

# --- (f) there is NO author-granted opt-out ------------------------------------
# A body sentinel (`<!-- orc:none -->`) is inert: it never waives the marker
# requirement, is never reported as a waiver, and never masks a
# partially-checked checklist. An exemption may only come from an authority the
# author does not hold (arbsec/orchestraitor#801).
export BODY_FIXTURE="$TMP/files/sentinel.md"
run reconcile-checklist 7 --repo test-org/repo --json
assert 'f: a sentinel is not a marker' 0 "$(jq -r .marker_count <<<"$OUT")"
assert 'f: a sentinel never waives' false "$(jq -r 'has("waived")' <<<"$OUT")"
assert 'f: a sentinel is not "all checked"' false "$(jq -r .all_checked <<<"$OUT")"
run convergence-status 7 --repo test-org/repo --json
assert 'f: a sentinel body still blocks (exit 5)' 5 "$RC"
assert 'f: a sentinel still reports markers_missing' '["checklist_markers_missing"]' \
  "$(jq -c .reasons <<<"$OUT")"
assert 'f: the sentinel is not recorded as a waiver' false \
  "$(jq -r 'has("checklist_waived")' <<<"$OUT")"
assert 'f: no waiver is announced on stderr' 0 \
  "$(grep -cF 'WAIVED' "$TMP/stderr")"

export BODY_FIXTURE="$TMP/files/bare-sentinel.md"
run convergence-status 7 --repo test-org/repo --json
assert 'f: a bare sentinel blocks too (exit 5)' 5 "$RC"
assert 'f: a bare sentinel still reports markers_missing' '["checklist_markers_missing"]' \
  "$(jq -c .reasons <<<"$OUT")"

export BODY_FIXTURE="$TMP/files/sentinel-plus-markers.md"
run convergence-status 7 --repo test-org/repo --json
assert 'f: a sentinel never masks unticked boxes (exit 5)' 5 "$RC"
assert 'f: the inert sentinel leaves the item reason' '["unchecked_items(1)"]' \
  "$(jq -c .reasons <<<"$OUT")"

# --- (f2) a fenced marker is an EXAMPLE, not evidence --------------------------
export BODY_FIXTURE="$TMP/files/fenced-marker.md"
run reconcile-checklist 7 --repo test-org/repo --json
assert 'f2: a fenced marker is not a checklist item' 0 "$(jq -r .marker_count <<<"$OUT")"
assert 'f2: a fenced body has no markers' false "$(jq -r .markers_present <<<"$OUT")"
run convergence-status 7 --repo test-org/repo --json
assert 'f2: a fenced body blocks' 5 "$RC"
assert 'f2: a fenced body reports markers_missing' '["checklist_markers_missing"]' \
  "$(jq -c .reasons <<<"$OUT")"

export BODY_FIXTURE="$TMP/files/fenced-then-marker.md"
run reconcile-checklist 7 --repo test-org/repo --json
assert 'f2: a marker after a closed fence IS an item' 1 "$(jq -r .marker_count <<<"$OUT")"
assert 'f2: and it is the real one' 'tests' "$(jq -r '.items[0].marker' <<<"$OUT")"

export BODY_FIXTURE="$TMP/files/unclosed-fence.md"
run reconcile-checklist 7 --repo test-org/repo --json
assert 'f2: an unclosed fence runs to the end of the body' 0 "$(jq -r .marker_count <<<"$OUT")"

export BODY_FIXTURE="$TMP/files/tilde-fence.md"
run reconcile-checklist 7 --repo test-org/repo --json
assert 'f2: a tilde fence is a fence too' 0 "$(jq -r .marker_count <<<"$OUT")"

export BODY_FIXTURE="$TMP/files/mixed-fence.md"
run reconcile-checklist 7 --repo test-org/repo --json
assert 'f2: a different fence character never closes a region' 1 \
  "$(jq -r .marker_count <<<"$OUT")"
assert 'f2: only the marker outside the region counts' 'docs' \
  "$(jq -r '.items[0].marker' <<<"$OUT")"

# --- (f3) the box character set is exactly `x`, `X` and a space -----------------
# The Rust engine (`parse_checklist` in crates/orchestraitor-mcp/src/pr_status.rs)
# accepts exactly the same three: `x`/`X` are checked, a space is unchecked, and
# any other character is not a checklist line at all.
export BODY_FIXTURE="$TMP/files/box-lower.md"
run reconcile-checklist 7 --repo test-org/repo --json
assert 'f3: `x` is a checklist item' 1 "$(jq -r .marker_count <<<"$OUT")"
assert 'f3: `x` is checked' true "$(jq -r '.items[0].checked' <<<"$OUT")"

export BODY_FIXTURE="$TMP/files/box-upper.md"
run reconcile-checklist 7 --repo test-org/repo --json
assert 'f3: `X` is a checklist item' 1 "$(jq -r .marker_count <<<"$OUT")"
assert 'f3: `X` is checked' true "$(jq -r '.items[0].checked' <<<"$OUT")"

export BODY_FIXTURE="$TMP/files/box-space.md"
run reconcile-checklist 7 --repo test-org/repo --json
assert 'f3: a space is a checklist item' 1 "$(jq -r .marker_count <<<"$OUT")"
assert 'f3: a space is unchecked' false "$(jq -r '.items[0].checked' <<<"$OUT")"

export BODY_FIXTURE="$TMP/files/box-nonsense.md"
run reconcile-checklist 7 --repo test-org/repo --json
assert 'f3: a nonsense box is not a checklist item' 0 "$(jq -r .marker_count <<<"$OUT")"
assert 'f3: a nonsense box leaves no markers' false "$(jq -r .markers_present <<<"$OUT")"

# --- (f4) KNOWN GAP: one ticked marker satisfies the gate today ----------------
# The gate requires the markers it FINDS to be present and checked; it does NOT
# require the full managed SET. A body that carries one ticked marker and drops
# the other eight therefore converges — the checklist can be shortened to a
# single tick. That is a real gap, tracked in arbsec/orchestraitor#800; this
# test pins the CURRENT behaviour so the gap stays visible and so the #800 fix
# has a failing test to flip.
export BODY_FIXTURE="$TMP/files/one-ticked-only.md"
run reconcile-checklist 7 --repo test-org/repo --json
assert 'f4: one ticked marker is counted (#800)' 1 "$(jq -r .marker_count <<<"$OUT")"
assert 'f4: one ticked marker reads as all checked (#800)' true "$(jq -r .all_checked <<<"$OUT")"
run convergence-status 7 --repo test-org/repo --json
assert 'f4: and the gate converges on it today (#800)' 0 "$RC"
assert 'f4: with no reason at all (#800)' '[]' "$(jq -c .reasons <<<"$OUT")"

# --- (f5) the SHARED cross-engine verdict corpus -------------------------------
# One body per case, shared with the Rust engine
# (`checklist_corpus_matches_both_engines` in
# crates/orchestraitor-mcp/src/pr_status.rs): each `<nn>-<slug>.md` body must
# reconcile to the `(marker_count, all_checked)` pair in `<nn>-<slug>.expected`.
# Both suites assert the SAME files, so a divergence in EITHER fence scanner
# fails CI — the recurring defect this corpus exists to stop
# (arbsec/orchestraitor#799 F16/F17).
CORPUS_DIR="$SCRIPT_DIR/tests/checklist-corpus"
CORPUS_CASES=0
for corpus_body in "$CORPUS_DIR"/*.md; do
  corpus_slug="$(basename "$corpus_body" .md)"
  corpus_expected="$CORPUS_DIR/$corpus_slug.expected"
  corpus_count="$(sed -n 's/.*marker_count=\([0-9][0-9]*\).*/\1/p' "$corpus_expected")"
  corpus_all="$(sed -n 's/.*all_checked=\(true\|false\).*/\1/p' "$corpus_expected")"
  export BODY_FIXTURE="$corpus_body"
  run reconcile-checklist 7 --repo test-org/repo --json
  assert "f5: $corpus_slug marker_count" "$corpus_count" \
    "$(jq -r .marker_count <<<"$OUT")"
  assert "f5: $corpus_slug all_checked" "$corpus_all" \
    "$(jq -r .all_checked <<<"$OUT")"
  CORPUS_CASES=$((CORPUS_CASES+1))
done
# Floor the count: a deleted case must FAIL instead of silently narrowing the
# contract (the same reasoning as the self-test discovery floor in skills.yml).
assert 'f5: the corpus carries at least 30 cases' 1 \
  "$([ "$CORPUS_CASES" -ge 30 ] && echo 1 || echo 0)"

# --- (f6) the fence scanner is indentation- and info-string-correct ------------
# arbsec/orchestraitor#799 F16 (generation-4 review): CommonMark allows at most
# THREE spaces before a top-level fence, so a 4-space-indented run is literal
# text. Before the fix the closer below closed the region and EXPOSED the
# checked marker GitHub renders INSIDE the fence: `all_checked: true` for
# evidence a human cannot see.
F16_CLOSER="$(cat "$CORPUS_DIR/17-four-space-closer-is-text.md")"
export BODY_FIXTURE="$CORPUS_DIR/17-four-space-closer-is-text.md"
run reconcile-checklist 7 --repo test-org/repo --json
assert 'f6: a 4-space-indented closer does not close the region' 0 \
  "$(jq -r .marker_count <<<"$OUT")"
assert 'f6: and its enclosed checked marker is not evidence' false \
  "$(jq -r .all_checked <<<"$OUT")"
assert 'f6: the guard appends the checklist (the body carries none)' 9 \
  "$(grep -c -- '- \[ \] <!-- orc:' <<<"$(ensure "$F16_CLOSER" "$TMP/repo")")"
# The inverse: a THREE-space-indented opener and closer are still fences, so a
# marker inside one is hidden and the guard still appends the checklist.
printf '   ```\n- [x] <!-- orc:tests --> example only\n   ```\n' \
  > "$TMP/files/f16-three-space.md"
export BODY_FIXTURE="$TMP/files/f16-three-space.md"
run reconcile-checklist 7 --repo test-org/repo --json
assert 'f6: three-space fences still hide their marker' 0 \
  "$(jq -r .marker_count <<<"$OUT")"
assert 'f6: and the guard still appends the checklist' 9 \
  "$(grep -c -- '- \[ \] <!-- orc:' \
    <<<"$(ensure "$(cat "$TMP/files/f16-three-space.md")" "$TMP/repo")")"

# arbsec/orchestraitor#799 F17 (generation-4 CodeRabbit): a backtick fence's
# info string may not contain a backtick, so ```example``` is a CLOSED inline
# code span — never an opener. Before the fix it opened an unclosed fence and
# the unclosed-fence guard REFUSED this legitimate body with exit 2 (#683 class)
# from both pr-create and pr-mutate.
F17_BODY="$(cat "$CORPUS_DIR/20-inline-closed-span-is-not-an-opener.md")"
F17_ENSURED="$(ensure "$F17_BODY" "$TMP/repo" 2>"$TMP/stderr")"; RC=$?
assert 'f6: a ```example``` span is not an opener (no refusal)' 0 "$RC"
assert 'f6: and the real marker survives untouched' 1 \
  "$(grep -c 'orc:tests' <<<"$F17_ENSURED")"
cp "$CORPUS_DIR/20-inline-closed-span-is-not-an-opener.md" "$TMP/files/f17-inline-span.md"
rm -f "$TMP/edited-body.md"
run pr-mutate edit 7 --repo test-org/repo --body-file "$TMP/files/f17-inline-span.md"
assert 'f6: pr-mutate does not refuse a closed ```example``` span' 0 "$RC"
assert 'f6: pr-mutate sets the body with its marker intact' 1 \
  "$(grep -c 'orc:tests' "$TMP/edited-body.md")"
OUT="$(dry_run --title t --body-file "$TMP/files/f17-inline-span.md" 2>&1)"; RC=$?
assert 'f6: pr-create does not refuse a closed ```example``` span' 0 "$RC"
assert 'f6: pr-create keeps the real marker' 1 "$(grep -c 'orc:tests' <<<"$OUT")"
# A TILDE fence MAY carry backticks in its info string (GFM), so the same
# backtick stays INSIDE the region: the marker below is not evidence.
printf '~~~text `tick`\n- [x] <!-- orc:tests --> inside the tilde fence\n~~~\n' \
  > "$TMP/files/f17-tilde-info.md"
export BODY_FIXTURE="$TMP/files/f17-tilde-info.md"
run reconcile-checklist 7 --repo test-org/repo --json
assert 'f6: tilde info strings may carry backticks' 0 \
  "$(jq -r .marker_count <<<"$OUT")"
export BODY_FIXTURE="$TMP/files/no-markers.md"

# --- (g) the fallback cannot drift from the template ---------------------------
TEMPLATE_MARKERS="$(grep -oP '^\s*-\s*\[[ xX]\]\s*<!--\s*orc:[A-Za-z0-9_-]+\s*-->.*$' \
  "$ROOT/.github/PULL_REQUEST_TEMPLATE.md" \
  | sed -E 's/^([[:space:]]*)-[[:space:]]*\[[ xX]\]/\1- [ ]/')"
FALLBACK="$(bash -c 'source "$1"; printf "%s\n" "$ORC_LIB_CHECKLIST_FALLBACK"' _ \
  "$SCRIPT_DIR/_lib.sh")"
assert 'g: the template carries nine managed markers' 9 \
  "$(printf '%s\n' "$TEMPLATE_MARKERS" | grep -c '<!-- orc:')"
assert 'g: the _lib.sh fallback equals the template verbatim' \
  "$TEMPLATE_MARKERS" "$FALLBACK"
assert 'g: the fallback lands every box unchecked' 0 \
  "$(printf '%s\n' "$FALLBACK" | grep -c '^- \[x\]')"

ENSURED="$(ensure 'wholesale body' "$TMP/repo")"
assert 'g: a wholesale body gains the nine markers' 9 \
  "$(grep -c '<!-- orc:' <<<"$ENSURED")"
assert 'g: injection lands them UNCHECKED' 0 "$(grep -c '^- \[x\]' <<<"$ENSURED")"
assert 'g: injection keeps the author body first' 1 \
  "$(head -1 <<<"$ENSURED" | grep -cF 'wholesale body')"
assert 'g: a body with a marker is returned verbatim' 'own body
- [x] <!-- orc:issue --> linked' "$(ensure 'own body
- [x] <!-- orc:issue --> linked' "$TMP/repo")"
# A body sentinel is NOT checklist-bearing: the checklist is appended.
SENTINEL_ENSURED="$(ensure 'sentinel
<!-- orc:none --> custom body' "$TMP/repo")"
assert 'g: a sentinel body is not checklist-bearing' 9 \
  "$(grep -c -- '- \[ \] <!-- orc:' <<<"$SENTINEL_ENSURED")"
assert 'g: a sentinel body keeps its own text' 1 \
  "$(grep -cF '<!-- orc:none --> custom body' <<<"$SENTINEL_ENSURED")"
# A body whose only marker sits inside a fenced code region is NOT
# checklist-bearing either: creation must still hand it the real checklist, or
# the fail-closed gate could never be satisfied (#683 class).
FENCED_ENSURED="$(ensure "$(cat "$TMP/files/fenced-marker.md")" "$TMP/repo")"
assert 'g: a fenced-only body is not checklist-bearing' 9 \
  "$(grep -c -- '- \[ \] <!-- orc:' <<<"$FENCED_ENSURED")"
assert 'g: a fenced-only body keeps its own text' 1 \
  "$(grep -cF 'example only' <<<"$FENCED_ENSURED")"

# --- (h) creation stays satisfiable: pr-create injects -------------------------
# SKILL_CASE=1 skips the pre-PR review gate (its own suite covers it); the
# dry-run stops before any gh call, so only the constructed argv is asserted.
OUT="$(dry_run --title t --body 'wholesale body')"
assert 'h: --body gains the nine markers' 9 "$(grep -c '<!-- orc:' <<<"$OUT")"
assert 'h: injected markers are unchecked' 0 "$(grep -c -- '- \[x\]' <<<"$OUT")"
assert 'h: the author body survives' 1 "$(grep -cF 'wholesale body' <<<"$OUT")"
OUT="$(dry_run --title t --body "Some \`orc:\` prose, no marker")"
assert 'h: a prose mention is not a checklist (injection still fires)' 9 \
  "$(grep -c '<!-- orc:' <<<"$OUT")"

OUT="$(dry_run --title t --body-file "$TMP/files/no-markers.md")"
assert 'h: --body-file gains the nine markers' 9 \
  "$(grep -c -- '- \[ \] <!-- orc:' <<<"$OUT")"
assert 'h: --body-file content survives' 1 "$(grep -cF 'false quantitative claim' <<<"$OUT")"
assert 'h: --body-file is resolved (no --body-file reaches gh)' 0 \
  "$(grep -c -- '--body-file' <<<"$OUT")"

# `--body-file -` reads the body from STDIN (gh's own convention, preserved
# explicitly rather than rejected).
OUT="$(printf '%s\n' 'wholesale stdin body' | dry_run --title t --body-file -)"
assert 'h: --body-file - gains the nine markers' 9 \
  "$(grep -c -- '- \[ \] <!-- orc:' <<<"$OUT")"
assert 'h: --body-file - content survives' 1 "$(grep -cF 'wholesale stdin body' <<<"$OUT")"
assert 'h: --body-file - never reaches gh as a flag' 0 \
  "$(grep -c -- '--body-file' <<<"$OUT")"
OUT="$(printf '' | dry_run --title t --body-file - 2>&1)"; RC=$?
assert 'h: an empty STDIN body is refused' 2 "$RC"

OUT="$(dry_run --title t --body-file "$TMP/files/own-marker.md")"
assert 'h: a body with its own marker is left verbatim' 1 "$(grep -c '<!-- orc:' <<<"$OUT")"
assert 'h: verbatim means no injected section' 0 "$(grep -cF 'Added by pr-create' <<<"$OUT")"

# A body sentinel is not an opt-out: the checklist is still injected.
OUT="$(dry_run --title t --body "$(cat "$TMP/files/sentinel.md")")"
assert 'h: a sentinel body still gets the injected checklist' 9 \
  "$(grep -c -- '- \[ \] <!-- orc:' <<<"$OUT")"

# A bodyless PR still gets the checklist, and says so.
OUT="$(dry_run --title t)"
assert 'h: a bodyless PR gains the nine markers' 9 \
  "$(grep -c -- '- \[ \] <!-- orc:' <<<"$OUT")"
assert 'h: a bodyless PR says the body needs a summary' 1 \
  "$(grep -cF 'NOTE: no PR body supplied' <<<"$OUT")"

dry_run --title t --body 'a' --body-file "$TMP/files/own-marker.md" >/dev/null
RC=$?
assert 'h: --body + --body-file is refused' 2 "$RC"

# --- (i) pr-mutate --inject-checklist: remediation for an EXISTING PR ----------
# `pr-create` gives a NEW PR the managed checklist. A PR that ALREADY exists
# carries none and would block forever — `--inject-checklist` is the
# one-command remediation path: read the current body, append the managed
# checklist, set the body.
export BODY_FIXTURE="$TMP/files/no-markers.md"
rm -f "$TMP/edited-body.md"
run pr-mutate edit 7 --repo test-org/repo --inject-checklist
assert 'i: the remediation exits 0' 0 "$RC"
assert 'i: the remediation reached gh pr edit' 1 "$(exists "$TMP/edited-body.md")"
EDITED="$(cat "$TMP/edited-body.md" 2>/dev/null || true)"
assert 'i: the new body carries the nine markers' 9 \
  "$(grep -c -- '- \[ \] <!-- orc:' <<<"$EDITED")"
assert 'i: the new body pre-ticks nothing' 0 "$(grep -c -- '- \[x\]' <<<"$EDITED")"
assert 'i: the author body survives' 1 "$(grep -cF 'false quantitative claim' <<<"$EDITED")"

# Idempotent: a body that already carries the checklist is left verbatim and gh
# is never called.
export BODY_FIXTURE="$TMP/files/all-checked.md"
rm -f "$TMP/edited-body.md"
run pr-mutate edit 7 --repo test-org/repo --inject-checklist
assert 'i: an already-checklisted body is a no-op (exit 0)' 0 "$RC"
assert 'i: the no-op never reaches gh' 0 "$(exists "$TMP/edited-body.md")"
assert 'i: the no-op says so' 1 \
  "$(grep -cF 'already carries the managed merge checklist' "$TMP/stderr")"

# The remediation sets the body itself: combining it with an explicit body is
# ambiguous and is refused.
export BODY_FIXTURE="$TMP/files/no-markers.md"
run pr-mutate edit 7 --repo test-org/repo --inject-checklist --body 'x'
assert 'i: --inject-checklist + --body is refused' 2 "$RC"
run pr-mutate edit 7 --repo test-org/repo --inject-checklist --body-file "$TMP/files/no-markers.md"
assert 'i: --inject-checklist + --body-file is refused' 2 "$RC"

# The dry-run never reaches gh.
rm -f "$TMP/edited-body.md"
OUT="$( cd "$TMP/repo" && SKILL_CASE=1 bash scripts/pr-mutate edit 7 \
  --repo test-org/repo --inject-checklist --dry-run 2>&1 )"; RC=$?
assert 'i: the dry-run exits 0' 0 "$RC"
assert 'i: the dry-run never reaches gh' 0 "$(exists "$TMP/edited-body.md")"
assert 'i: the dry-run says it does not reach gh' 1 \
  "$(grep -cF 'dry-run never reaches gh' <<<"$OUT")"

# --- (k) EVERY pr-mutate body route carries the checklist ---------------------
# The bodyless-PR note tells the author to add a summary with
# `pr-mutate edit <pr> --body-file <path>`. If that route set the file's text
# verbatim it would REPLACE the whole body and strip the injected checklist,
# dropping the PR back to `checklist_markers_missing` — advice that undoes
# itself. Both body routes therefore carry the same marker invariant through the
# same helper `pr-create` uses, and a body that already has a marker keeps its
# content unchanged (a command substitution normalises trailing newlines; that
# is the only difference — see the `--body-file=` trailing-newline assertion).
export BODY_FIXTURE="$TMP/files/all-checked.md"

rm -f "$TMP/edited-body.md" "$TMP/edited-argv.txt"
run pr-mutate edit 7 --repo test-org/repo --body 'A wholesale summary, no markers'
assert 'k: --body exits 0' 0 "$RC"
EDITED="$(cat "$TMP/edited-body.md" 2>/dev/null || true)"
assert 'k: --body carries the nine markers' 9 \
  "$(grep -c -- '- \[ \] <!-- orc:' <<<"$EDITED")"
assert 'k: --body keeps the summary' 1 \
  "$(grep -cF 'A wholesale summary, no markers' <<<"$EDITED")"
assert 'k: --body pre-ticks nothing' 0 "$(grep -c -- '- \[x\]' <<<"$EDITED")"
assert 'k: --body reaches gh as an explicit --body' 1 \
  "$(grep -cx -- '--body' "$TMP/edited-argv.txt")"
assert 'k: --body keeps the PR operand and repo' 2 \
  "$(grep -cE -- '^(7|--repo)$' "$TMP/edited-argv.txt")"

# The `--body=<text>` form is the same route.
rm -f "$TMP/edited-body.md"
run pr-mutate edit 7 --repo test-org/repo --body='A joined summary, no markers'
assert 'k: --body= carries the nine markers' 9 \
  "$(grep -c -- '- \[ \] <!-- orc:' "$TMP/edited-body.md")"
assert 'k: --body= keeps the summary' 1 \
  "$(grep -cF 'A joined summary, no markers' "$TMP/edited-body.md")"

# `--body-file` is READ by the script (a path cannot be annotated by gh).
rm -f "$TMP/edited-body.md" "$TMP/edited-argv.txt"
run pr-mutate edit 7 --repo test-org/repo --body-file "$TMP/files/no-markers.md"
assert 'k: --body-file exits 0' 0 "$RC"
EDITED="$(cat "$TMP/edited-body.md" 2>/dev/null || true)"
assert 'k: --body-file carries the nine markers' 9 \
  "$(grep -c -- '- \[ \] <!-- orc:' <<<"$EDITED")"
assert 'k: --body-file keeps the summary' 1 \
  "$(grep -cF 'false quantitative claim' <<<"$EDITED")"
assert 'k: --body-file never reaches gh as a flag' 0 \
  "$(grep -c -- '--body-file' "$TMP/edited-argv.txt")"

# A supplied body that already carries a marker is a verified fact: set it
# unchanged, never re-injected, never rewritten.
OWN_BODY='## Summary
- [x] <!-- orc:tests --> the suite passes'
printf '%s' "$OWN_BODY" > "$TMP/files/own-marker-body.txt"
printf '%s\n' "$OWN_BODY" > "$TMP/files/own-marker-body-nl.md"
rm -f "$TMP/edited-body.md"
run pr-mutate edit 7 --repo test-org/repo --body "$OWN_BODY"
assert 'k: an already-checklisted --body is byte-identical' identical \
  "$(cmp -s "$TMP/files/own-marker-body.txt" "$TMP/edited-body.md" && echo identical || echo different)"
assert 'k: verbatim means no injected section' 0 \
  "$(grep -cF 'Added by pr-create' "$TMP/edited-body.md")"
rm -f "$TMP/edited-body.md"
run pr-mutate edit 7 --repo test-org/repo --body-file "$TMP/files/own-marker-body-nl.md"
assert 'k: an already-checklisted --body-file is not re-injected' 1 \
  "$(grep -c '<!-- orc:' "$TMP/edited-body.md")"

# `--inject-checklist` still refuses an explicit body (now genuinely redundant:
# both routes carry the checklist).
run pr-mutate edit 7 --repo test-org/repo --inject-checklist --body 'x'
assert 'k: --inject-checklist + --body is still refused' 2 "$RC"
run pr-mutate edit 7 --repo test-org/repo --inject-checklist --body-file "$TMP/files/no-markers.md"
assert 'k: --inject-checklist + --body-file is still refused' 2 "$RC"

# The dry-run path carries the checklist in the constructed argv and never
# reaches gh.
rm -f "$TMP/edited-body.md"
OUT="$( cd "$TMP/repo" && SKILL_CASE=1 bash scripts/pr-mutate edit 7 \
  --repo test-org/repo --body 'x' --dry-run 2>&1 )"; RC=$?
assert 'k: a body-route dry-run exits 0' 0 "$RC"
assert 'k: a body-route dry-run never reaches gh' 0 "$(exists "$TMP/edited-body.md")"
assert 'k: the dry-run argv carries the nine markers' 9 \
  "$(grep -c -- '- \[ \] <!-- orc:' <<<"$OUT")"

# --- (k2) a REFUSED body argument must STOP the script -------------------------
# `X="$(f "$(g)")"` takes the OUTER substitution's status, so when `g` exits 2
# the failure never reaches `set -e`: the typed error was printed and `gh pr
# edit` then ran anyway with a checklist-only body, exit 0 — the body the author
# wrote was discarded (#788 gen-3 review; both adversarial sources). Each route
# now resolves in its own assignment, so the guard's status IS the assignment's
# status. `gh` must never be invoked, which the argv capture proves: the file
# only exists if the stub was reached.
OUT_OF_ROOT=/etc/passwd

rm -f "$TMP/edited-body.md" "$TMP/edited-argv.txt"
run pr-mutate edit 7 --repo test-org/repo --body "@$OUT_OF_ROOT"
assert 'k: --body @<out-of-root> is refused' 2 "$RC"
assert 'k: the out-of-root @file refusal is typed' 1 \
  "$(grep -cF 'outside the trusted roots' "$TMP/stderr")"
assert 'k: the out-of-root @file refusal never reaches gh' 0 "$(exists "$TMP/edited-argv.txt")"

rm -f "$TMP/edited-body.md" "$TMP/edited-argv.txt"
run pr-mutate edit 7 --repo test-org/repo --body "$OUT_OF_ROOT"
assert 'k: a path-shaped --body value is refused' 2 "$RC"
assert 'k: the path-shaped refusal is typed' 1 \
  "$(grep -cF 'is an existing file path, not body text' "$TMP/stderr")"
assert 'k: the path-shaped refusal never reaches gh' 0 "$(exists "$TMP/edited-argv.txt")"

rm -f "$TMP/edited-body.md" "$TMP/edited-argv.txt"
run pr-mutate edit 7 --repo test-org/repo "--body=@$OUT_OF_ROOT"
assert 'k: --body=@<out-of-root> is refused' 2 "$RC"
assert 'k: the --body=@ refusal never reaches gh' 0 "$(exists "$TMP/edited-argv.txt")"

# --- (k3) --body-file reads through the SAME trusted-root guard ----------------
# The delta turned this route from "gh reads the path" into "the script reads the
# path": without the guard the script posted any readable file, while `pr-create`
# refused the identical path (#788 gen-3 review).
rm -f "$TMP/edited-body.md" "$TMP/edited-argv.txt"
run pr-mutate edit 7 --repo test-org/repo --body-file "$OUT_OF_ROOT"
assert 'k: --body-file <out-of-root> is refused' 2 "$RC"
assert 'k: the --body-file refusal is typed' 1 \
  "$(grep -cF 'outside the trusted roots' "$TMP/stderr")"
assert 'k: the --body-file refusal never reaches gh' 0 "$(exists "$TMP/edited-argv.txt")"

rm -f "$TMP/edited-body.md" "$TMP/edited-argv.txt"
run pr-mutate edit 7 --repo test-org/repo "--body-file=$OUT_OF_ROOT"
assert 'k: --body-file=<out-of-root> is refused' 2 "$RC"
assert 'k: the --body-file= refusal never reaches gh' 0 "$(exists "$TMP/edited-argv.txt")"

# STDIN parity with `pr-create`: `--body-file -` is the gh convention.
rm -f "$TMP/edited-body.md"
OUT="$(printf '%s\n' 'a stdin summary, no markers' | (
  cd "$TMP/repo" && bash scripts/pr-mutate edit 7 --repo test-org/repo --body-file - 2>"$TMP/stderr"
))"; RC=$?
assert 'k: --body-file - exits 0' 0 "$RC"
EDITED="$(cat "$TMP/edited-body.md" 2>/dev/null || true)"
assert 'k: --body-file - gains the nine markers' 9 \
  "$(grep -c -- '- \[ \] <!-- orc:' <<<"$EDITED")"
assert 'k: --body-file - keeps the STDIN content' 1 \
  "$(grep -cF 'a stdin summary, no markers' <<<"$EDITED")"

# `--body-file -` with a TERMINAL on STDIN is refused (never a silent hang).
# A pty is required to observe the `-t 0` branch; `script` provides one. The
# child is wrapped in `bash -c` because `script -c` runs the string through the
# INVOKING user's shell (not necessarily bash).
if command -v script >/dev/null 2>&1; then
  rm -f "$TMP/edited-body.md"
  PTY_RC=0
  ( cd "$TMP/repo" && script -qec \
    "bash -c 'exec bash scripts/pr-mutate edit 7 --repo test-org/repo --body-file -'" \
    /dev/null ) >"$TMP/pty.txt" 2>&1 || PTY_RC=$?
  assert 'k: --body-file - on a terminal is refused' 2 "$PTY_RC"
  assert 'k: the terminal refusal names the STDIN forms' 1 \
    "$(grep -cF 'STDIN is a terminal' "$TMP/pty.txt")"
  assert 'k: the terminal refusal never reaches gh' 0 "$(exists "$TMP/edited-body.md")"
else
  echo 'NOTICE: `script` unavailable — the terminal-on-STDIN refusal was NOT exercised'
fi

# --- (k4) an append inside an UNCLOSED fence is refused ------------------------
# Markers appended inside an open fence are rendered as code and stripped from
# the marker scan: the "remediation" would change nothing visible and a second
# `--inject-checklist` run would append another invisible copy (#788 gen-3
# review, CodeRabbit major). The author's body is neither reordered nor repaired.
cat > "$TMP/files/unclosed-backtick.md" <<'EOF'
## Summary

An example that never closes:

```markdown
- [ ] not a real item
EOF
cat > "$TMP/files/unclosed-tilde.md" <<'EOF'
## Summary

~~~text
an example that never closes
EOF
cat > "$TMP/files/closed-fence-tail.md" <<'EOF'
## Summary

An example that DOES close:

```markdown
- [ ] not a real item
```
EOF

rm -f "$TMP/edited-body.md" "$TMP/edited-argv.txt"
run pr-mutate edit 7 --repo test-org/repo --body-file "$TMP/files/unclosed-backtick.md"
assert 'k: a body ending inside a backtick fence is refused' 2 "$RC"
assert 'k: the refusal names the unclosed fence' 1 \
  "$(grep -cF 'unclosed code fence' "$TMP/stderr")"
assert 'k: the refusal names the backtick run' 1 \
  "$(grep -cF 'opened with 3 backticks' "$TMP/stderr")"
assert 'k: the refused append never reaches gh' 0 "$(exists "$TMP/edited-argv.txt")"

rm -f "$TMP/edited-body.md" "$TMP/edited-argv.txt"
run pr-mutate edit 7 --repo test-org/repo --body-file "$TMP/files/unclosed-tilde.md"
assert 'k: a body ending inside a tilde fence is refused' 2 "$RC"
assert 'k: the refusal names the tilde run' 1 \
  "$(grep -cF 'opened with 3 tildes' "$TMP/stderr")"
assert 'k: the tilde refusal never reaches gh' 0 "$(exists "$TMP/edited-argv.txt")"

rm -f "$TMP/edited-body.md"
run pr-mutate edit 7 --repo test-org/repo --body-file "$TMP/files/closed-fence-tail.md"
assert 'k: a body ending with a CLOSED fence still appends' 0 "$RC"
assert 'k: the closed-fence body gains the nine markers' 9 \
  "$(grep -c -- '- \[ \] <!-- orc:' "$TMP/edited-body.md")"

# `pr-create` shares the helper, so the same refusal applies at creation.
OUT="$(dry_run --title t --body-file "$TMP/files/unclosed-backtick.md" 2>&1)"; RC=$?
assert 'k: pr-create refuses a body ending inside a fence' 2 "$RC"
assert 'k: the pr-create refusal names the fence' 1 \
  "$(grep -cF 'unclosed code fence' <<<"$OUT")"

# --- (k5) --inject-checklist skips ONLY the body update -----------------------
# A body that already carries the checklist used to exit 0 before executing the
# rest of the edit flags, silently discarding them (#788 gen-3 review,
# CodeRabbit minor).
export BODY_FIXTURE="$TMP/files/all-checked.md"
rm -f "$TMP/edited-body.md" "$TMP/edited-argv.txt"
run pr-mutate edit 7 --repo test-org/repo --inject-checklist --add-label needs-triage
assert 'k: --inject-checklist + another edit flag exits 0' 0 "$RC"
assert 'k: the other edit flag still reaches gh' 1 \
  "$(grep -cx -- '--add-label' "$TMP/edited-argv.txt")"
assert 'k: the other edit flag keeps its operand' 1 \
  "$(grep -cx -- 'needs-triage' "$TMP/edited-argv.txt")"
assert 'k: the skipped body update sets no --body' 0 \
  "$(grep -cx -- '--body' "$TMP/edited-argv.txt")"

# --- (k6) the `=` forms of both body routes ------------------------------------
rm -f "$TMP/edited-body.md" "$TMP/edited-argv.txt"
run pr-mutate edit 7 --repo test-org/repo --body-file="$TMP/files/no-markers.md"
assert 'k: --body-file= carries the nine markers' 9 \
  "$(grep -c -- '- \[ \] <!-- orc:' "$TMP/edited-body.md")"
assert 'k: --body-file= keeps the summary' 1 \
  "$(grep -cF 'false quantitative claim' "$TMP/edited-body.md")"
assert 'k: --body-file= never reaches gh as a flag' 0 \
  "$(grep -c -- '--body-file' "$TMP/edited-argv.txt")"

rm -f "$TMP/edited-body.md"
run pr-mutate edit 7 --repo test-org/repo "--body=$OWN_BODY"
assert 'k: an already-checklisted --body= is content-identical' identical \
  "$(cmp -s "$TMP/files/own-marker-body.txt" "$TMP/edited-body.md" && echo identical || echo different)"

# The routes resolve the body through a command substitution, so trailing
# newlines are normalised away and NOTHING else changes. That is the guarantee
# `references/pr-convergence.md` states — not "byte-for-byte".
printf '%s\n\n' "$OWN_BODY" > "$TMP/files/own-marker-trailing.md"
rm -f "$TMP/edited-body.md"
run pr-mutate edit 7 --repo test-org/repo --body-file "$TMP/files/own-marker-trailing.md"
assert 'k: a supplied body keeps its content (trailing newlines normalised)' identical \
  "$(cmp -s "$TMP/files/own-marker-body.txt" "$TMP/edited-body.md" && echo identical || echo different)"

# --- the bodyless-PR advice must name a route that KEEPS the checklist --------
# Pinned end to end: extract the command pr-create prints, then run that exact
# shape against a summary-only fixture and require a checklist-bearing body.
OUT="$(dry_run --title t)"
ADVICE_SHAPE='pr-mutate edit <pr> --body-file <path>'
assert 'k: the bodyless note names the body-file route' "$ADVICE_SHAPE" \
  "$(grep -oF "$ADVICE_SHAPE" <<<"$OUT" | head -1)"
assert 'k: the bodyless note still asks for a summary' 1 \
  "$(grep -cF 'Add a summary before requesting review' <<<"$OUT")"
cat > "$TMP/files/advice-summary.md" <<'EOF'
## Summary

A summarised change, written after the PR existed.
EOF
rm -f "$TMP/edited-body.md"
run pr-mutate edit 7 --repo test-org/repo --body-file "$TMP/files/advice-summary.md"
assert 'k: the advised route exits 0' 0 "$RC"
EDITED="$(cat "$TMP/edited-body.md" 2>/dev/null || true)"
assert 'k: the advised route produces a checklist-bearing body' 9 \
  "$(grep -c -- '- \[ \] <!-- orc:' <<<"$EDITED")"
assert 'k: the advised route keeps the summary' 1 \
  "$(grep -cF 'A summarised change, written after the PR existed.' <<<"$EDITED")"

# --- (j) the fixture's git calls ignore an ambient git LOCATION ---------------
# `git -C <dir>` does NOT isolate the git location: a hook-exported
# GIT_DIR/GIT_WORK_TREE wins over `-C`. Without the scrub the fixture's
# `git add -A` / `git commit` would stage and commit the CALLER's working tree.
SENTINEL="$TMP/sentinel"
HOSTILE="$TMP/hostile"
mkdir -p "$SENTINEL" "$HOSTILE"
git_repo "$SENTINEL" init -q
git_repo "$SENTINEL" config user.email sentinel@example.invalid
git_repo "$SENTINEL" config user.name sentinel
printf 'sentinel\n' > "$SENTINEL/README.md"
git_repo "$SENTINEL" add -A
git_repo "$SENTINEL" commit -q -m sentinel
SENTINEL_HEAD="$(git_repo "$SENTINEL" rev-parse HEAD)"
SENTINEL_LOG="$(git_repo "$SENTINEL" log --format=%s)"

# The hostile location: GIT_DIR/GIT_WORK_TREE point at the sentinel repo.
GIT_REPO_ENV=("GIT_DIR=$SENTINEL/.git" "GIT_WORK_TREE=$SENTINEL")
git_repo "$HOSTILE" init -q
git_repo "$HOSTILE" config user.email hostile@example.invalid
git_repo "$HOSTILE" config user.name hostile
printf 'hostile\n' > "$HOSTILE/README.md"
git_repo "$HOSTILE" add -A
git_repo "$HOSTILE" commit -q -m hostile
GIT_REPO_ENV=()

HOSTILE_HEAD="$(git_repo "$HOSTILE" rev-parse HEAD)"
SENTINEL_HEAD_AFTER="$(git_repo "$SENTINEL" rev-parse HEAD)"
SENTINEL_LOG_AFTER="$(git_repo "$SENTINEL" log --format=%s)"
# The fixture's own commit landed in the FIXTURE, not in the sentinel.
assert 'j: the hostile fixture carries its own commit' 'hostile' \
  "$(git_repo "$HOSTILE" log --format=%s)"
assert 'j: the hostile location did not capture the fixture' 'different' \
  "$([ "$HOSTILE_HEAD" != "$SENTINEL_HEAD" ] && echo different || echo same)"
# The sentinel repo still holds exactly its own commit: nothing leaked into it.
assert 'j: the sentinel HEAD is unchanged' "$SENTINEL_HEAD" "$SENTINEL_HEAD_AFTER"
assert 'j: the sentinel log is unchanged' "$SENTINEL_LOG" "$SENTINEL_LOG_AFTER"
# Positive control: WITHOUT the scrub the ambient location wins over `-C`, so
# the hostile values really are effective here — the scrub is what keeps the
# fixture out of the sentinel.
CONTROL_TOPLEVEL="$(GIT_DIR="$SENTINEL/.git" GIT_WORK_TREE="$SENTINEL" \
  git -C "$HOSTILE" rev-parse --show-toplevel 2>/dev/null || true)"
assert 'j: control: the ambient location does win over -C' "$SENTINEL" "$CONTROL_TOPLEVEL"

printf '\n=== reconcile-checklist regression: %s passed, %s failed ===\n' "$PASS" "$FAIL"
[ "$FAIL" -eq 0 ]
