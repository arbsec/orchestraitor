# --- (f4) KNOWN GAP: one ticked marker satisfies the gate today ----------------
# The gate requires the markers it FINDS to be present and checked; it does NOT
# require the full managed SET. A body that carries one ticked marker and drops
# the other eight therefore converges — the checklist can be shortened to a
# single tick. That is a real gap, tracked in arbsec/orchestraitor#800; this
# test pins the CURRENT behaviour so the gap stays visible and so the #800 fix
# has a failing test to flip.
export BODY_FIXTURE="$TMP/files/one-ticked-only.md"
run reconcile-checklist 7 --repo test-org/repo --json
assert 'f4: one ticked marker is counted (#800)' 1 "$(jq -r .marker_count <<<"$OUT")"
assert 'f4: one ticked marker reads as all checked (#800)' true "$(jq -r .all_checked <<<"$OUT")"
run convergence-status 7 --repo test-org/repo --json
assert 'f4: and the gate converges on it today (#800)' 0 "$RC"
assert 'f4: with no reason at all (#800)' '[]' "$(jq -c .reasons <<<"$OUT")"

# --- (f5) the SHARED cross-engine verdict corpus -------------------------------
# One body per case, shared with the Rust engine
# (`checklist_corpus_matches_both_engines` in
# crates/orchestraitor-mcp/src/pr_status.rs): each `<nn>-<slug>.md` body must
# reconcile to its row in the single `expectations.tsv`, keyed by file stem.
# Both suites assert the SAME table, so a divergence in EITHER fence scanner
# fails CI — the recurring defect this corpus exists to stop
# (arbsec/orchestraitor#799 F16/F17). ONE table (not a `.expected` file per
# case) keeps the corpus reviewable: 75 cases x 2 files pushed the PR past the
# reviewer's 150-file limit (#799 R3).
CORPUS_DIR="$SCRIPT_DIR/tests/checklist-corpus"
CORPUS_TSV="$CORPUS_DIR/expectations.tsv"
# The EXACT number of cases in the shared corpus. A deleted case must FAIL, so
# this is a floor that is also a ceiling: bump it whenever a case is added, and
# never lower it to make a red suite green. A reviewer once deleted
# `35-vt-after-closer-is-not-whitespace.md`/`.expected` and both engines stayed
# green on `-ge 30` with a 38-case corpus — the floor tracked nothing. The
# loader below ALSO fails a case file with no row and a row with no case file,
# so a deleted case cannot slip through either way.
# (The per-case rationale lives in `expectations.tsv`, next to each row.)
# `checklist_corpus_matches_both_engines` in
# crates/orchestraitor-mcp/src/pr_status.rs carries the same constant; keep the
# two in step.
CORPUS_FLOOR=84
declare -A CORPUS_COUNT=() CORPUS_ALL=() CORPUS_UNPARSEABLE=() CORPUS_CONSTRUCT=()
while IFS=$'\t' read -r row_case row_count row_all row_unparseable row_construct; do
  case "$row_case" in
    ''|'#'*) continue ;;
  esac
  CORPUS_COUNT["$row_case"]="$row_count"
  CORPUS_ALL["$row_case"]="$row_all"
  CORPUS_UNPARSEABLE["$row_case"]="${row_unparseable:-false}"
  CORPUS_CONSTRUCT["$row_case"]="$row_construct"
done < "$CORPUS_TSV"
CORPUS_CASES=0
for corpus_body in "$CORPUS_DIR"/*.md; do
  corpus_slug="$(basename "$corpus_body" .md)"
  # A case file with NO row is a deleted contract: fail it, never skip it.
  if [ -z "${CORPUS_COUNT[$corpus_slug]+set}" ]; then
    assert "f5: $corpus_slug has an expectations.tsv row" "a row" "none"
    continue
  fi
  export BODY_FIXTURE="$corpus_body"
  run reconcile-checklist 7 --repo test-org/repo --json
  assert "f5: $corpus_slug marker_count" "${CORPUS_COUNT[$corpus_slug]}" \
    "$(jq -r .marker_count <<<"$OUT")"
  assert "f5: $corpus_slug all_checked" "${CORPUS_ALL[$corpus_slug]}" \
    "$(jq -r .all_checked <<<"$OUT")"
  assert "f5: $corpus_slug unparseable" "${CORPUS_UNPARSEABLE[$corpus_slug]}" \
    "$(jq -r .unparseable <<<"$OUT")"
  if [ -n "${CORPUS_CONSTRUCT[$corpus_slug]}" ]; then
    assert "f5: $corpus_slug unparseable_construct" "${CORPUS_CONSTRUCT[$corpus_slug]}" \
      "$(jq -r .unparseable_construct <<<"$OUT")"
  fi
  CORPUS_CASES=$((CORPUS_CASES+1))
done
# A ROW with no case file is the other half of "a deleted case must fail".
for corpus_slug in "${!CORPUS_COUNT[@]}"; do
  if [ ! -f "$CORPUS_DIR/$corpus_slug.md" ]; then
    assert "f5: $corpus_slug row has a case file" "$CORPUS_DIR/$corpus_slug.md" "missing"
  fi
done
# Exact, not `-ge`: a deleted case must FAIL instead of silently narrowing the
# contract (the same reasoning as the self-test discovery floor in skills.yml).
assert "f5: the corpus carries exactly $CORPUS_FLOOR cases" "$CORPUS_FLOOR" \
  "$CORPUS_CASES"

# --- (f6) the fence scanner is indentation- and info-string-correct ------------
# arbsec/orchestraitor#799 F16 (generation-4 review): CommonMark allows at most
# THREE spaces before a top-level fence, so a 4-space-indented run is literal
# text. Before the fix the closer below closed the region and EXPOSED the
# checked marker GitHub renders INSIDE the fence: `all_checked: true` for
# evidence a human cannot see.
F16_CLOSER="$(cat "$CORPUS_DIR/17-four-space-run-does-not-close-the-fence.md")"
export BODY_FIXTURE="$CORPUS_DIR/17-four-space-run-does-not-close-the-fence.md"
run reconcile-checklist 7 --repo test-org/repo --json
assert 'f6: a 4-space-indented closer does not close the region' 0 \
  "$(jq -r .marker_count <<<"$OUT")"
assert 'f6: and its enclosed checked marker is not evidence' false \
  "$(jq -r .all_checked <<<"$OUT")"
assert 'f6: the guard appends the checklist (the body carries none)' 9 \
  "$(grep -c -- '- \[ \] <!-- orc:' <<<"$(ensure "$F16_CLOSER" "$TMP/repo")")"
# A 1-3-space-indented OPENER is INDETERMINATE scope (#809): it may belong to a
# list item or a block quote, and the scanner has no container model. The
# condition is STICKY — a closer does NOT clear it — because a closer can end
# the region EARLIER for the renderer than for this scanner, so a marker the
# scanner swallows can still be visible to a human. Both fixtures below are
# therefore `unparseable: true` / `all_checked: false`, and both block.
# CLOSED opener: 3-space opener + 3-space closer, the marker inside hidden.
printf '   ```\n- [x] <!-- orc:tests --> example only\n   ```\n' \
  > "$TMP/files/f16-three-space-closed.md"
export BODY_FIXTURE="$TMP/files/f16-three-space-closed.md"
run reconcile-checklist 7 --repo test-org/repo --json
assert 'f6: three-space fences still hide their marker' 0 \
  "$(jq -r .marker_count <<<"$OUT")"
assert 'f6: a CLOSED 3-space opener is still indeterminate (#809)' true \
  "$(jq -r .unparseable <<<"$OUT")"
assert 'f6: and it names the opener line (#809)' 1 \
  "$(jq -r .unparseable_line <<<"$OUT")"
assert 'f6: and a closed indeterminate scan is never "all checked" (#809)' false \
  "$(jq -r .all_checked <<<"$OUT")"
run convergence-status 7 --repo test-org/repo --json
assert 'f6: so the gate BLOCKS the closed-opener body (#809)' 5 "$RC"
assert 'f6: with the distinct indeterminate reason (#809)' '["checklist_unparseable"]' \
  "$(jq -c .reasons <<<"$OUT")"
# RE-DERIVED (arbsec/orchestraitor#799 R14): the guard no longer APPENDS to a
# body whose reading the engine refuses. A closed 3-space opener is
# `indented_fence_opener` (sticky), so `ensure` now refuses it (exit 2) instead
# of composing a PR that `reconcile-checklist` refuses on the next read — the
# exact drift this round closes. The remedy it names is the opener's dedent.
rm -f "$TMP/stderr"
ensure "$(cat "$TMP/files/f16-three-space-closed.md")" "$TMP/repo" >/dev/null 2>"$TMP/stderr"; RC=$?
assert 'f6: the guard REFUSES a closed 3-space opener (#799 R14)' 2 "$RC"
assert 'f6: naming the fence construct' 1 \
  "$(grep -cF 'opens a fenced code block indented 1-3 spaces on line 1' "$TMP/stderr")"
assert 'f6: and the dedent remedy' 1 \
  "$(grep -cF 'dedent the fence opener to column 0' "$TMP/stderr")"
assert 'f6: and appends nothing' 0 "$(grep -c -- '- \[ \] <!-- orc:' "$TMP/stderr")"

# UNCLOSED opener: the same 3-space opener with no closer at all.
printf '   ```\n- [x] <!-- orc:tests --> example only\n' \
  > "$TMP/files/f16-three-space-unclosed.md"
export BODY_FIXTURE="$TMP/files/f16-three-space-unclosed.md"
run reconcile-checklist 7 --repo test-org/repo --json
assert 'f6: an UNCLOSED 3-space opener is indeterminate (#809)' true \
  "$(jq -r .unparseable <<<"$OUT")"
assert 'f6: and it names the opener line (#809)' 1 \
  "$(jq -r .unparseable_line <<<"$OUT")"
assert 'f6: and it is never "all checked" (#809)' false \
  "$(jq -r .all_checked <<<"$OUT")"
# The swallowed-but-VISIBLE shape the sticky rule exists for: CommonMark ends
# the fence at the end of the list item, so the unticked marker below is
# visible in the rendered PR while this scanner's region runs on to the final
# closer. A "closing clears the condition" rule would report one ticked marker
# and no unticked one — a false pass.
printf -- '- [x] <!-- orc:issue --> linked\n- Example:\n  ```\n  sample\n- [ ] <!-- orc:tests --> not tested\n  ```\n' \
  > "$TMP/files/f16-swallowed-visible-item.md"
export BODY_FIXTURE="$TMP/files/f16-swallowed-visible-item.md"
run reconcile-checklist 7 --repo test-org/repo --json
assert 'f6: a closed 2-space opener swallows the visible item' 1 \
  "$(jq -r .marker_count <<<"$OUT")"
assert 'f6: but the scan is refused, not read (#809)' true \
  "$(jq -r .unparseable <<<"$OUT")"
assert 'f6: so the swallowed visible item can never become a pass (#809)' false \
  "$(jq -r .all_checked <<<"$OUT")"
run convergence-status 7 --repo test-org/repo --json
assert 'f6: and the gate blocks that body too (#809)' 5 "$RC"
assert 'f6: on the distinct indeterminate reason (#809)' '["checklist_unparseable"]' \
  "$(jq -c .reasons <<<"$OUT")"

# arbsec/orchestraitor#799 F17 (generation-4 CodeRabbit): a backtick fence's
# info string may not contain a backtick, so ```example``` is a CLOSED inline
# code span — never an opener. Before the fix it opened an unclosed fence and
# the unclosed-fence guard REFUSED this legitimate body with exit 2 (#683 class)
# from both pr-create and pr-mutate.
F17_BODY="$(cat "$CORPUS_DIR/20-inline-closed-span-is-not-an-opener.md")"
F17_ENSURED="$(ensure "$F17_BODY" "$TMP/repo" 2>"$TMP/stderr")"; RC=$?
assert 'f6: a ```example``` span is not an opener (no refusal)' 0 "$RC"
assert 'f6: and the real marker survives untouched' 1 \
  "$(grep -c 'orc:tests' <<<"$F17_ENSURED")"
cp "$CORPUS_DIR/20-inline-closed-span-is-not-an-opener.md" "$TMP/files/f17-inline-span.md"
rm -f "$TMP/edited-body.md"
run pr-mutate edit 7 --repo test-org/repo --body-file "$TMP/files/f17-inline-span.md"
assert 'f6: pr-mutate does not refuse a closed ```example``` span' 0 "$RC"
assert 'f6: pr-mutate sets the body with its marker intact' 1 \
  "$(grep -c 'orc:tests' "$TMP/edited-body.md")"
OUT="$(dry_run --title t --body-file "$TMP/files/f17-inline-span.md" 2>&1)"; RC=$?
assert 'f6: pr-create does not refuse a closed ```example``` span' 0 "$RC"
assert 'f6: pr-create keeps the real marker' 1 "$(grep -c 'orc:tests' <<<"$OUT")"
# A TILDE fence MAY carry backticks in its info string (GFM), so the same
# backtick stays INSIDE the region: the marker below is not evidence.
printf '~~~text `tick`\n- [x] <!-- orc:tests --> inside the tilde fence\n~~~\n' \
  > "$TMP/files/f17-tilde-info.md"
export BODY_FIXTURE="$TMP/files/f17-tilde-info.md"
run reconcile-checklist 7 --repo test-org/repo --json
assert 'f6: tilde info strings may carry backticks' 0 \
  "$(jq -r .marker_count <<<"$OUT")"
export BODY_FIXTURE="$TMP/files/no-markers.md"

# A form feed is not leading INDENTATION either: it is content, so a
# form-feed-led fence line opens nothing (the same rule corpus case 38 pins for
# a vertical tab). CommonMark allows 0-3 SPACES before a fence and nothing else.
printf '\f```\n- [x] <!-- orc:tests --> ff-led fence line opened nothing\n' \
  > "$TMP/files/f6-ff-led-opener.md"
export BODY_FIXTURE="$TMP/files/f6-ff-led-opener.md"
run reconcile-checklist 7 --repo test-org/repo --json
assert 'f6: a form-feed-led fence line opens nothing' 1 \
  "$(jq -r .marker_count <<<"$OUT")"
assert 'f6: and its marker is real evidence' true "$(jq -r .all_checked <<<"$OUT")"

# The CLOSING-tail boundary table, pinned in BOTH engines (the Rust twin is
# `a_form_feed_is_neither_fence_indentation_nor_a_closing_tail`). CommonMark 0.31
# allows only spaces and tabs after the closing run, plus the carriage return of
# a CRLF line terminator, which is not content. Everything else — form feed,
# vertical tab — is CONTENT and leaves the region OPEN.
for tail_case in none spaces tab crlf ff vt; do
  case "$tail_case" in
    none)   tail='' ;;
    spaces) tail='   ' ;;
    tab)    tail=$'\t' ;;
    crlf)   tail=$'\r' ;;
    ff)     tail=$'\f' ;;
    vt)     tail=$'\v' ;;
  esac
  printf '```\n- [x] <!-- orc:issue --> example only\n```%s\n- [x] <!-- orc:tests --> real item\n' \
    "$tail" > "$TMP/files/f6-tail-$tail_case.md"
  export BODY_FIXTURE="$TMP/files/f6-tail-$tail_case.md"
  run reconcile-checklist 7 --repo test-org/repo --json
  case "$tail_case" in
    ff|vt) want=0 ;;  # content: the closer does not close, the marker is code
    *)     want=1 ;;  # ignored tail: the region closes, the marker is evidence
  esac
  assert "f6: closer tail '$tail_case' -> marker_count $want" "$want" \
    "$(jq -r .marker_count <<<"$OUT")"
done
export BODY_FIXTURE="$TMP/files/no-markers.md"

# --- (f7) a line-start `<` is REFUSED, and an indented fence is refused --------
# arbsec/orchestraitor#809 (the container gap) and arbsec/orchestraitor#799 R1
# (the HTML rule). HTML is NOT MODELLED: three consecutive rounds tried to
# implement CommonMark's HTML-block rules exactly and each produced a new set of
# grammar defects, two of them FALSE PASSES. A merge gate must not depend on a
# hand-rolled Markdown parser being spec-exact, so the scanner applies the repo's
# rule for a construct it cannot model — refuse and block:
#
#   A line its FIRST non-whitespace character is `<`, indented 0-3 spaces and
#   outside every fenced code region, makes the reading INDETERMINATE
#   (`unparseable: true`, `unparseable_construct: html_construct`) and every
#   verdict BLOCKS with `checklist_unparseable`.
#
# The boundaries are pinned here: 4+ spaces (or a leading tab) is literal
# indented code and hides nothing; a line inside a fenced region is inert; a
# `<` that is not the line's first content is ordinary text.
#
# The fence half: a fence OPENED with 1-3 leading spaces may belong to a list
# item or a block quote, and the scanner has no container model. That scope is
# INDETERMINATE, so the verdict REFUSES it with `checklist_unparseable` instead
# of guessing (#809 stays open for real container tracking).
nine_ticked_plus() { # nine_ticked_plus <extra-line> -> the nine ticked markers + one line
  local extra="$1" name
  for name in issue service-identity tests security docs rollback checks review threads; do
    printf -- '- [x] <!-- orc:%s --> linked\n' "$name"
  done
  printf '%s\n' "$extra"
}
# The reported shape: nine canonical ticked markers, then a complete one-line
# `<pre></pre>`, then a VISIBLE unchecked item. Before the refusal the body was
# read as nine ticked markers plus one unticked (which blocked on the count, and
# on `<pre></pre>`-style bodies the OLD model could hide the item entirely).
nine_ticked_plus '<pre></pre>
- [ ] <!-- orc:security --> visible unchecked' > "$TMP/files/r1-html-nine.md"
export BODY_FIXTURE="$TMP/files/r1-html-nine.md"
run reconcile-checklist 7 --repo test-org/repo --json
assert 'f7: a line-start <pre></pre> makes the reading indeterminate' true \
  "$(jq -r .unparseable <<<"$OUT")"
assert 'f7: and it names the construct html_construct' 'html_construct' \
  "$(jq -r .unparseable_construct <<<"$OUT")"
assert 'f7: and the line number' 10 "$(jq -r .unparseable_line <<<"$OUT")"
assert 'f7: and it is never all checked' false "$(jq -r .all_checked <<<"$OUT")"
run convergence-status 7 --repo test-org/repo --json
assert 'f7: so the gate BLOCKS the body' 5 "$RC"
assert 'f7: with the distinct unparseable reason' '["checklist_unparseable"]' \
  "$(jq -c .reasons <<<"$OUT")"
assert 'f7: and the telemetry carries it' true "$(jq -r .checklist_unparseable <<<"$OUT")"
assert 'f7: and it names the line' 10 "$(jq -r .checklist_unparseable_line <<<"$OUT")"
rm -f "$TMP/merge-argv.txt"
run merge-gate 7 --repo test-org/repo
assert 'f7: merge-gate refuses it' 5 "$RC"
assert 'f7: and it NEVER invokes gh pr merge' 0 "$(exists "$TMP/merge-argv.txt")"
run convergence-status 7 --repo test-org/repo
assert 'f7: text mode names the raw HTML construct' 1 \
  "$(grep -cF "contains a raw HTML construct at line 10" <<<"$OUT")"
assert 'f7: and offers only remedies that work' 1 \
  "$(grep -cF 'put it inside a fenced code block, indent it by 4 spaces, or remove it' <<<"$OUT")"
# Every construct shape from the R1 probe list is the SAME refusal: the scanner
# does not try to tell a comment from a tag from an autolink.
for html_probe in '<pre></pre>' '<!-->' '<!--->' '<https://example.com>' \
  '<em>emphasis</em> prose' '<notatag nonsense' '<span>' '<span//>' '<div>' \
  '</div>' '<?xml' '<![CDATA[' '   <div>'; do
  nine_ticked_plus "$html_probe
- [ ] <!-- orc:security --> visible unchecked" > "$TMP/files/r1-probe.md"
  export BODY_FIXTURE="$TMP/files/r1-probe.md"
  run reconcile-checklist 7 --repo test-org/repo --json
  assert "f7: '$html_probe' refuses the reading" true \
    "$(jq -r .unparseable <<<"$OUT")"
  assert "f7: '$html_probe' names html_construct" 'html_construct' \
    "$(jq -r .unparseable_construct <<<"$OUT")"
  assert "f7: '$html_probe' names its line" 10 "$(jq -r .unparseable_line <<<"$OUT")"
  assert "f7: '$html_probe' is never all checked" false \
    "$(jq -r .all_checked <<<"$OUT")"
  run convergence-status 7 --repo test-org/repo --json
  assert "f7: '$html_probe' blocks the gate" 5 "$RC"
  assert "f7: '$html_probe' blocks on the refusal" '["checklist_unparseable"]' \
    "$(jq -c .reasons <<<"$OUT")"
done
# The three boundaries that are NOT refusals.
printf -- '- [x] <!-- orc:issue --> linked\n\n```markdown\n<!--\n```\n\n- [ ] <!-- orc:tests --> not tested\n' \
  > "$TMP/files/r1-fenced-html.md"
export BODY_FIXTURE="$TMP/files/r1-fenced-html.md"
run reconcile-checklist 7 --repo test-org/repo --json
assert 'f7: a `<!--` line inside a fenced region is inert' false \
  "$(jq -r .unparseable <<<"$OUT")"
assert 'f7: and the visible unchecked item still counts' 1 \
  "$(jq -r '.unchecked | length' <<<"$OUT")"
printf -- '    <div>\n' > "$TMP/files/r1-indented-html.md"
for name in issue service-identity tests security docs rollback checks review threads; do
  printf -- '- [x] <!-- orc:%s --> linked\n' "$name" >> "$TMP/files/r1-indented-html.md"
done
export BODY_FIXTURE="$TMP/files/r1-indented-html.md"
run reconcile-checklist 7 --repo test-org/repo --json
assert 'f7: a 4-space-indented <div> is literal text' false \
  "$(jq -r .unparseable <<<"$OUT")"
assert 'f7: and the nine markers are counted normally' 9 \
  "$(jq -r .marker_count <<<"$OUT")"
assert 'f7: and they read as all checked' true "$(jq -r .all_checked <<<"$OUT")"
printf -- '- [x] <!-- orc:issue --> linked\nx < y\n- [x] <!-- orc:tests --> tested\n' \
  > "$TMP/files/r1-midline.md"
export BODY_FIXTURE="$TMP/files/r1-midline.md"
run reconcile-checklist 7 --repo test-org/repo --json
assert 'f7: a mid-line < is ordinary text' false "$(jq -r .unparseable <<<"$OUT")"
assert 'f7: and both markers count' 2 "$(jq -r .marker_count <<<"$OUT")"

# A fence OPENED with 1-3 leading spaces is INDETERMINATE scope (#809): an
# indented opener can sit inside a list item or a block quote, and the scanner
# has no container model. The condition is STICKY — a closer does NOT clear it.
cat > "$TMP/files/list-item-fence.md" <<'EOF'
- [x] <!-- orc:issue --> linked
- Example:
  ```
  sample

- [ ] <!-- orc:tests --> not tested
EOF
export BODY_FIXTURE="$TMP/files/list-item-fence.md"
run reconcile-checklist 7 --repo test-org/repo --json
assert 'f7: a 2-space-indented opener is indeterminate scope (#809)' true \
  "$(jq -r .unparseable <<<"$OUT")"
assert 'f7: and it names the opener line (#809)' 3 \
  "$(jq -r .unparseable_line <<<"$OUT")"
assert 'f7: and names indented_fence_opener, NOT html_construct' \
  'indented_fence_opener' "$(jq -r .unparseable_construct <<<"$OUT")"
assert 'f7: an indeterminate scan is never "all checked" (#809)' false \
  "$(jq -r .all_checked <<<"$OUT")"
run convergence-status 7 --repo test-org/repo --json
assert 'f7: so the gate BLOCKS it (#809)' 5 "$RC"
assert 'f7: with the distinct indeterminate reason (#809)' '["checklist_unparseable"]' \
  "$(jq -c .reasons <<<"$OUT")"
assert 'f7: and the JSON telemetry carries it (#809)' true \
  "$(jq -r .checklist_unparseable <<<"$OUT")"
run convergence-status 7 --repo test-org/repo
assert 'f7: text mode names the fence construct and the fix (#809)' 1 \
  "$(grep -cF 'dedent the fence opener to column 0' <<<"$OUT")"
assert 'f7: and does NOT call an indented fence an HTML construct' 0 \
  "$(grep -cF 'raw HTML construct' <<<"$OUT")"
# Every message names only a remedy that WORKS. "or close it" was a lie while
# the condition was derived from the opener alone; it stays a lie under the
# STICKY rule (closing never clears the condition), so no message may offer it.
assert 'f7: no message offers the ineffective "or close it" (#809)' 0 \
  "$(grep -cF 'or close it' <<<"$OUT")"
export BODY_FIXTURE="$TMP/files/no-markers.md"

# --- (f8) the CANONICAL marker form and the NEAR-MARKER rule ------------------
# arbsec/orchestraitor#799 R1: a managed marker has ONE canonical form, and a
# line that presents itself as one but is NOT canonical is INDETERMINATE — the
# gate cannot tell what the author asserted, so it refuses the reading instead
# of guessing.
#
# The canonical form: `[ \t]*- [BOX] <!-- orc:NAME -->` where every separator is
# EXACTLY one ASCII space, `<BOX>` is `x`, `X` or a single space, and `<NAME>`
# is one of the nine managed names.
#
# The near-marker rule: a line that is NOT canonical but carries BOTH a
# task-item box token (`[` + exactly one character + `]`) AND a reference to
# one of the nine managed names (`orc:NAME`) is REFUSED.
NBSP="$(printf '\302\240')"
EMSPACE="$(printf '\342\200\203')"
NNBSP="$(printf '\342\200\257')"
TABCHAR="$(printf '\011')"
nine_canonical() { # nine_canonical <extra-line> -> the nine ticked markers + one line
  local extra="$1" name
  for name in issue service-identity tests security docs rollback checks review threads; do
    printf -- '- [x] <!-- orc:%s --> linked\n' "$name"
  done
  printf '%s\n' "$extra"
}
# The canonical form is counted, ticked, and never indeterminate.
printf -- '- [x] <!-- orc:issue --> x\n' > "$TMP/files/canon-ticked.md"
export BODY_FIXTURE="$TMP/files/canon-ticked.md"
run reconcile-checklist 7 --repo test-org/repo --json
assert 'f8: a canonical marker is counted' 1 "$(jq -r .marker_count <<<"$OUT")"
assert 'f8: and it is ticked' true "$(jq -r '.items[0].checked' <<<"$OUT")"
assert 'f8: and the body is determinate' false "$(jq -r .unparseable <<<"$OUT")"
# Every near-marker form is REFUSED — the same verdict in both engines.
for near_form in nbsp-after-box emspace-after-box nnbsp-after-box \
  nbsp-after-comment nbsp-before-closer tab-after-box two-spaces-after-box \
  box-char-y blockquote; do
  case "$near_form" in
    nbsp-after-box)       extra="- [ ]${NBSP}<!-- orc:security --> visible unchecked" ;;
    emspace-after-box)    extra="- [ ]${EMSPACE}<!-- orc:security --> visible unchecked" ;;
    nnbsp-after-box)      extra="- [ ]${NNBSP}<!-- orc:security --> visible unchecked" ;;
    nbsp-after-comment)   extra="- [ ] <!--${NBSP}orc:security --> visible unchecked" ;;
    nbsp-before-closer)   extra="- [ ] <!-- orc:security${NBSP}--> visible unchecked" ;;
    tab-after-box)        extra="- [ ]${TABCHAR}<!-- orc:tests --> visible unchecked" ;;
    two-spaces-after-box) extra="- [ ]  <!-- orc:tests --> visible unchecked" ;;
    box-char-y)           extra="- [y] <!-- orc:tests --> a nonsense box" ;;
    blockquote)           extra="> - [ ] <!-- orc:tests --> quoted task" ;;
  esac
  nine_canonical "$extra" > "$TMP/files/near-$near_form.md"
  export BODY_FIXTURE="$TMP/files/near-$near_form.md"
  run reconcile-checklist 7 --repo test-org/repo --json
  assert "f8: $near_form is indeterminate" true "$(jq -r .unparseable <<<"$OUT")"
  assert "f8: $near_form names the construct" 'near_marker' \
    "$(jq -r .unparseable_construct <<<"$OUT")"
  assert "f8: $near_form is never all checked" false "$(jq -r .all_checked <<<"$OUT")"
  assert "f8: $near_form counts only the canonical markers" 9 \
    "$(jq -r .marker_count <<<"$OUT")"
  run convergence-status 7 --repo test-org/repo --json
  assert "f8: $near_form blocks the gate" 5 "$RC"
  assert "f8: $near_form blocks with the indeterminate reason" \
    '["checklist_unparseable"]' "$(jq -c .reasons <<<"$OUT")"
done
# PROSE that mentions a managed name (no box token) is never a near-marker.
printf '%s\n' \
  'The managed markers look like `<!-- orc:issue -->` and name one of the nine items.' \
  '- [x] <!-- orc:tests --> a real, canonical marker' > "$TMP/files/prose-mention.md"
export BODY_FIXTURE="$TMP/files/prose-mention.md"
run reconcile-checklist 7 --repo test-org/repo --json
assert 'f8: prose is not a marker' 1 "$(jq -r .marker_count <<<"$OUT")"
assert 'f8: prose is not indeterminate' false "$(jq -r .unparseable <<<"$OUT")"
assert 'f8: prose does not block' true "$(jq -r .all_checked <<<"$OUT")"
# A PLAIN TASK (a box token, no managed name) is never a near-marker either.
printf '%s\n' '- [ ] plain task' \
  '- [x] <!-- orc:tests --> a real, canonical marker' > "$TMP/files/plain-task.md"
export BODY_FIXTURE="$TMP/files/plain-task.md"
run reconcile-checklist 7 --repo test-org/repo --json
assert 'f8: a plain task is not a marker' 1 "$(jq -r .marker_count <<<"$OUT")"
assert 'f8: a plain task is not indeterminate' false "$(jq -r .unparseable <<<"$OUT")"
assert 'f8: a plain task does not block' true "$(jq -r .all_checked <<<"$OUT")"
# NO opt-out: a bare `<!-- orc:none -->` grants nothing — `none` is not one of
# the nine managed names, so it is neither a canonical marker nor a
# near-marker, and a body that carries only it has NO checklist evidence.
# RE-DERIVED (#799 R1): on its own line it is also a raw HTML construct, so the
# reading is REFUSED (`html_construct`) — still no evidence, and never a waiver.
printf '%s\n' '<!-- orc:none -->' > "$TMP/files/sentinel-only.md"
export BODY_FIXTURE="$TMP/files/sentinel-only.md"
run reconcile-checklist 7 --repo test-org/repo --json
assert 'f8: a bare sentinel is not a marker' 0 "$(jq -r .marker_count <<<"$OUT")"
assert 'f8: a bare sentinel is not a near-marker' 'html_construct' \
  "$(jq -r .unparseable_construct <<<"$OUT")"
run convergence-status 7 --repo test-org/repo --json
assert 'f8: a bare sentinel still blocks' 5 "$RC"
assert 'f8: with the unparseable reason' '["checklist_unparseable"]' \
  "$(jq -c .reasons <<<"$OUT")"
# A sentinel WITH a box token is still not a managed marker (`none` is not one
# of the nine names) and grants nothing.
printf '%s\n' '- [x] <!-- orc:none -->' > "$TMP/files/sentinel-box.md"
export BODY_FIXTURE="$TMP/files/sentinel-box.md"
run reconcile-checklist 7 --repo test-org/repo --json
assert 'f8: a sentinel with a box token is not a marker' 0 \
  "$(jq -r .marker_count <<<"$OUT")"
assert 'f8: a sentinel with a box token is not a near-marker' false \
  "$(jq -r .unparseable <<<"$OUT")"

# --- (f8b) the HTML refusal names its own construct and remedy ------------------
# arbsec/orchestraitor#799 R1: the message must name WHAT was refused and offer
# only remedies that work. A previous round's diagnostic called an indented HTML
# opener a FENCE, which sent the author to a fix that does not apply.
export BODY_FIXTURE="$TMP/files/r1-html-nine.md"
run reconcile-checklist 7 --repo test-org/repo
assert 'f8b: text mode names the raw HTML construct' 1 \
  "$(grep -cF "contains a raw HTML construct at line 10" <<<"$OUT")"
assert 'f8b: and never calls it a fence' 0 \
  "$(grep -cF 'opens a fenced code block indented' <<<"$OUT")"
assert 'f8b: and offers the three remedies that work' 1 \
  "$(grep -cF 'put it inside a fenced code block, indent it by 4 spaces, or remove it' <<<"$OUT")"

# The gate-level outcome the merge path consumes: `merge-gate` must stop at the
# blocked verdict and never construct a `gh pr merge` call.
export BODY_FIXTURE="$TMP/files/r1-html-nine.md"
rm -f "$TMP/merge-argv.txt"
run merge-gate 7 --repo test-org/repo
assert 'f8b: merge-gate refuses the HTML body' 5 "$RC"
assert 'f8b: naming the checklist refusal' 1 \
  "$(grep -cF 'checklist_unparseable' "$TMP/stderr")"
assert 'f8b: and it NEVER invokes gh pr merge' 0 "$(exists "$TMP/merge-argv.txt")"

# --- (f8c) the DESCRIPTION field is the text after the delimiter ----------------
# arbsec/orchestraitor#799 R2: `reconcile-checklist --json` emitted the BOX
# character (`"x"` / `""`) because its sed emitted capture group 1 instead of
# group 2, while the Rust engine returned the text — a cross-engine divergence
# in a field `pr status` publishes.
export BODY_FIXTURE="$CORPUS_DIR/74-description-text.md"
run reconcile-checklist 7 --repo test-org/repo --json
assert 'f8c: a CHECKED item description is the text after the delimiter' 'alpha' \
  "$(jq -r '.items[0].description' <<<"$OUT")"
assert 'f8c: an UNCHECKED item description is the text after the delimiter' 'beta' \
  "$(jq -r '.items[1].description' <<<"$OUT")"
assert 'f8c: the marker ids are unchanged by the fix' 'issue,tests' \
  "$(jq -r '[.items[].marker] | join(",")' <<<"$OUT")"
assert 'f8c: the box characters are unchanged by the fix' 'true,false' \
  "$(jq -r '[.items[].checked] | join(",")' <<<"$OUT")"
run reconcile-checklist 7 --repo test-org/repo
assert 'f8c: and the text form prints the description, checked' 1 \
  "$(grep -cF '[x] issue: alpha' <<<"$OUT")"
assert 'f8c: and the text form prints the description, unchecked' 1 \
  "$(grep -cF '[ ] tests: beta' <<<"$OUT")"
export BODY_FIXTURE="$TMP/files/no-markers.md"

# --- (f8d) the creation lane REFUSES a body it cannot make converge ------------
# arbsec/orchestraitor#799 R1: with HTML unmodelled, a body carrying a line-start
# `<` can NEVER be read — appending the checklist would compose a PR that blocks
# forever with nothing the author can tick. Both creation routes refuse it
# instead (exit 2), naming the line and the three remedies that work.
for html_body in '<div>' '<div>a block</div>' '  <div>' '<pre>' '<!--' '<?xml' \
  '<![CDATA[' '<https://example.com>'; do
  rm -f "$TMP/stderr"
  ensure "$html_body" "$TMP/repo" >/dev/null 2>"$TMP/stderr"
  RC=$?
  assert "f8d: '$html_body' is refused at creation" 2 "$RC"
  assert "f8d: '$html_body' names line 1" 1 \
    "$(grep -cF 'raw HTML construct at line 1' "$TMP/stderr")"
  assert "f8d: '$html_body' offers the remedies that work" 1 \
    "$(grep -cF 'put it inside a fenced code block, indent it by 4 spaces, or remove it' "$TMP/stderr")"
  assert "f8d: '$html_body' invents no closing tag" 0 \
    "$(grep -cF 'add a line carrying' "$TMP/stderr")"
done
# The controls: a 4-space-indented construct and a mid-line `<` are literal text,
# so creation proceeds normally and the appended checklist is real evidence.
for literal_body in '    <div>' 'x < y' '```'$'\n''<div>'$'\n''```'; do
  literal_ensured="$(ensure "$literal_body" "$TMP/repo" 2>"$TMP/stderr")"
  RC=$?
  assert "f8d: '$literal_body' is not refused" 0 "$RC"
  assert "f8d: '$literal_body' gains the nine markers" 9 \
    "$(grep -c -- '- \[ \] <!-- orc:' <<<"$literal_ensured")"
done
export BODY_FIXTURE="$TMP/files/no-markers.md"

# --- (g) the fallback cannot drift from the template ---------------------------
TEMPLATE_MARKERS="$(grep -oP '^\s*-\s*\[[ xX]\]\s*<!--\s*orc:[A-Za-z0-9_-]+\s*-->.*$' \
  "$ROOT/.github/PULL_REQUEST_TEMPLATE.md" \
  | sed -E 's/^([[:space:]]*)-[[:space:]]*\[[ xX]\]/\1- [ ]/')"
FALLBACK="$(bash -c 'source "$1"; printf "%s\n" "$ORC_LIB_CHECKLIST_FALLBACK"' _ \
  "$SCRIPT_DIR/_lib.sh")"
assert 'g: the template carries nine managed markers' 9 \
  "$(printf '%s\n' "$TEMPLATE_MARKERS" | grep -c '<!-- orc:')"
assert 'g: the _lib.sh fallback equals the template verbatim' \
  "$TEMPLATE_MARKERS" "$FALLBACK"
assert 'g: the fallback lands every box unchecked' 0 \
  "$(printf '%s\n' "$FALLBACK" | grep -c '^- \[x\]')"

ENSURED="$(ensure 'wholesale body' "$TMP/repo")"
assert 'g: a wholesale body gains the nine markers' 9 \
  "$(grep -c '<!-- orc:' <<<"$ENSURED")"
assert 'g: injection lands them UNCHECKED' 0 "$(grep -c '^- \[x\]' <<<"$ENSURED")"
assert 'g: injection keeps the author body first' 1 \
  "$(head -1 <<<"$ENSURED" | grep -cF 'wholesale body')"
assert 'g: a body with a marker is returned verbatim' 'own body
- [x] <!-- orc:issue --> linked' "$(ensure 'own body
- [x] <!-- orc:issue --> linked' "$TMP/repo")"
# A body sentinel is NOT checklist-bearing: the checklist is appended. It must
# be MID-LINE: a line-start `<` is a raw HTML construct that creation refuses
# (#799 R1, pinned in (f8d)), because no append could make such a body readable.
SENTINEL_ENSURED="$(ensure 'sentinel
note: <!-- orc:none --> custom body' "$TMP/repo")"
assert 'g: a sentinel body is not checklist-bearing' 9 \
  "$(grep -c -- '- \[ \] <!-- orc:' <<<"$SENTINEL_ENSURED")"
assert 'g: a sentinel body keeps its own text' 1 \
  "$(grep -cF 'note: <!-- orc:none --> custom body' <<<"$SENTINEL_ENSURED")"
# A body whose only marker sits inside a fenced code region is NOT
# checklist-bearing either: creation must still hand it the real checklist, or
# the fail-closed gate could never be satisfied (#683 class).
FENCED_ENSURED="$(ensure "$(cat "$TMP/files/fenced-marker.md")" "$TMP/repo")"
assert 'g: a fenced-only body is not checklist-bearing' 9 \
  "$(grep -c -- '- \[ \] <!-- orc:' <<<"$FENCED_ENSURED")"
assert 'g: a fenced-only body keeps its own text' 1 \
  "$(grep -cF 'example only' <<<"$FENCED_ENSURED")"

# --- (h) creation stays satisfiable: pr-create injects -------------------------
# SKILL_CASE=1 skips the pre-PR review gate (its own suite covers it); the
# dry-run stops before any gh call, so only the constructed argv is asserted.
OUT="$(dry_run --title t --body 'wholesale body')"
assert 'h: --body gains the nine markers' 9 "$(grep -c '<!-- orc:' <<<"$OUT")"
assert 'h: injected markers are unchecked' 0 "$(grep -c -- '- \[x\]' <<<"$OUT")"
assert 'h: the author body survives' 1 "$(grep -cF 'wholesale body' <<<"$OUT")"
OUT="$(dry_run --title t --body "Some \`orc:\` prose, no marker")"
assert 'h: a prose mention is not a checklist (injection still fires)' 9 \
  "$(grep -c '<!-- orc:' <<<"$OUT")"

OUT="$(dry_run --title t --body-file "$TMP/files/no-markers.md")"
assert 'h: --body-file gains the nine markers' 9 \
  "$(grep -c -- '- \[ \] <!-- orc:' <<<"$OUT")"
assert 'h: --body-file content survives' 1 "$(grep -cF 'false quantitative claim' <<<"$OUT")"
assert 'h: --body-file is resolved (no --body-file reaches gh)' 0 \
  "$(grep -c -- '--body-file' <<<"$OUT")"

# `--body-file -` reads the body from STDIN (gh's own convention, preserved
# explicitly rather than rejected).
OUT="$(printf '%s\n' 'wholesale stdin body' | dry_run --title t --body-file -)"
assert 'h: --body-file - gains the nine markers' 9 \
  "$(grep -c -- '- \[ \] <!-- orc:' <<<"$OUT")"
assert 'h: --body-file - content survives' 1 "$(grep -cF 'wholesale stdin body' <<<"$OUT")"
assert 'h: --body-file - never reaches gh as a flag' 0 \
  "$(grep -c -- '--body-file' <<<"$OUT")"
OUT="$(printf '' | dry_run --title t --body-file - 2>&1)"; RC=$?
assert 'h: an empty STDIN body is refused' 2 "$RC"

OUT="$(dry_run --title t --body-file "$TMP/files/own-marker.md")"
assert 'h: a body with its own marker is left verbatim' 1 "$(grep -c '<!-- orc:' <<<"$OUT")"
assert 'h: verbatim means no injected section' 0 "$(grep -cF 'Added by pr-create' <<<"$OUT")"

# A body sentinel is not an opt-out: the checklist is still injected. The
# readable shape is a MID-LINE sentinel; a LINE-START one is a raw HTML
# construct, and creation now refuses it instead of composing a body that could
# never converge (#799 R1 — pinned in (f8d)).
OUT="$(dry_run --title t --body "$(cat "$TMP/files/midline-sentinel.md")")"
assert 'h: a sentinel body still gets the injected checklist' 9 \
  "$(grep -c -- '- \[ \] <!-- orc:' <<<"$OUT")"
OUT="$(dry_run --title t --body "$(cat "$TMP/files/sentinel.md")" 2>&1)"; RC=$?
assert 'h: a line-start sentinel body is refused at creation' 2 "$RC"
assert 'h: and nothing is passed to gh' 0 "$(grep -c '^\[dry-run\] gh' <<<"$OUT")"

# R15 RULE: with NO explicit body the wrapper does not intervene at all — it
# injects nothing, passes no `--body`, and forwards the caller's flags untouched;
# gh sources (or prompts for) the body itself, and the note says exactly that.
OUT="$(dry_run --title t 2>&1)"; RC=$?
assert 'h: a bodyless PR exits 0' 0 "$RC"
assert 'h: a bodyless PR injects NO checklist' 0 "$(grep -c '<!-- orc:' <<<"$OUT")"
assert 'h: a bodyless PR passes no --body' 0 \
  "$(grep -cE '^\[dry-run\] gh .* --body([ =]|$)' <<<"$OUT")"
assert 'h: and the title still reaches gh' 1 "$(grep -cE '^\[dry-run\] gh .* --title t' <<<"$OUT")"
assert 'h: the note says gh sources the body itself' 1 \
  "$(grep -cF 'gh sources the PR body' <<<"$OUT")"
assert 'h: and names the inject-checklist remediation' 1 \
  "$(grep -cF 'pr-mutate edit <pr> --inject-checklist' <<<"$OUT")"

# --- (h2) gh's OWN body sources: an EXPLICIT body still wins -------------------
# `--fill`, `--fill-first`, `--fill-verbose`, `--template <path>`, `--web` and
# `--editor` make `gh pr create` source the body itself. An EXPLICIT
# `--body`/`--body-file` is nevertheless ALWAYS validated through the shared
# composition helper and forwarded with the managed checklist (arbsec/
# orchestraitor#799 R13 review): gh documents that an explicit `--body` takes
# precedence over autofilled content, so NOT forwarding used to create a PR
# whose body the gate immediately refused while the note claimed no body was
# passed. Injection is skipped only when NO explicit body was supplied.
OUT="$(dry_run --title t --fill 2>&1)"; RC=$?
assert 'h2: --fill exits 0' 0 "$RC"
assert 'h2: --fill injects nothing' 0 "$(grep -c '<!-- orc:' <<<"$OUT")"
assert 'h2: --fill passes no --body to gh' 0 \
  "$(grep -cE '^\[dry-run\] gh .* --body([ =]|$)' <<<"$OUT")"
assert 'h2: --fill is passed through to gh' 1 \
  "$(grep -cE '^\[dry-run\] gh .* --fill([ =]|$)' <<<"$OUT")"
assert 'h2: the --fill note names the remediation' 1 \
  "$(grep -cF 'pr-mutate edit <pr> --inject-checklist' <<<"$OUT")"
assert 'h2: --fill suppresses the bodyless note' 0 \
  "$(grep -cF 'NOTE: no PR body supplied' <<<"$OUT")"
# The note must describe what the code ACTUALLY does: no body was supplied, so
# no --body is passed and nothing is injected.
assert 'h2: the --fill note says no explicit body was supplied' 1 \
  "$(grep -cF 'no explicit body was supplied' <<<"$OUT")"
assert 'h2: and that nothing is injected' 1 \
  "$(grep -cF 'merge checklist is NOT injected and no --body is passed' <<<"$OUT")"

OUT="$(dry_run --title t --template .github/pull_request_template.md 2>&1)"; RC=$?
assert 'h2: --template exits 0' 0 "$RC"
assert 'h2: --template injects nothing' 0 "$(grep -c '<!-- orc:' <<<"$OUT")"
assert 'h2: --template passes no --body to gh' 0 \
  "$(grep -cE '^\[dry-run\] gh .* --body([ =]|$)' <<<"$OUT")"
assert 'h2: --template is passed through to gh' 1 \
  "$(grep -cE '^\[dry-run\] gh .* --template .github/pull_request_template.md($| )' <<<"$OUT")"
assert 'h2: the --template note names the remediation' 1 \
  "$(grep -cF 'pr-mutate edit <pr> --inject-checklist' <<<"$OUT")"

# (1) an explicit body alongside `--fill` is STILL VALIDATED: a body the engine
# refuses exits 2 with the typed message and NOTHING reaches gh.
OUT="$(dry_run --title t --body '- [x] <!-- orc:issue --> linked
<div>a block</div>' --fill 2>&1)"; RC=$?
assert 'h2: --fill + a refused explicit body exits 2' 2 "$RC"
assert 'h2: --fill + refused body names the construct' 1 \
  "$(grep -cF 'raw HTML construct at line 2' <<<"$OUT")"
assert 'h2: --fill + refused body never reaches gh' 0 \
  "$(grep -cE '^\[dry-run\] gh ' <<<"$OUT")"

# (2) an explicit body alongside `--fill` is FORWARDED, and it carries the nine
# markers: gh gives the explicit body precedence over autofilled content.
OUT="$(dry_run --title t --body 'a plain summary' --fill 2>&1)"; RC=$?
assert 'h2: --fill + an explicit body exits 0' 0 "$RC"
assert 'h2: --fill + explicit body forwards --body to gh' 1 \
  "$(grep -cE '^\[dry-run\] gh .* --body([ =]|$)' <<<"$OUT")"
assert 'h2: --fill + explicit body carries the nine markers' 9 \
  "$(grep -c -- '- \[ \] <!-- orc:' <<<"$OUT")"
assert 'h2: --fill + explicit body keeps the summary' 1 \
  "$(grep -cF 'a plain summary' <<<"$OUT")"
assert 'h2: --fill is still passed through' 1 \
  "$(grep -c -- '--fill' <<<"$OUT")"
assert 'h2: --fill + explicit body prints no remediation note' 0 \
  "$(grep -cF 'pr-mutate edit <pr> --inject-checklist' <<<"$OUT")"
# The `--body-file` route behaves identically.
printf 'a body-file summary\n' > "$TMP/files/h2-summary.md"
OUT="$(dry_run --title t --body-file "$TMP/files/h2-summary.md" --fill 2>&1)"; RC=$?
assert 'h2: --fill + --body-file exits 0' 0 "$RC"
assert 'h2: --fill + --body-file carries the nine markers' 9 \
  "$(grep -c -- '- \[ \] <!-- orc:' <<<"$OUT")"
assert 'h2: --fill + --body-file keeps the summary' 1 \
  "$(grep -cF 'a body-file summary' <<<"$OUT")"

# (3) R15: `--template`/`--web`/`--editor` are NOT special-cased any more. An
# explicit body is validated and forwarded, and the caller's flag is forwarded
# untouched: whether the combination is legal is gh's decision to report, never
# ours. Measured on gh v2.104.0: `--body x --web` and `--body x --editor` are
# ACCEPTED by gh; only `--body x --template T` is rejected by gh itself.
for exclusive in "--template .github/pull_request_template.md" "--web" "--editor" "--editor=true"; do
  OUT="$(dry_run --title t --body 'a plain summary' $exclusive 2>&1)"; RC=$?
  assert "h2: explicit body + '$exclusive' exits 0 (we never refuse)" 0 "$RC"
  assert "h2: explicit body + '$exclusive' keeps the forwarded --body" 1 \
    "$(grep -cE '^\[dry-run\] gh .* --body([ =]|$)' <<<"$OUT")"
  assert "h2: explicit body + '$exclusive' carries the nine markers" 9 \
    "$(grep -c -- '- \[ \] <!-- orc:' <<<"$OUT")"
  assert "h2: explicit body + '$exclusive' forwards the flag untouched" 1 \
    "$(grep -cF -- "${exclusive%% *}" <<<"$OUT")"
  assert "h2: explicit body + '$exclusive' prints no refusal" 0 \
    "$(grep -cF 'accepts only one body source' <<<"$OUT")"
done

dry_run --title t --body 'a' --body-file "$TMP/files/own-marker.md" >/dev/null
RC=$?
assert 'h: --body + --body-file is refused' 2 "$RC"

# --- (i) pr-mutate --inject-checklist: remediation for an EXISTING PR ----------
# `pr-create` gives a NEW PR the managed checklist. A PR that ALREADY exists
# carries none and would block forever — `--inject-checklist` is the
# one-command remediation path: read the current body, append the managed
# checklist, set the body.
export BODY_FIXTURE="$TMP/files/no-markers.md"
rm -f "$TMP/edited-body.md"
run pr-mutate edit 7 --repo test-org/repo --inject-checklist
assert 'i: the remediation exits 0' 0 "$RC"
assert 'i: the remediation reached gh pr edit' 1 "$(exists "$TMP/edited-body.md")"
EDITED="$(cat "$TMP/edited-body.md" 2>/dev/null || true)"
assert 'i: the new body carries the nine markers' 9 \
  "$(grep -c -- '- \[ \] <!-- orc:' <<<"$EDITED")"
assert 'i: the new body pre-ticks nothing' 0 "$(grep -c -- '- \[x\]' <<<"$EDITED")"
assert 'i: the author body survives' 1 "$(grep -cF 'false quantitative claim' <<<"$EDITED")"

# Idempotent: a body that already carries the checklist is left verbatim and gh
# is never called.
export BODY_FIXTURE="$TMP/files/all-checked.md"
rm -f "$TMP/edited-body.md"
run pr-mutate edit 7 --repo test-org/repo --inject-checklist
assert 'i: an already-checklisted body is a no-op (exit 0)' 0 "$RC"
assert 'i: the no-op never reaches gh' 0 "$(exists "$TMP/edited-body.md")"
assert 'i: the no-op says so' 1 \
  "$(grep -cF 'already carries the managed merge checklist' "$TMP/stderr")"

# The remediation sets the body itself: combining it with an explicit body is
# ambiguous and is refused.
export BODY_FIXTURE="$TMP/files/no-markers.md"
run pr-mutate edit 7 --repo test-org/repo --inject-checklist --body 'x'
assert 'i: --inject-checklist + --body is refused' 2 "$RC"
run pr-mutate edit 7 --repo test-org/repo --inject-checklist --body-file "$TMP/files/no-markers.md"
assert 'i: --inject-checklist + --body-file is refused' 2 "$RC"

# The dry-run never reaches gh.
rm -f "$TMP/edited-body.md"
OUT="$( cd "$TMP/repo" && SKILL_CASE=1 bash scripts/pr-mutate edit 7 \
  --repo test-org/repo --inject-checklist --dry-run 2>&1 )"; RC=$?
assert 'i: the dry-run exits 0' 0 "$RC"
assert 'i: the dry-run never reaches gh' 0 "$(exists "$TMP/edited-body.md")"
assert 'i: the dry-run says it does not reach gh' 1 \
  "$(grep -cF 'dry-run never reaches gh' <<<"$OUT")"

# --- (k) EVERY pr-mutate body route carries the checklist ---------------------
# The bodyless-PR note tells the author to add a summary with
# `pr-mutate edit <pr> --body-file <path>`. If that route set the file's text
# verbatim it would REPLACE the whole body and strip the injected checklist,
# dropping the PR back to `checklist_markers_missing` — advice that undoes
# itself. Both body routes therefore carry the same marker invariant through the
# same helper `pr-create` uses, and a body that already has a marker keeps its
# content unchanged (a command substitution normalises trailing newlines; that
# is the only difference — see the `--body-file=` trailing-newline assertion).
export BODY_FIXTURE="$TMP/files/all-checked.md"

rm -f "$TMP/edited-body.md" "$TMP/edited-argv.txt"
run pr-mutate edit 7 --repo test-org/repo --body 'A wholesale summary, no markers'
assert 'k: --body exits 0' 0 "$RC"
EDITED="$(cat "$TMP/edited-body.md" 2>/dev/null || true)"
assert 'k: --body carries the nine markers' 9 \
  "$(grep -c -- '- \[ \] <!-- orc:' <<<"$EDITED")"
assert 'k: --body keeps the summary' 1 \
  "$(grep -cF 'A wholesale summary, no markers' <<<"$EDITED")"
assert 'k: --body pre-ticks nothing' 0 "$(grep -c -- '- \[x\]' <<<"$EDITED")"
assert 'k: --body reaches gh as an explicit --body' 1 \
  "$(grep -cx -- '--body' "$TMP/edited-argv.txt")"
assert 'k: --body keeps the PR operand and repo' 2 \
  "$(grep -cE -- '^(7|--repo)$' "$TMP/edited-argv.txt")"

# The `--body=<text>` form is the same route.
rm -f "$TMP/edited-body.md"
run pr-mutate edit 7 --repo test-org/repo --body='A joined summary, no markers'
assert 'k: --body= carries the nine markers' 9 \
  "$(grep -c -- '- \[ \] <!-- orc:' "$TMP/edited-body.md")"
assert 'k: --body= keeps the summary' 1 \
  "$(grep -cF 'A joined summary, no markers' "$TMP/edited-body.md")"

# `--body-file` is READ by the script (a path cannot be annotated by gh).
rm -f "$TMP/edited-body.md" "$TMP/edited-argv.txt"
run pr-mutate edit 7 --repo test-org/repo --body-file "$TMP/files/no-markers.md"
assert 'k: --body-file exits 0' 0 "$RC"
EDITED="$(cat "$TMP/edited-body.md" 2>/dev/null || true)"
assert 'k: --body-file carries the nine markers' 9 \
  "$(grep -c -- '- \[ \] <!-- orc:' <<<"$EDITED")"
assert 'k: --body-file keeps the summary' 1 \
  "$(grep -cF 'false quantitative claim' <<<"$EDITED")"
assert 'k: --body-file never reaches gh as a flag' 0 \
  "$(grep -c -- '--body-file' "$TMP/edited-argv.txt")"

# A supplied body that already carries a marker is a verified fact: set it
# unchanged, never re-injected, never rewritten.
OWN_BODY='## Summary
- [x] <!-- orc:tests --> the suite passes'
printf '%s' "$OWN_BODY" > "$TMP/files/own-marker-body.txt"
printf '%s\n' "$OWN_BODY" > "$TMP/files/own-marker-body-nl.md"
rm -f "$TMP/edited-body.md"
run pr-mutate edit 7 --repo test-org/repo --body "$OWN_BODY"
assert 'k: an already-checklisted --body is byte-identical' identical \
  "$(cmp -s "$TMP/files/own-marker-body.txt" "$TMP/edited-body.md" && echo identical || echo different)"
assert 'k: verbatim means no injected section' 0 \
  "$(grep -cF 'Added by pr-create' "$TMP/edited-body.md")"
rm -f "$TMP/edited-body.md"
run pr-mutate edit 7 --repo test-org/repo --body-file "$TMP/files/own-marker-body-nl.md"
assert 'k: an already-checklisted --body-file is not re-injected' 1 \
  "$(grep -c '<!-- orc:' "$TMP/edited-body.md")"

# `--inject-checklist` still refuses an explicit body (now genuinely redundant:
# both routes carry the checklist).
run pr-mutate edit 7 --repo test-org/repo --inject-checklist --body 'x'
assert 'k: --inject-checklist + --body is still refused' 2 "$RC"
run pr-mutate edit 7 --repo test-org/repo --inject-checklist --body-file "$TMP/files/no-markers.md"
assert 'k: --inject-checklist + --body-file is still refused' 2 "$RC"

# The dry-run path carries the checklist in the constructed argv and never
# reaches gh.
rm -f "$TMP/edited-body.md"
OUT="$( cd "$TMP/repo" && SKILL_CASE=1 bash scripts/pr-mutate edit 7 \
  --repo test-org/repo --body 'x' --dry-run 2>&1 )"; RC=$?
assert 'k: a body-route dry-run exits 0' 0 "$RC"
assert 'k: a body-route dry-run never reaches gh' 0 "$(exists "$TMP/edited-body.md")"
assert 'k: the dry-run argv carries the nine markers' 9 \
  "$(grep -c -- '- \[ \] <!-- orc:' <<<"$OUT")"

# --- (k2) a REFUSED body argument must STOP the script -------------------------
# `X="$(f "$(g)")"` takes the OUTER substitution's status, so when `g` exits 2
# the failure never reaches `set -e`: the typed error was printed and `gh pr
# edit` then ran anyway with a checklist-only body, exit 0 — the body the author
# wrote was discarded (#788 gen-3 review; both adversarial sources). Each route
# now resolves in its own assignment, so the guard's status IS the assignment's
# status. `gh` must never be invoked, which the argv capture proves: the file
# only exists if the stub was reached.
OUT_OF_ROOT=/etc/passwd

rm -f "$TMP/edited-body.md" "$TMP/edited-argv.txt"
run pr-mutate edit 7 --repo test-org/repo --body "@$OUT_OF_ROOT"
assert 'k: --body @<out-of-root> is refused' 2 "$RC"
assert 'k: the out-of-root @file refusal is typed' 1 \
  "$(grep -cF 'outside the trusted roots' "$TMP/stderr")"
assert 'k: the out-of-root @file refusal never reaches gh' 0 "$(exists "$TMP/edited-argv.txt")"

rm -f "$TMP/edited-body.md" "$TMP/edited-argv.txt"
run pr-mutate edit 7 --repo test-org/repo --body "$OUT_OF_ROOT"
assert 'k: a path-shaped --body value is refused' 2 "$RC"
assert 'k: the path-shaped refusal is typed' 1 \
  "$(grep -cF 'is an existing file path, not body text' "$TMP/stderr")"
assert 'k: the path-shaped refusal never reaches gh' 0 "$(exists "$TMP/edited-argv.txt")"

rm -f "$TMP/edited-body.md" "$TMP/edited-argv.txt"
run pr-mutate edit 7 --repo test-org/repo "--body=@$OUT_OF_ROOT"
assert 'k: --body=@<out-of-root> is refused' 2 "$RC"
assert 'k: the --body=@ refusal never reaches gh' 0 "$(exists "$TMP/edited-argv.txt")"

# --- (k3) --body-file reads through the SAME trusted-root guard ----------------
# The delta turned this route from "gh reads the path" into "the script reads the
# path": without the guard the script posted any readable file, while `pr-create`
# refused the identical path (#788 gen-3 review).
rm -f "$TMP/edited-body.md" "$TMP/edited-argv.txt"
run pr-mutate edit 7 --repo test-org/repo --body-file "$OUT_OF_ROOT"
assert 'k: --body-file <out-of-root> is refused' 2 "$RC"
assert 'k: the --body-file refusal is typed' 1 \
  "$(grep -cF 'outside the trusted roots' "$TMP/stderr")"
assert 'k: the --body-file refusal never reaches gh' 0 "$(exists "$TMP/edited-argv.txt")"

rm -f "$TMP/edited-body.md" "$TMP/edited-argv.txt"
run pr-mutate edit 7 --repo test-org/repo "--body-file=$OUT_OF_ROOT"
assert 'k: --body-file=<out-of-root> is refused' 2 "$RC"
assert 'k: the --body-file= refusal never reaches gh' 0 "$(exists "$TMP/edited-argv.txt")"

# STDIN parity with `pr-create`: `--body-file -` is the gh convention.
rm -f "$TMP/edited-body.md"
OUT="$(printf '%s\n' 'a stdin summary, no markers' | (
  cd "$TMP/repo" && bash scripts/pr-mutate edit 7 --repo test-org/repo --body-file - 2>"$TMP/stderr"
))"; RC=$?
assert 'k: --body-file - exits 0' 0 "$RC"
EDITED="$(cat "$TMP/edited-body.md" 2>/dev/null || true)"
assert 'k: --body-file - gains the nine markers' 9 \
  "$(grep -c -- '- \[ \] <!-- orc:' <<<"$EDITED")"
assert 'k: --body-file - keeps the STDIN content' 1 \
  "$(grep -cF 'a stdin summary, no markers' <<<"$EDITED")"

# `--body-file -` with a TERMINAL on STDIN is refused (never a silent hang).
# A pty is required to observe the `-t 0` branch; `script` provides one. The
# child is wrapped in `bash -c` because `script -c` runs the string through the
# INVOKING user's shell (not necessarily bash).
if command -v script >/dev/null 2>&1; then
  rm -f "$TMP/edited-body.md"
  PTY_RC=0
  ( cd "$TMP/repo" && script -qec \
    "bash -c 'exec bash scripts/pr-mutate edit 7 --repo test-org/repo --body-file -'" \
    /dev/null ) >"$TMP/pty.txt" 2>&1 || PTY_RC=$?
  assert 'k: --body-file - on a terminal is refused' 2 "$PTY_RC"
  assert 'k: the terminal refusal names the STDIN forms' 1 \
    "$(grep -cF 'STDIN is a terminal' "$TMP/pty.txt")"
  assert 'k: the terminal refusal never reaches gh' 0 "$(exists "$TMP/edited-body.md")"
else
  echo 'NOTICE: `script` unavailable — the terminal-on-STDIN refusal was NOT exercised'
fi

# --- (k4) an append inside an UNCLOSED fence is refused ------------------------
# Markers appended inside an open fence are rendered as code and stripped from
# the marker scan: the "remediation" would change nothing visible and a second
# `--inject-checklist` run would append another invisible copy (#788 gen-3
# review, CodeRabbit major). The author's body is neither reordered nor repaired.
cat > "$TMP/files/unclosed-backtick.md" <<'EOF'
## Summary

An example that never closes:

```markdown
- [ ] not a real item
EOF
cat > "$TMP/files/unclosed-tilde.md" <<'EOF'
## Summary

~~~text
an example that never closes
EOF
cat > "$TMP/files/closed-fence-tail.md" <<'EOF'
## Summary

An example that DOES close:

```markdown
- [ ] not a real item
```
EOF
# arbsec/orchestraitor#799 F18: the closer's tail is ONLY spaces and tabs
# (CommonMark 0.31), plus the carriage return of a CRLF terminator, which is part
# of the line ending rather than content. Both a VERTICAL TAB and a FORM FEED are
# therefore content: the region stays OPEN, exactly as GitHub renders it. The
# merge-lane consequence is here — a guard that reads such a line as a closer
# appends the nine markers into a fence that renders open, so they are invisible
# to every later marker scan. Before the fix `[[:space:]]` carried \v and Rust
# `is_ascii_whitespace` carried \f, so the two engines disagreed in opposite
# directions. The CRLF body is the positive control: it still closes.
{ printf '## Summary\n\nAn example whose closer carries a vertical tab:\n\n'
  printf '```markdown\n- [ ] not a real item\n```\013\n'; } \
  > "$TMP/files/vt-tail-fence.md"
{ printf '## Summary\n\nAn example whose closer carries a form feed:\n\n'
  printf '```markdown\n- [ ] not a real item\n```\014\n'; } \
  > "$TMP/files/ff-tail-fence.md"
{ printf '## Summary\n\nAn example whose closer ends with a CRLF terminator:\n\n'
  printf '```markdown\r\n- [ ] not a real item\r\n```\r\n'; } \
  > "$TMP/files/crlf-tail-fence.md"

rm -f "$TMP/edited-body.md" "$TMP/edited-argv.txt"
run pr-mutate edit 7 --repo test-org/repo --body-file "$TMP/files/unclosed-backtick.md"
assert 'k: a body ending inside a backtick fence is refused' 2 "$RC"
assert 'k: the refusal names the unclosed fence' 1 \
  "$(grep -cF 'unclosed code fence' "$TMP/stderr")"
assert 'k: the refusal names the backtick run' 1 \
  "$(grep -cF 'opened with 3 backticks' "$TMP/stderr")"
assert 'k: the refused append never reaches gh' 0 "$(exists "$TMP/edited-argv.txt")"

rm -f "$TMP/edited-body.md" "$TMP/edited-argv.txt"
run pr-mutate edit 7 --repo test-org/repo --body-file "$TMP/files/unclosed-tilde.md"
assert 'k: a body ending inside a tilde fence is refused' 2 "$RC"
assert 'k: the refusal names the tilde run' 1 \
  "$(grep -cF 'opened with 3 tildes' "$TMP/stderr")"
assert 'k: the tilde refusal never reaches gh' 0 "$(exists "$TMP/edited-argv.txt")"

rm -f "$TMP/edited-body.md"
run pr-mutate edit 7 --repo test-org/repo --body-file "$TMP/files/closed-fence-tail.md"
assert 'k: a body ending with a CLOSED fence still appends' 0 "$RC"
assert 'k: the closed-fence body gains the nine markers' 9 \
  "$(grep -c -- '- \[ \] <!-- orc:' "$TMP/edited-body.md")"

# F18: a vertical tab after the closer does NOT close, so the append is refused
# exactly like an unclosed fence. The form feed behaves the same way (CommonMark
# allows only spaces and tabs there). The CRLF terminator is the positive
# control: it is a line ending, not content, so that body still appends.
rm -f "$TMP/edited-body.md" "$TMP/edited-argv.txt"
run pr-mutate edit 7 --repo test-org/repo --body-file "$TMP/files/vt-tail-fence.md"
assert 'k: a ```<VT> closer is not a closer: the append is refused' 2 "$RC"
assert 'k: the VT refusal names the unclosed fence' 1 \
  "$(grep -cF 'unclosed code fence' "$TMP/stderr")"
assert 'k: the VT refusal never reaches gh' 0 "$(exists "$TMP/edited-argv.txt")"

rm -f "$TMP/edited-body.md" "$TMP/edited-argv.txt"
run pr-mutate edit 7 --repo test-org/repo --body-file "$TMP/files/ff-tail-fence.md"
assert 'k: a ```<FF> closer is not a closer either: refused' 2 "$RC"
assert 'k: the FF refusal names the unclosed fence' 1 \
  "$(grep -cF 'unclosed code fence' "$TMP/stderr")"
assert 'k: the FF refusal never reaches gh' 0 "$(exists "$TMP/edited-argv.txt")"

rm -f "$TMP/edited-body.md"
run pr-mutate edit 7 --repo test-org/repo --body-file "$TMP/files/crlf-tail-fence.md"
assert 'k: a ```<CRLF> closer IS a closer: the body still appends' 0 "$RC"
assert 'k: the CRLF-tailed body gains the nine markers' 9 \
  "$(grep -c -- '- \[ \] <!-- orc:' "$TMP/edited-body.md")"

# `pr-create` shares the helper, so the same refusal applies at creation.
OUT="$(dry_run --title t --body-file "$TMP/files/unclosed-backtick.md" 2>&1)"; RC=$?
assert 'k: pr-create refuses a body ending inside a fence' 2 "$RC"
assert 'k: the pr-create refusal names the fence' 1 \
  "$(grep -cF 'unclosed code fence' <<<"$OUT")"

# --- (k5) --inject-checklist skips ONLY the body update -----------------------
# A body that already carries the checklist used to exit 0 before executing the
# rest of the edit flags, silently discarding them (#788 gen-3 review,
# CodeRabbit minor).
export BODY_FIXTURE="$TMP/files/all-checked.md"
rm -f "$TMP/edited-body.md" "$TMP/edited-argv.txt"
run pr-mutate edit 7 --repo test-org/repo --inject-checklist --add-label needs-triage
assert 'k: --inject-checklist + another edit flag exits 0' 0 "$RC"
assert 'k: the other edit flag still reaches gh' 1 \
  "$(grep -cx -- '--add-label' "$TMP/edited-argv.txt")"
assert 'k: the other edit flag keeps its operand' 1 \
  "$(grep -cx -- 'needs-triage' "$TMP/edited-argv.txt")"
assert 'k: the skipped body update sets no --body' 0 \
  "$(grep -cx -- '--body' "$TMP/edited-argv.txt")"

# --- (k6) the `=` forms of both body routes ------------------------------------
rm -f "$TMP/edited-body.md" "$TMP/edited-argv.txt"
run pr-mutate edit 7 --repo test-org/repo --body-file="$TMP/files/no-markers.md"
assert 'k: --body-file= carries the nine markers' 9 \
  "$(grep -c -- '- \[ \] <!-- orc:' "$TMP/edited-body.md")"
assert 'k: --body-file= keeps the summary' 1 \
  "$(grep -cF 'false quantitative claim' "$TMP/edited-body.md")"
assert 'k: --body-file= never reaches gh as a flag' 0 \
  "$(grep -c -- '--body-file' "$TMP/edited-argv.txt")"

rm -f "$TMP/edited-body.md"
run pr-mutate edit 7 --repo test-org/repo "--body=$OWN_BODY"
assert 'k: an already-checklisted --body= is content-identical' identical \
  "$(cmp -s "$TMP/files/own-marker-body.txt" "$TMP/edited-body.md" && echo identical || echo different)"

# The routes resolve the body through a command substitution, so trailing
# newlines are normalised away and NOTHING else changes. That is the guarantee
# `references/pr-convergence.md` states — not "byte-for-byte".
printf '%s\n\n' "$OWN_BODY" > "$TMP/files/own-marker-trailing.md"
rm -f "$TMP/edited-body.md"
run pr-mutate edit 7 --repo test-org/repo --body-file "$TMP/files/own-marker-trailing.md"
assert 'k: a supplied body keeps its content (trailing newlines normalised)' identical \
  "$(cmp -s "$TMP/files/own-marker-body.txt" "$TMP/edited-body.md" && echo identical || echo different)"

# --- the bodyless-PR advice must name a route that KEEPS the checklist --------
# Pinned end to end: extract the command pr-create prints, then run that exact
# shape against a summary-only fixture and require a checklist-bearing body.
OUT="$(dry_run --title t)"
# R15: the note for a bodyless creation is the "gh sources the body" note, so
# the route it names is the one-command remediation that KEEPS the checklist.
ADVICE_SHAPE='pr-mutate edit <pr> --inject-checklist'
assert 'k: the bodyless note names the inject-checklist route' "$ADVICE_SHAPE" \
  "$(grep -oF "$ADVICE_SHAPE" <<<"$OUT" | head -1)"
assert 'k: the note says the checklist was NOT injected' 1 \
  "$(grep -cF 'is NOT injected and no --body is passed' <<<"$OUT")"
cat > "$TMP/files/advice-summary.md" <<'EOF'
## Summary

A summarised change, written after the PR existed.
EOF
rm -f "$TMP/edited-body.md"
run pr-mutate edit 7 --repo test-org/repo --body-file "$TMP/files/advice-summary.md"
assert 'k: the advised route exits 0' 0 "$RC"
EDITED="$(cat "$TMP/edited-body.md" 2>/dev/null || true)"
assert 'k: the advised route produces a checklist-bearing body' 9 \
  "$(grep -c -- '- \[ \] <!-- orc:' <<<"$EDITED")"
assert 'k: the advised route keeps the summary' 1 \
  "$(grep -cF 'A summarised change, written after the PR existed.' <<<"$EDITED")"

# --- (j) the fixture's git calls ignore an ambient git LOCATION ---------------
# `git -C <dir>` does NOT isolate the git location: a hook-exported
# GIT_DIR/GIT_WORK_TREE wins over `-C`. Without the scrub the fixture's
# `git add -A` / `git commit` would stage and commit the CALLER's working tree.
SENTINEL="$TMP/sentinel"
HOSTILE="$TMP/hostile"
mkdir -p "$SENTINEL" "$HOSTILE"
git_repo "$SENTINEL" init -q
git_repo "$SENTINEL" config user.email sentinel@example.invalid
git_repo "$SENTINEL" config user.name sentinel
printf 'sentinel\n' > "$SENTINEL/README.md"
git_repo "$SENTINEL" add -A
git_repo "$SENTINEL" commit -q -m sentinel
SENTINEL_HEAD="$(git_repo "$SENTINEL" rev-parse HEAD)"
SENTINEL_LOG="$(git_repo "$SENTINEL" log --format=%s)"

# The hostile location: GIT_DIR/GIT_WORK_TREE point at the sentinel repo.
GIT_REPO_ENV=("GIT_DIR=$SENTINEL/.git" "GIT_WORK_TREE=$SENTINEL")
git_repo "$HOSTILE" init -q
git_repo "$HOSTILE" config user.email hostile@example.invalid
git_repo "$HOSTILE" config user.name hostile
printf 'hostile\n' > "$HOSTILE/README.md"
git_repo "$HOSTILE" add -A
git_repo "$HOSTILE" commit -q -m hostile
GIT_REPO_ENV=()

HOSTILE_HEAD="$(git_repo "$HOSTILE" rev-parse HEAD)"
SENTINEL_HEAD_AFTER="$(git_repo "$SENTINEL" rev-parse HEAD)"
SENTINEL_LOG_AFTER="$(git_repo "$SENTINEL" log --format=%s)"
# The fixture's own commit landed in the FIXTURE, not in the sentinel.
assert 'j: the hostile fixture carries its own commit' 'hostile' \
  "$(git_repo "$HOSTILE" log --format=%s)"
assert 'j: the hostile location did not capture the fixture' 'different' \
  "$([ "$HOSTILE_HEAD" != "$SENTINEL_HEAD" ] && echo different || echo same)"
# The sentinel repo still holds exactly its own commit: nothing leaked into it.
assert 'j: the sentinel HEAD is unchanged' "$SENTINEL_HEAD" "$SENTINEL_HEAD_AFTER"
assert 'j: the sentinel log is unchanged' "$SENTINEL_LOG" "$SENTINEL_LOG_AFTER"
# Positive control: WITHOUT the scrub the ambient location wins over `-C`, so
# the hostile values really are effective here — the scrub is what keeps the
# fixture out of the sentinel.
CONTROL_TOPLEVEL="$(GIT_DIR="$SENTINEL/.git" GIT_WORK_TREE="$SENTINEL" \
  git -C "$HOSTILE" rev-parse --show-toplevel 2>/dev/null || true)"
assert 'j: control: the ambient location does win over -C' "$SENTINEL" "$CONTROL_TOPLEVEL"

# --- (f8e) a DESCRIPTION with an INTERNAL TAB survives (#799 R16) -------------
# The shell engine used to pass items through a TAB-delimited intermediate, so a
# description containing a tab was truncated at the field split (`alpha<TAB>beta`
# became `alpha`) while the Rust engine returned the full text. The items are
# built with `jq --arg` now, so no byte of the body can collide with the
# encoding. Corpus case 84 is the shared fixture; this asserts the VALUE the
# Rust engine returns for it too.
export BODY_FIXTURE="$CORPUS_DIR/84-description-with-a-tab.md"
run reconcile-checklist 7 --repo test-org/repo --json
assert 'f8e: the tabbed description is counted' 2 "$(jq -r .marker_count <<<"$OUT")"
assert 'f8e: and the INTERNAL tab survives' "$(printf 'alpha\tbeta')" \
  "$(jq -r '.items[0].description' <<<"$OUT")"
assert 'f8e: the second item is unaffected' 'gamma' \
  "$(jq -r '.items[1].description' <<<"$OUT")"
run reconcile-checklist 7 --repo test-org/repo
assert 'f8e: the text form prints the whole description' 1 \
  "$(grep -cF "$(printf 'alpha\tbeta')" <<<"$OUT")"
export BODY_FIXTURE="$TMP/files/no-markers.md"

# --- (f9) a MANAGED MARKER indented 4+ spaces is INDETERMINATE (#802) ----------
# CONFIRMED BY EXECUTION: nine canonical ticked markers, each preceded by FOUR
# spaces and with no surrounding list, render entirely as an INDENTED CODE
# BLOCK — yet the gate used to report `marker_count=9, all_checked=true` and
# `merge-gate` merged it. The canonical grammar's leading `[ \t]*` cannot tell
# "marker inside a list item" (legitimate) from "standalone indented code" (not
# evidence), and neither scanner has a container model, so the reading is
# REFUSED (`indented_marker`) instead of counted. The markers still COUNT —
# marker_count is a pure function of the canonical grammar — and the verdict
# blocks on the refusal, never on that count.
nine_indented() { # nine_indented <indent> -> the nine ticked markers at <indent>
  local indent="$1" name
  for name in issue service-identity tests security docs rollback checks review threads; do
    printf '%s- [x] <!-- orc:%s --> checked with evidence\n' "$indent" "$name"
  done
}
nine_indented '    ' > "$TMP/files/f9-four-space-nine.md"
export BODY_FIXTURE="$TMP/files/f9-four-space-nine.md"
run reconcile-checklist 7 --repo test-org/repo --json
assert 'f9: nine 4-space-indented markers still count' 9 "$(jq -r .marker_count <<<"$OUT")"
assert 'f9: but the reading is REFUSED (#802)' true "$(jq -r .unparseable <<<"$OUT")"
assert 'f9: and it names the line' 1 "$(jq -r .unparseable_line <<<"$OUT")"
assert 'f9: and names indented_marker' 'indented_marker' \
  "$(jq -r .unparseable_construct <<<"$OUT")"
assert 'f9: an indented code block is never all checked' false \
  "$(jq -r .all_checked <<<"$OUT")"
run convergence-status 7 --repo test-org/repo --json
assert 'f9: so the gate BLOCKS it' 5 "$RC"
assert 'f9: with the distinct unparseable reason' '["checklist_unparseable"]' \
  "$(jq -c .reasons <<<"$OUT")"
assert 'f9: and the telemetry carries the refusal' true \
  "$(jq -r .checklist_unparseable <<<"$OUT")"
run convergence-status 7 --repo test-org/repo
assert 'f9: text mode names the indented marker' 1 \
  "$(grep -cF 'a managed marker is indented too far at line 1' <<<"$OUT")"
assert 'f9: and names a working remedy' 1 \
  "$(grep -cF 'dedent the marker line to column 0' <<<"$OUT")"
# It must never be reported as a fence or an HTML construct.
assert 'f9: never a fence message' 0 "$(grep -cF 'opens a fenced code block' <<<"$OUT")"
assert 'f9: never an HTML message' 0 "$(grep -cF 'raw HTML construct' <<<"$OUT")"
rm -f "$TMP/merge-argv.txt"
run merge-gate 7 --repo test-org/repo
assert 'f9: merge-gate refuses the indented-marker body' 5 "$RC"
assert 'f9: naming the checklist refusal' 1 \
  "$(grep -cF 'checklist_unparseable' "$TMP/stderr")"
assert 'f9: and it NEVER invokes gh pr merge' 0 "$(exists "$TMP/merge-argv.txt")"

# The refusal does not depend on the body carrying NOTHING else.
{ nine_indented '    '; nine_indented ''; } > "$TMP/files/f9-four-space-plus-canonical.md"
export BODY_FIXTURE="$TMP/files/f9-four-space-plus-canonical.md"
run reconcile-checklist 7 --repo test-org/repo --json
assert 'f9: 4-space + canonical markers both count' 18 "$(jq -r .marker_count <<<"$OUT")"
assert 'f9: and the indented ones still refuse the reading' true \
  "$(jq -r .unparseable <<<"$OUT")"
assert 'f9: with indented_marker' 'indented_marker' \
  "$(jq -r .unparseable_construct <<<"$OUT")"
run convergence-status 7 --repo test-org/repo --json
assert 'f9: the gate blocks that body too' 5 "$RC"

# The legitimate case, unchanged: 0-3 leading spaces is a marker nested in a
# list item.
nine_indented '  ' > "$TMP/files/f9-two-space-nine.md"
export BODY_FIXTURE="$TMP/files/f9-two-space-nine.md"
run reconcile-checklist 7 --repo test-org/repo --json
assert 'f9: nine 2-space-indented markers count' 9 "$(jq -r .marker_count <<<"$OUT")"
assert 'f9: and stay determinate' false "$(jq -r .unparseable <<<"$OUT")"
assert 'f9: and read as all checked, as before' true "$(jq -r .all_checked <<<"$OUT")"
run convergence-status 7 --repo test-org/repo --json
assert 'f9: so the gate still converges on them' 0 "$RC"

# A TAB reaches the 4-column tab stop: the same refusal, never a silent drop.
printf '\t- [x] <!-- orc:tests --> tab-led marker\n' > "$TMP/files/f9-tab-led.md"
export BODY_FIXTURE="$TMP/files/f9-tab-led.md"
run reconcile-checklist 7 --repo test-org/repo --json
assert 'f9: a tab-led marker still counts' 1 "$(jq -r .marker_count <<<"$OUT")"
assert 'f9: but it is refused' true "$(jq -r .unparseable <<<"$OUT")"
assert 'f9: as indented_marker' 'indented_marker' \
  "$(jq -r .unparseable_construct <<<"$OUT")"
run convergence-status 7 --repo test-org/repo --json
assert 'f9: and it blocks with the refusal, not markers_missing' \
  '["checklist_unparseable"]' "$(jq -c .reasons <<<"$OUT")"

# A NEAR-MARKER indented 4 spaces is indeterminate for BOTH reasons; the
# reported construct is the more specific `indented_marker`, because the
# indentation is what makes the line render as code — never silently ignored.
{ nine_indented ''; printf '    - [x]  <!-- orc:tests --> four-space-indented near-marker\n'; } \
  > "$TMP/files/f9-indented-near-marker.md"
export BODY_FIXTURE="$TMP/files/f9-indented-near-marker.md"
run reconcile-checklist 7 --repo test-org/repo --json
assert 'f9: a 4-space near-marker keeps the nine real markers' 9 \
  "$(jq -r .marker_count <<<"$OUT")"
assert 'f9: and refuses the reading' true "$(jq -r .unparseable <<<"$OUT")"
assert 'f9: naming indented_marker, not near_marker' 'indented_marker' \
  "$(jq -r .unparseable_construct <<<"$OUT")"
assert 'f9: on the near-marker line' 10 "$(jq -r .unparseable_line <<<"$OUT")"
# A marker inside a FENCED region is inert, not a refusal.
printf '```\n    - [x] <!-- orc:tests --> fenced\n```\n' > "$TMP/files/f9-fenced-indented.md"
export BODY_FIXTURE="$TMP/files/f9-fenced-indented.md"
run reconcile-checklist 7 --repo test-org/repo --json
assert 'f9: a fenced 4-space marker is inert' 0 "$(jq -r .marker_count <<<"$OUT")"
assert 'f9: and not a refusal' false "$(jq -r .unparseable <<<"$OUT")"
export BODY_FIXTURE="$TMP/files/no-markers.md"

# --- (f10) composition refuses a body the engine will reject (#799 R12) --------
# `pr-create`/`pr-mutate` used to exit 0 and compose a body that
# `reconcile-checklist` then refuses: the HTML check ran only when the helper
# was about to APPEND markers (it returns early for a body that already carries
# one) and neither the near-marker rule nor #802's indented-marker rule was
# validated at all. All FOUR constructs (the sticky indented fence opener, the
# raw HTML construct, the indented marker and the near-marker) are now validated
# BEFORE that early
# return; the unclosed-fence refusal stays append-specific.
printf -- '- [x] <!-- orc:issue --> linked\n<div>a block</div>\n' > "$TMP/files/f10-html.md"
printf -- '- [ ]\t<!-- orc:tests --> near only\n' > "$TMP/files/f10-near.md"
printf -- '- [x] <!-- orc:issue --> linked\n- [ ]  <!-- orc:tests --> near\n' > "$TMP/files/f10-near-after-canonical.md"
printf -- '- [x] <!-- orc:issue --> linked\n    - [x] <!-- orc:tests --> indented\n' > "$TMP/files/f10-indented.md"
for shape in html near near-after-canonical indented; do
  case "$shape" in
    html)                 want='raw HTML construct at line 2'; fix='put it inside a fenced code block, indent it by 4 spaces, or remove it' ;;
    near)                 want='near-marker at line 1'; fix='write the marker canonically' ;;
    near-after-canonical) want='near-marker at line 2'; fix='write the marker canonically' ;;
    indented)             want='indented too far at line 2'; fix='dedent the marker line to column 0' ;;
  esac
  # (1) the shared helper itself
  rm -f "$TMP/stderr"
  ensure "$(cat "$TMP/files/f10-$shape.md")" "$TMP/repo" >/dev/null 2>"$TMP/stderr"; RC=$?
  assert "f10: $shape is refused by the helper" 2 "$RC"
  assert "f10: $shape names what it refused" 1 "$(grep -cF "$want" "$TMP/stderr")"
  assert "f10: $shape offers a working remedy" 1 "$(grep -cF "$fix" "$TMP/stderr")"
  assert "f10: $shape appends nothing" 0 "$(grep -c -- '- \[ \] <!-- orc:' "$TMP/stderr")"
  # (2) pr-create, through its real body route
  OUT="$(dry_run --title t --body "$(cat "$TMP/files/f10-$shape.md")" 2>&1)"; RC=$?
  assert "f10: pr-create refuses $shape" 2 "$RC"
  assert "f10: pr-create names what it refused for $shape" 1 "$(grep -cF "$want" <<<"$OUT")"
  assert "f10: pr-create never reaches gh for $shape" 0 \
    "$(grep -cE '^\[dry-run\] gh ' <<<"$OUT")"
  # (3) pr-mutate, through its real body route
  rm -f "$TMP/edited-body.md"
  run pr-mutate edit 7 --repo test-org/repo --body "$(cat "$TMP/files/f10-$shape.md")"
  assert "f10: pr-mutate refuses $shape" 2 "$RC"
  assert "f10: pr-mutate names what it refused for $shape" 1 \
    "$(grep -cF "$want" "$TMP/stderr")"
  assert "f10: pr-mutate never reaches gh for $shape" 0 "$(exists "$TMP/edited-body.md")"
done
# The unclosed-fence refusal is APPEND-SPECIFIC: a body that already carries the
# checklist is not refused for a fence it is not appending into (the fence is a
# column-0 one, so it is not an indeterminate opener either).
printf -- '- [x] <!-- orc:issue --> linked\n```\nunclosed\n' > "$TMP/files/f10-unclosed-fence.md"
rm -f "$TMP/stderr"
ensured="$(ensure "$(cat "$TMP/files/f10-unclosed-fence.md")" "$TMP/repo" 2>"$TMP/stderr")"; RC=$?
assert 'f10: an already-checklisted body with an open fence is not refused' 0 "$RC"
assert 'f10: and its content is set unchanged' 1 "$(grep -cF 'unclosed' <<<"$ensured")"
# A body that carries NO checklist and ends in an unclosed fence IS refused.
printf 'just prose\n```\nunclosed\n' > "$TMP/files/f10-append-into-fence.md"
rm -f "$TMP/stderr"
ensure "$(cat "$TMP/files/f10-append-into-fence.md")" "$TMP/repo" >/dev/null 2>"$TMP/stderr"; RC=$?
assert 'f10: appending into an unclosed fence is still refused' 2 "$RC"
assert 'f10: and the error names the fence' 1 "$(grep -cF 'ends inside an unclosed code fence' "$TMP/stderr")"

# --- (f11) the box-token rule is LOCALE-INDEPENDENT (#799 R12) -----------------
# A box token is `[` + exactly ONE CHARACTER + `]`. The shell used to regex it
# as one BYTE under a C locale, gated behind a functional `C.UTF-8` probe: on a
# machine without that locale `[✓] orc:review` was three bytes for the shell and
# one character for Rust, so the shell read a near-marker as prose (a false
# pass) while Rust refused it. The scan now decodes one UTF-8 sequence by byte
# and is pinned to the C locale, so the SAME body must produce the SAME verdict
# in every ambient locale.
printf -- '- [x] <!-- orc:review --> reviewed\n[\342\234\223] orc:review\n' \
  > "$TMP/files/f11-unicode-bare.md"
printf -- '- [x] <!-- orc:tests --> tested\n[\342\234\223]  <!-- orc:tests -->\n' \
  > "$TMP/files/f11-unicode-delimiter.md"
export BODY_FIXTURE="$TMP/files/f11-unicode-bare.md"
for ambient_locale in C C.UTF-8 en_US.UTF-8; do
  OUT="$(cd "$TMP/repo" && LC_ALL="$ambient_locale" \
    bash scripts/reconcile-checklist 7 --repo test-org/repo --json 2>"$TMP/stderr")"; RC=$?
  assert "f11: [$ambient_locale] the engine still exits 0" 0 "$RC"
  assert "f11: [$ambient_locale] [✓] is a near-marker" true \
    "$(jq -r .unparseable <<<"$OUT")"
  assert "f11: [$ambient_locale] and names near_marker" 'near_marker' \
    "$(jq -r .unparseable_construct <<<"$OUT")"
  assert "f11: [$ambient_locale] and counts only the canonical marker" 1 \
    "$(jq -r .marker_count <<<"$OUT")"
done
export BODY_FIXTURE="$TMP/files/f11-unicode-delimiter.md"
for ambient_locale in C C.UTF-8 en_US.UTF-8; do
  OUT="$(cd "$TMP/repo" && LC_ALL="$ambient_locale" \
    bash scripts/reconcile-checklist 7 --repo test-org/repo --json 2>"$TMP/stderr")"; RC=$?
  assert "f11: [$ambient_locale] the delimiter form is a near-marker" 'near_marker' \
    "$(jq -r .unparseable_construct <<<"$OUT")"
done
# The scan's byte decoder is locale-independent BY CONSTRUCTION: the exported
# scan reports the near-marker LINE even with the ambient locale forced to C, so
# no probe and no ambient locale can change what it decides.
assert 'f11: the scan decoder is locale-independent (C locale)' 1 \
  "$(printf -- '- [x] <!-- orc:tests --> t\n[\342\234\223] orc:tests\n' \
    | LC_ALL=C bash -c 'source "$1"; orc_lib_near_marker_line' _ "$SCRIPT_DIR/_lib.sh" \
    | grep -c '^2$')"
export BODY_FIXTURE="$TMP/files/no-markers.md"

# --- (f12) composition and the engine agree, for EVERY construct (#799 R14) ---
# The recurring defect: the refusal rules exist in three copies and each drifted.
# The shell composition helper now runs the ENGINE's own four refusals (through
# `orc_lib_first_unparseable_line`) BEFORE its early return and before any
# append. The invariant asserted here is the real one: if `reconcile-checklist`
# would report an unparseable construct, `pr-create`/`pr-mutate` must have
# refused (exit 2) and never called `gh`; and every body the helper ACCEPTS must
# parse as determinate when the real `reconcile-checklist` reads it.
compose_invariant() { # compose_invariant <label> <composed body>
  local label="$1" composed="$2"
  printf '%s' "$composed" > "$TMP/files/invariant.md"
  export BODY_FIXTURE="$TMP/files/invariant.md"
  run reconcile-checklist 7 --repo test-org/repo --json
  assert "f12: $label — reconcile-checklist reads the composed body" 0 "$RC"
  assert "f12: $label — the composed body is DETERMINATE" false \
    "$(jq -r .unparseable <<<"$OUT")"
}
# Every construct, as a seed the caller could plausibly supply.
F12_INDENTED_FENCE=$' ```\nexample\n ```\n'          # 1-space opener, CLOSES
F12_THREE_SPACE_FENCE=$'   ```\nexample\n   ```\n'   # 3-space opener, CLOSES
F12_HTML=$'- [x] <!-- orc:issue --> linked\n<div>a block</div>\n'
F12_INDENTED_MARKER=$'- [x] <!-- orc:issue --> linked\n    - [x] <!-- orc:tests --> indented\n'
F12_NEAR_MARKER=$'- [x] <!-- orc:issue --> linked\n- [ ]  <!-- orc:tests --> near\n'
for seed_case in indented-fence three-space-fence html indented-marker near-marker; do
  case "$seed_case" in
    indented-fence)      seed="$F12_INDENTED_FENCE";      want='opens a fenced code block indented 1-3 spaces on line 1' ;;
    three-space-fence)   seed="$F12_THREE_SPACE_FENCE";   want='opens a fenced code block indented 1-3 spaces on line 1' ;;
    html)                seed="$F12_HTML";                want='raw HTML construct at line 2' ;;
    indented-marker)     seed="$F12_INDENTED_MARKER";     want='indented too far at line 2' ;;
    near-marker)         seed="$F12_NEAR_MARKER";         want='near-marker at line 2' ;;
  esac
  # (1) the shared helper refuses it
  rm -f "$TMP/stderr"
  ensure "$seed" "$TMP/repo" >/dev/null 2>"$TMP/stderr"; RC=$?
  assert "f12: $seed_case is refused by the helper" 2 "$RC"
  assert "f12: $seed_case names what it refused" 1 "$(grep -cF "$want" "$TMP/stderr")"
  assert "f12: $seed_case appends nothing" 0 "$(grep -c -- '- \[ \] <!-- orc:' "$TMP/stderr")"
  # (2) pr-create refuses it and never reaches gh
  OUT="$(dry_run --title t --body "$seed" 2>&1)"; RC=$?
  assert "f12: pr-create refuses $seed_case" 2 "$RC"
  assert "f12: pr-create names $seed_case" 1 "$(grep -cF "$want" <<<"$OUT")"
  assert "f12: pr-create never reaches gh for $seed_case" 0 \
    "$(grep -cE '^\[dry-run\] gh ' <<<"$OUT")"
  # (3) pr-mutate refuses it and never reaches gh
  rm -f "$TMP/edited-body.md"
  run pr-mutate edit 7 --repo test-org/repo --body "$seed"
  assert "f12: pr-mutate refuses $seed_case" 2 "$RC"
  assert "f12: pr-mutate names $seed_case" 1 "$(grep -cF "$want" "$TMP/stderr")"
  assert "f12: pr-mutate never reaches gh for $seed_case" 0 \
    "$(exists "$TMP/edited-body.md")"
done
# The STICKY opener refusal is NOT append-specific: an ALREADY-CHECKLISTED body
# with a 1-3-space opener is refused too, because the engine refuses it.
printf -- '- [x] <!-- orc:issue --> linked\n ```\nexample\n ```\n' > "$TMP/files/f12-sticky-with-markers.md"
rm -f "$TMP/stderr"
ensure "$(cat "$TMP/files/f12-sticky-with-markers.md")" "$TMP/repo" >/dev/null 2>"$TMP/stderr"; RC=$?
assert 'f12: an already-checklisted body with a sticky opener is refused' 2 "$RC"
assert 'f12: and names the fence construct' 1 \
  "$(grep -cF 'opens a fenced code block indented 1-3 spaces on line 2' "$TMP/stderr")"
# The UNCLOSED-fence refusal STAYS append-specific: a body that already carries
# the checklist is not refused for a fence it is not appending into.
printf -- '- [x] <!-- orc:issue --> linked\n```\nunclosed\n' > "$TMP/files/f12-open-fence-with-markers.md"
rm -f "$TMP/stderr"
ensure "$(cat "$TMP/files/f12-open-fence-with-markers.md")" "$TMP/repo" >/dev/null 2>"$TMP/stderr"; RC=$?
assert 'f12: an already-checklisted body with an open fence is still accepted' 0 "$RC"
# The POSITIVE half of the invariant: every accepted composition is determinate.
compose_invariant 'plain summary' "$(ensure $'a plain summary\n' "$TMP/repo")"
compose_invariant 'explicit empty body' "$(ensure '' "$TMP/repo")"
compose_invariant 'already-checklisted body' "$(ensure $'- [x] <!-- orc:issue --> linked\n' "$TMP/repo")"
compose_invariant 'column-0 closed fence' "$(ensure $'```\nexample\n```\n' "$TMP/repo")"
compose_invariant '4-space-indented HTML is literal code' "$(ensure $'    <div>\n' "$TMP/repo")"
compose_invariant 'two-space-indented marker is accepted' \
  "$(ensure $'- [x] <!-- orc:issue --> linked\n  - [x] <!-- orc:tests --> nested\n' "$TMP/repo")"
export BODY_FIXTURE="$TMP/files/no-markers.md"

# --- (f13) an EXPLICIT body is tracked by the ARGUMENTS, not by its value -------
# `pr-create --body "" --fill` used to exit 2 ("--body requires a value") and
# `--body= --fill` exited 0 while silently DROPPING the supplied body: the code
# tested `-n "$BODY"`, which cannot tell "supplied and empty" from "not supplied".
# Explicitness is now its own variable, set by the parser, and it drives the
# conflict, the validation, the exclusive-source refusal, the note and forwarding.
for empty_form in 'separated' 'joined'; do
  if [ "$empty_form" = separated ]; then empty_args=(--body ""); else empty_args=(--body=); fi
  # (a) no gh body source: the explicit empty body becomes the checklist-only
  #     body and is FORWARDED; the bodyless note must NOT print.
  OUT="$(dry_run --title t "${empty_args[@]}" 2>&1)"; RC=$?
  assert "f13: [$empty_form] an explicit empty body exits 0" 0 "$RC"
  assert "f13: [$empty_form] it is forwarded to gh" 1 \
    "$(grep -cE '^\[dry-run\] gh .* --body([ =]|$)' <<<"$OUT")"
  assert "f13: [$empty_form] it carries the nine markers" 9 \
    "$(grep -c -- '- \[ \] <!-- orc:' <<<"$OUT")"
  assert "f13: [$empty_form] the bodyless note does NOT print" 0 \
    "$(grep -cF 'NOTE: no PR body supplied' <<<"$OUT")"
  # (b) alongside `--fill` the explicit empty body is validated and forwarded
  #     (gh gives an explicit body precedence over autofill).
  OUT="$(dry_run --title t "${empty_args[@]}" --fill 2>&1)"; RC=$?
  assert "f13: [$empty_form] --fill + explicit empty body exits 0" 0 "$RC"
  assert "f13: [$empty_form] --fill + explicit empty body forwards --body" 1 \
    "$(grep -cE '^\[dry-run\] gh .* --body([ =]|$)' <<<"$OUT")"
  assert "f13: [$empty_form] --fill + explicit empty body carries nine markers" 9 \
    "$(grep -c -- '- \[ \] <!-- orc:' <<<"$OUT")"
  assert "f13: [$empty_form] and prints no remediation note" 0 \
    "$(grep -cF 'pr-mutate edit <pr> --inject-checklist' <<<"$OUT")"
  # (c) R15: the gh body sources are NOT special-cased. An explicit (here: empty)
  # body is validated and forwarded, and the caller's flag is forwarded untouched
  # — whether gh accepts the combination is gh's error to report, not ours.
  for exclusive in --template --web --editor; do
    if [ "$exclusive" = --template ]; then extra=(--template .github/pull_request_template.md); else extra=("$exclusive"); fi
    OUT="$(dry_run --title t "${empty_args[@]}" "${extra[@]}" 2>&1)"; RC=$?
    assert "f13: [$empty_form] $exclusive + explicit empty body exits 0" 0 "$RC"
    assert "f13: [$empty_form] $exclusive keeps the forwarded --body" 1 \
      "$(grep -cE '^\[dry-run\] gh .* --body([ =]|$)' <<<"$OUT")"
    assert "f13: [$empty_form] $exclusive carries the nine markers" 9 \
      "$(grep -c -- '- \[ \] <!-- orc:' <<<"$OUT")"
    assert "f13: [$empty_form] $exclusive is forwarded untouched" 1 \
      "$(grep -cF -- "${exclusive%% *}" <<<"$OUT")"
    assert "f13: [$empty_form] $exclusive prints no refusal" 0 \
      "$(grep -cF 'accepts only one body source' <<<"$OUT")"
  done
done
# An EMPTY body FILE is not reachable by design (the reader refuses it), so the
# explicit empty body exists only in the inline form. Pinned through the real
# route.
printf '' > "$TMP/files/f13-empty.md"
OUT="$(dry_run --title t --body-file "$TMP/files/f13-empty.md" 2>&1)"; RC=$?
assert 'f13: an empty body-file is refused by the reader' 2 "$RC"
assert 'f13: and the refusal says the file is empty' 1 \
  "$(grep -cF 'is empty' <<<"$OUT")"
assert 'f13: and nothing reaches gh' 0 "$(grep -cE '^\[dry-run\] gh ' <<<"$OUT")"
# pr-mutate composes an explicit empty body the same way.
rm -f "$TMP/edited-body.md"
run pr-mutate edit 7 --repo test-org/repo --body ""
assert 'f13: pr-mutate sets an explicit empty body to the checklist-only body' 9 \
  "$(grep -c -- '- \[ \] <!-- orc:' "$TMP/edited-body.md")"

# --- (f14) the SHORT body flags are the long ones (#811) ----------------------
# `-b`, `-F` and `-f` are gh's short spellings (verified against the installed
# `gh pr create --help`/`gh pr edit --help`, v2.104.0). `-B` is `--base` and is
# deliberately NOT normalised. Before this, `pr-mutate edit 123 -b Summary`
# replaced the body WITHOUT the managed checklist and `pr-create -b X` bypassed
# composition validation entirely.
OUT="$(dry_run --title t -b 'a short-form summary' 2>&1)"; RC=$?
assert 'f14: pr-create -b exits 0' 0 "$RC"
assert 'f14: pr-create -b carries the nine markers' 9 \
  "$(grep -c -- '- \[ \] <!-- orc:' <<<"$OUT")"
assert 'f14: pr-create -b keeps the summary' 1 "$(grep -cF 'a short-form summary' <<<"$OUT")"
OUT="$(dry_run --title t -b 'a short-form summary' --fill 2>&1)"; RC=$?
assert 'f14: pr-create -b + --fill forwards a body' 1 \
  "$(grep -cE '^\[dry-run\] gh .* --body([ =]|$)' <<<"$OUT")"
assert 'f14: pr-create -b + --fill carries the nine markers' 9 \
  "$(grep -c -- '- \[ \] <!-- orc:' <<<"$OUT")"
OUT="$(dry_run --title t -b '- [x] <!-- orc:issue --> linked
<div>a block</div>' 2>&1)"; RC=$?
assert 'f14: pr-create -b is VALIDATED (refused shape exits 2)' 2 "$RC"
assert 'f14: and names the construct' 1 "$(grep -cF 'raw HTML construct at line 2' <<<"$OUT")"
assert 'f14: and never reaches gh' 0 "$(grep -cE '^\[dry-run\] gh ' <<<"$OUT")"
OUT="$(dry_run --title t -b=joined-short-summary 2>&1)"; RC=$?
assert 'f14: pr-create -b=<value> exits 0' 0 "$RC"
assert 'f14: pr-create -b=<value> carries the nine markers' 9 \
  "$(grep -c -- '- \[ \] <!-- orc:' <<<"$OUT")"
printf 'a short body-file summary\n' > "$TMP/files/f14-summary.md"
OUT="$(dry_run --title t -F "$TMP/files/f14-summary.md" 2>&1)"; RC=$?
assert 'f14: pr-create -F exits 0' 0 "$RC"
assert 'f14: pr-create -F carries the nine markers' 9 \
  "$(grep -c -- '- \[ \] <!-- orc:' <<<"$OUT")"
OUT="$(dry_run --title t "-F=$TMP/files/f14-summary.md" 2>&1)"; RC=$?
assert 'f14: pr-create -F=<path> exits 0' 0 "$RC"
assert 'f14: pr-create -F=<path> carries the nine markers' 9 \
  "$(grep -c -- '- \[ \] <!-- orc:' <<<"$OUT")"
# R15: `-f` is gh's own `--fill` shorthand and is forwarded UNTOUCHED (it is not
# rewritten, and it is not a body source for us): with no explicit body nothing
# is injected and no `--body` is passed.
OUT="$(dry_run --title t -f 2>&1)"; RC=$?
assert 'f14: pr-create -f exits 0' 0 "$RC"
assert 'f14: pr-create -f passes no --body' 0 \
  "$(grep -cE '^\[dry-run\] gh .* --body([ =]|$)' <<<"$OUT")"
assert 'f14: pr-create -f injects nothing' 0 "$(grep -c '<!-- orc:' <<<"$OUT")"
assert 'f14: pr-create -f is forwarded verbatim (not rewritten to --fill)' 1 \
  "$(grep -cE '(^| )-f( |$)' <<<"$OUT")"
assert 'f14: pr-create -f prints the no-explicit-body note' 1 \
  "$(grep -cF 'gh sources the PR body' <<<"$OUT")"
# `--fill=false` / `-f=false` are gh's own negations: forwarded, no body, no
# injection. We no longer model whether they are a "body source" at all.
for negated in '--fill=false' '-f=false'; do
  OUT="$(dry_run --title t "$negated" 2>&1)"; RC=$?
  assert "f14: $negated exits 0" 0 "$RC"
  assert "f14: $negated injects nothing" 0 "$(grep -c '<!-- orc:' <<<"$OUT")"
  assert "f14: $negated passes no --body" 0 \
    "$(grep -cE '^\[dry-run\] gh .* --body([ =]|$)' <<<"$OUT")"
  assert "f14: $negated is forwarded verbatim" 1 \
    "$(grep -cF -- "$negated" <<<"$OUT")"
  assert "f14: $negated prints the no-explicit-body note" 1 \
    "$(grep -cF 'gh sources the PR body' <<<"$OUT")"
done
# `-B` is --base: forwarded untouched, and with no explicit body nothing is
# injected (R15 removed the bodyless checklist injection).
OUT="$(dry_run --title t -B main 2>&1)"; RC=$?
assert 'f14: pr-create -B exits 0' 0 "$RC"
assert 'f14: pr-create -B is passed through as --base' 1 "$(grep -cE ' -B main' <<<"$OUT")"
assert 'f14: pr-create -B passes no --body' 0 \
  "$(grep -cE '^\[dry-run\] gh .* --body([ =]|$)' <<<"$OUT")"
assert 'f14: pr-create -B injects nothing' 0 "$(grep -c '<!-- orc:' <<<"$OUT")"
assert 'f14: pr-create -B prints the no-explicit-body note' 1 \
  "$(grep -cF 'gh sources the PR body' <<<"$OUT")"
# pr-mutate: the #811 regression — the alias must carry the checklist.
export BODY_FIXTURE="$TMP/files/no-markers.md"
rm -f "$TMP/edited-body.md"
run pr-mutate edit 7 --repo test-org/repo -b 'a short-form summary'
assert 'f14: pr-mutate -b exits 0' 0 "$RC"
assert 'f14: pr-mutate -b carries the nine markers' 9 \
  "$(grep -c -- '- \[ \] <!-- orc:' "$TMP/edited-body.md")"
assert 'f14: pr-mutate -b keeps the summary' 1 \
  "$(grep -cF 'a short-form summary' "$TMP/edited-body.md")"
rm -f "$TMP/edited-body.md"
run pr-mutate edit 7 --repo test-org/repo -b=joined-short-summary
assert 'f14: pr-mutate -b=<value> carries the nine markers' 9 \
  "$(grep -c -- '- \[ \] <!-- orc:' "$TMP/edited-body.md")"
rm -f "$TMP/edited-body.md"
run pr-mutate edit 7 --repo test-org/repo -F "$TMP/files/f14-summary.md"
assert 'f14: pr-mutate -F exits 0' 0 "$RC"
assert 'f14: pr-mutate -F carries the nine markers' 9 \
  "$(grep -c -- '- \[ \] <!-- orc:' "$TMP/edited-body.md")"
rm -f "$TMP/edited-body.md"
run pr-mutate edit 7 --repo test-org/repo "-F=$TMP/files/f14-summary.md"
assert 'f14: pr-mutate -F=<path> carries the nine markers' 9 \
  "$(grep -c -- '- \[ \] <!-- orc:' "$TMP/edited-body.md")"
rm -f "$TMP/edited-body.md"
run pr-mutate edit 7 --repo test-org/repo --inject-checklist -b x
assert 'f14: --inject-checklist + -b is refused' 2 "$RC"
assert 'f14: and never reaches gh' 0 "$(exists "$TMP/edited-body.md")"
rm -f "$TMP/edited-body.md"
run pr-mutate edit 7 --repo test-org/repo --inject-checklist -F "$TMP/files/f14-summary.md"
assert 'f14: --inject-checklist + -F is refused' 2 "$RC"
assert 'f14: and never reaches gh (file form)' 0 "$(exists "$TMP/edited-body.md")"
export BODY_FIXTURE="$TMP/files/no-markers.md"

# --- (f15) R15: intervene ONLY when a body is supplied -------------------------
# The rule, end to end: with NO explicit body the wrapper injects nothing, passes
# no `--body` and forwards every flag untouched (gh sources/prompts for the body
# itself); with an explicit body it validates, composes and forwards that body,
# and still forwards every other flag untouched. Nothing is ever refused on
# gh's behalf. The table below pins all four columns for each flag: exit code,
# the exact gh argv (via the dry-run line, counted once), whether nine markers
# were injected, and whether the note matches the path.
f15_run() { # f15_run <label> <expect-exit> <expect-markers> <expect-note: yes|no> <args...>
  local label="$1" want_rc="$2" want_markers="$3" want_note="$4"; shift 4
  OUT="$(dry_run --title t "$@" 2>&1)"; RC=$?
  assert "f15: $label — exit $want_rc" "$want_rc" "$RC"
  assert "f15: $label — $want_markers managed markers" "$want_markers" \
    "$(grep -c -- '- \[ \] <!-- orc:' <<<"$OUT")"
  assert "f15: $label — note matches the path ($want_note)" "$want_note" \
    "$([ "$(grep -cF 'gh sources the PR body' <<<"$OUT")" -gt 0 ] && echo yes || echo no)"
}
# (a) NO explicit body: nothing injected, no --body, note says gh sources it, and
# the caller's flag reaches gh VERBATIM.
for flag_case in \
  '--fill' '--fill=true' '-f' '-f=true' '--fill-first=true' '--fill-verbose=true' \
  '--template .github/pull_request_template.md' '--web' '--editor' '--editor=true' '-B main'; do
  # shellcheck disable=SC2086 # deliberate word splitting of the flag case
  f15_run "no-body $flag_case" 0 0 yes $flag_case
  assert "f15: no-body $flag_case — no --body to gh" 0 \
    "$(grep -cE '^\[dry-run\] gh .* --body([ =]|$)' <<<"$OUT")"
  # A TOKEN match, not a substring: the note mentions `--body-file`, whose text
  # contains `-f`, so a plain -F match would double-count.
  assert "f15: no-body $flag_case — flag forwarded verbatim" 1 \
    "$(grep -cE -- "(^|[[:space:]])${flag_case%% *}([[:space:]]|$)" <<<"$OUT")"
done
# (b) WITH an explicit body: validated, composed, forwarded; the other flag is
# forwarded untouched and NEVER refused (gh owns the combination).
for flag_case in '--fill=true' '--fill' '-f' '--editor' '--editor=true' '--web' \
  '--template .github/pull_request_template.md'; do
  # shellcheck disable=SC2086
  f15_run "body+$flag_case" 0 9 no --body 'a plain summary' $flag_case
  assert "f15: body+$flag_case — --body is forwarded" 1 \
    "$(grep -cE '^\[dry-run\] gh .* --body([ =]|$)' <<<"$OUT")"
  assert "f15: body+$flag_case — flag forwarded verbatim" 1 \
    "$(grep -cE -- "(^|[[:space:]])${flag_case%% *}([[:space:]]|$)" <<<"$OUT")"
  assert "f15: body+$flag_case — we never refuse the combination" 0 \
    "$(grep -cF 'accepts only one body source' <<<"$OUT")"
done
# (c) Attached short values (pflag): validated and composed exactly like the
# separated forms, and a REFUSED shape is refused through them too.
OUT="$(dry_run --title t -battached-summary 2>&1)"; RC=$?
assert 'f15: -bX exits 0' 0 "$RC"
assert 'f15: -bX carries the nine markers' 9 "$(grep -c -- '- \[ \] <!-- orc:' <<<"$OUT")"
assert 'f15: -bX keeps the attached summary' 1 "$(grep -cF 'attached-summary' <<<"$OUT")"
printf 'an attached body-file summary\n' > "$TMP/files/f15-attached.md"
OUT="$(dry_run --title t "-F$TMP/files/f15-attached.md" 2>&1)"; RC=$?
assert 'f15: -FX exits 0' 0 "$RC"
assert 'f15: -FX carries the nine markers' 9 "$(grep -c -- '- \[ \] <!-- orc:' <<<"$OUT")"
assert 'f15: -FX keeps the file summary' 1 "$(grep -cF 'an attached body-file summary' <<<"$OUT")"
OUT="$(dry_run --title t '-b- [x] <!-- orc:issue --> linked
<div>a block</div>' 2>&1)"; RC=$?
assert 'f15: -bX is VALIDATED (refused shape exits 2)' 2 "$RC"
assert 'f15: -bX refusal names the construct' 1 "$(grep -cF 'raw HTML construct at line 2' <<<"$OUT")"
assert 'f15: -bX refusal never reaches gh' 0 "$(grep -cE '^\[dry-run\] gh ' <<<"$OUT")"
# (d) An explicit body is never dropped and never forwarded unvalidated: every
# body spelling that reaches the helper either composes nine markers or exits 2.
for body_form in '--body' '-b'; do
  OUT="$(dry_run --title t "$body_form" 'plain' 2>&1)"; RC=$?
  assert "f15: $body_form plain exits 0" 0 "$RC"
  assert "f15: $body_form plain composes nine markers" 9 \
    "$(grep -c -- '- \[ \] <!-- orc:' <<<"$OUT")"
  OUT="$(dry_run --title t "$body_form" '- [x] <!-- orc:issue --> linked
<div>x</div>' 2>&1)"; RC=$?
  assert "f15: $body_form refused shape exits 2" 2 "$RC"
done
# pr-mutate: the attached forms compose the checklist too (the #811 regression,
# extended to pflag's attached syntax).
export BODY_FIXTURE="$TMP/files/no-markers.md"
for mutate_form in '-battached-edit' "-F$TMP/files/f15-attached.md"; do
  rm -f "$TMP/edited-body.md"
  run pr-mutate edit 7 --repo test-org/repo "$mutate_form"
  assert "f15: pr-mutate '$mutate_form' exits 0" 0 "$RC"
  assert "f15: pr-mutate '$mutate_form' carries the nine markers" 9 \
    "$(grep -c -- '- \[ \] <!-- orc:' "$TMP/edited-body.md")"
done
export BODY_FIXTURE="$TMP/files/no-markers.md"

# --- (f16) a CLUSTERED short flag cannot carry a body past the wrapper ---------
# arbsec/orchestraitor#799 R16: pflag (gh's parser) accepts a boolean shorthand
# followed by a value-taking shorthand in ONE token, so `-fbX` is `--fill --body
# X`, `-dbX` is `--draft --body X` and `-fF/path` is `--fill --body-file /path`
# (proved against the installed gh v2.104.0: `gh pr create -fF/tmp/nothing`
# prints "open /tmp/nothing: no such file or directory" — gh READ the path as
# the body file). Such a token used to fall through to the pass-through branch
# and reach gh UNVALIDATED, and `-F<path>` bypassed the trusted-root reader
# entirely, so an out-of-root file could be published.
#
# The wrapper now resolves EVERY single-dash token with pflag's rules: a cluster
# that carries a body is split (the body is composed and validated, the boolean
# parts keep their meaning), a cluster that carries NO body is forwarded
# VERBATIM, and a token whose letters cannot be resolved is REFUSED.
#
# `gh pr create` HAS the boolean shorthands (-d/--draft, -e/--editor,
# -f/--fill, -w/--web), so a cluster can carry a body there. `gh pr edit` has
# NO boolean shorthand at all (its shorts are -B -b -F -m -t), so for pr-mutate
# the body-bearing forms are the attached ones (-bX, -FX) plus the
# fail-closed refusal of an unresolvable token.
for cluster_case in '-fbCLUSTER' '-dbCLUSTER' '-wbCLUSTER'; do
  cluster_bool="$(printf '%s' "${cluster_case:0:2}" | tail -c1)"
  OUT="$(dry_run --title t "$cluster_case" 2>&1)"; RC=$?
  assert "f16: $cluster_case exits 0" 0 "$RC"
  assert "f16: $cluster_case carries the nine markers" 9 \
    "$(grep -c -- '- \[ \] <!-- orc:' <<<"$OUT")"
  assert "f16: $cluster_case forwards a composed --body" 1 \
    "$(grep -cE '^\[dry-run\] gh .* --body([ =]|$)' <<<"$OUT")"
  assert "f16: $cluster_case keeps the cluster's boolean part (-$cluster_bool)" 1 \
    "$(grep -cE -- "(^|[[:space:]])-${cluster_bool}([[:space:]]|$)" <<<"$OUT")"
  assert "f16: $cluster_case is never forwarded as one token" 0 \
    "$(grep -cE -- "(^|[[:space:]])${cluster_case}([[:space:]]|$)" <<<"$OUT")"
done
# The cluster's body part must be VALIDATED like any other body.
OUT="$(dry_run --title t '-fb- [x] <!-- orc:issue --> linked
<div>a block</div>' 2>&1)"; RC=$?
assert 'f16: a cluster body is VALIDATED (refused shape exits 2)' 2 "$RC"
assert 'f16: and names the construct' 1 "$(grep -cF 'raw HTML construct at line 2' <<<"$OUT")"
assert 'f16: and never reaches gh' 0 "$(grep -cE '^\[dry-run\] gh ' <<<"$OUT")"
# A cluster carrying a BODY FILE must go through the trusted-root reader: an
# out-of-root path is refused and never reaches gh.
for cluster_file in '-fF/etc/passwd' '-dF/etc/passwd' '-wF/etc/passwd'; do
  OUT="$(dry_run --title t "$cluster_file" 2>&1)"; RC=$?
  assert "f16: $cluster_file is refused (exit 2)" 2 "$RC"
  assert "f16: $cluster_file names the trusted-root refusal" 1 \
    "$(grep -cF 'outside the trusted roots' <<<"$OUT")"
  assert "f16: $cluster_file never reaches gh" 0 "$(grep -cE '^\[dry-run\] gh ' <<<"$OUT")"
done
# A cluster with NO body is forwarded VERBATIM: the argv gh sees is the argv the
# caller wrote (no rewriting, no refusal).
for plain_cluster in '-Bmain' '-f' '-d' '-w' '-tTITLE' '-Hbranch'; do
  OUT="$(dry_run --title t "$plain_cluster" 2>&1)"; RC=$?
  assert "f16: $plain_cluster exits 0" 0 "$RC"
  assert "f16: $plain_cluster is forwarded verbatim" 1 \
    "$(grep -cE -- "(^|[[:space:]])${plain_cluster}([[:space:]]|$)" <<<"$OUT")"
  assert "f16: $plain_cluster injects nothing" 0 "$(grep -c '<!-- orc:' <<<"$OUT")"
  assert "f16: $plain_cluster passes no --body" 0 \
    "$(grep -cE '^\[dry-run\] gh .* --body([ =]|$)' <<<"$OUT")"
done
# An UNRESOLVABLE cluster is refused, never forwarded: a flag gh grew yesterday
# could be a body flag.
OUT="$(dry_run --title t '-zFOO' 2>&1)"; RC=$?
assert 'f16: an unresolved cluster is refused (exit 2)' 2 "$RC"
assert 'f16: and the refusal names the reason' 1 \
  "$(grep -cF 'its short flags cannot be resolved' <<<"$OUT")"
assert 'f16: and it never reaches gh' 0 "$(grep -cE '^\[dry-run\] gh ' <<<"$OUT")"
# The CONTROLS: the non-clustered forms keep working exactly as before.
OUT="$(dry_run --title t '-bCONTROL' 2>&1)"; RC=$?
assert 'f16: the -b control exits 0' 0 "$RC"
assert 'f16: the -b control carries the nine markers' 9 \
  "$(grep -c -- '- \[ \] <!-- orc:' <<<"$OUT")"
printf 'a control body-file summary\n' > "$TMP/files/f16-control.md"
OUT="$(dry_run --title t "-F$TMP/files/f16-control.md" 2>&1)"; RC=$?
assert 'f16: the -F control exits 0' 0 "$RC"
assert 'f16: the -F control carries the nine markers' 9 \
  "$(grep -c -- '- \[ \] <!-- orc:' <<<"$OUT")"
assert 'f16: the -F control keeps the file summary' 1 \
  "$(grep -cF 'a control body-file summary' <<<"$OUT")"
# pr-mutate (gh pr edit): the attached body forms compose the checklist, an
# out-of-root body file is refused by the trusted-root reader, and an
# unresolvable token is refused.
export BODY_FIXTURE="$TMP/files/no-markers.md"
for mutate_form in '-bMUTATE' "-F$TMP/files/f16-control.md"; do
  rm -f "$TMP/edited-body.md"
  run pr-mutate edit 7 --repo test-org/repo "$mutate_form"
  assert "f16: pr-mutate '$mutate_form' exits 0" 0 "$RC"
  assert "f16: pr-mutate '$mutate_form' carries the nine markers" 9 \
    "$(grep -c -- '- \[ \] <!-- orc:' "$TMP/edited-body.md")"
done
rm -f "$TMP/edited-body.md"
run pr-mutate edit 7 --repo test-org/repo '-F/etc/passwd'
assert 'f16: pr-mutate refuses an out-of-root body file' 2 "$RC"
assert 'f16: and names the trusted-root refusal' 1 \
  "$(grep -cF 'outside the trusted roots' "$TMP/stderr")"
assert 'f16: and never reaches gh' 0 "$(exists "$TMP/edited-body.md")"
rm -f "$TMP/edited-body.md"
run pr-mutate edit 7 --repo test-org/repo '-zFOO'
assert 'f16: pr-mutate refuses an unresolved cluster' 2 "$RC"
assert 'f16: and never reaches gh' 0 "$(exists "$TMP/edited-body.md")"
export BODY_FIXTURE="$TMP/files/no-markers.md"

printf '\n=== reconcile-checklist regression: %s passed, %s failed ===\n' "$PASS" "$FAIL"
[ "$FAIL" -eq 0 ]
