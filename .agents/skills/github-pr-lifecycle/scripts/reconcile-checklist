#!/usr/bin/env bash
# reconcile-checklist: parse the PR body for <!-- orc:* --> markers and report
# which managed checklist items are checked vs unchecked as verified facts.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=_lib.sh
source "$SCRIPT_DIR/_lib.sh"

orc_lib_parse_common "$@"

if [ "$OPT_HELP" = true ]; then
  orc_lib_print_help "reconcile-checklist" "Parse PR body for <!-- orc:* --> markers and report checked vs unchecked items. A body with no markers is reported MISSING (marker_count 0, all_checked false), never as an all-checked checklist, and always blocks with checklist_markers_missing — there is no author-granted opt-out. Markers inside a fenced code region or an HTML comment are examples, not checklist items. An HTML comment opens only when its <!-- is the line's first content, so a <!-- inside an inline code span is literal text. A body that OPENS a fence with 1-3 leading spaces is reported unparseable (all_checked false), whether or not that fence closes: its container scope cannot be determined, so the verdict blocks with checklist_unparseable — dedent the fence opener to column 0."
  exit "$ORC_OK"
fi

PR="${ORC_LIB_EXTRA_ARGS[0]:-}"
if [ -z "$PR" ]; then
  echo "error: PR number required" >&2
  exit "$ORC_ERR_CONFIG"
fi

orc_lib_require_gh_scope
REPO="$(orc_lib_resolve_repo)"

if [ "$OPT_DRY_RUN" = true ]; then
  echo "[dry-run] gh pr view $PR --repo $REPO --json body | grep orc:" >&2
  exit "$ORC_OK"
fi

BODY="$(orc_lib_gh pr view "$PR" --repo "$REPO" --json body | jq -r '.body')"

# Extract each checklist line with its orc marker.
# Pattern: - [ ] <!-- orc:XXX --> description  OR  - [x] <!-- orc:XXX --> description
# The box holds a REAL checkbox character and nothing else: a space (unchecked),
# `x` or `X` (checked). Any other character is not a checklist line — the Rust
# engine (`parse_checklist`) accepts exactly the same three.
# Only SPACE and TAB indent an item: the leading class is `[ \t]`, never PCRE
# `\s` (which also matches a vertical tab the Rust engine does not trim;
# arbsec/orchestraitor#799 F18). The `\s*` between the dash and `[` is a
# separate open divergence tracked in arbsec/orchestraitor#807.
# A body with zero markers is legitimate to PARSE (custom PR bodies; #394 keeps
# "an empty parse is an empty list"), so grep matching nothing is guarded under
# pipefail — empty means an empty checklist. An empty checklist is NOT a
# satisfied one (#788): the derived state below keeps "no markers" distinguishable
# from "all markers checked", and `convergence-status` blocks the former with
# `checklist_markers_missing` instead of reading it as a vacuous pass.
# There is NO author-granted opt-out: a body with no marker is missing
# evidence and always fails closed (an exemption may only come from an
# authority the author does not hold — arbsec/orchestraitor#801).
#
# Fenced code regions are EXAMPLES, not evidence: a marker inside a fence is
# not a checklist item. `orc_lib_strip_fenced_code` (in _lib.sh) removes
# them; the Rust engine applies the same rule, so creation and
# reconciliation agree on what a marker is.
SCANNED_BODY="$(printf '%s\n' "$BODY" | orc_lib_strip_fenced_code)"
# A fence OPENER indented 1-3 spaces may sit inside a list item or a block
# quote, and the scanner has no container model. The region it models can
# swallow a genuine unchecked item, so the reading is INDETERMINATE and
# `all_checked` must never be true for it (arbsec/orchestraitor#809). The
# condition stands only while that region is OPEN: a region that CLOSES has a
# known extent, so its contents are determinately code. The verdict blocks with
# `checklist_unparseable`; the fix names the construct.
UNPARSEABLE_LINE="$(printf '%s\n' "$BODY" | orc_lib_fence_unparseable_line)"
RESULT="$(printf '%s\n' "$SCANNED_BODY" | { grep -oP '^[ \t]*-\s*\[[xX ]\]\s*<!--\s*orc:([A-Za-z0-9_-]+)\s*-->\s*(.*)$' || true; } | while IFS= read -r line; do
  CHECKED="$(printf '%s\n' "$line" | grep -oP '^[ \t]*-\s*\[[xX ]\]' | grep -oP '(?<=\[).' || echo " ")"
  MARKER="$(printf '%s\n' "$line" | grep -oP '(?<=orc:)[A-Za-z0-9_-]+')"
  DESC="$(printf '%s\n' "$line" | sed 's/^[^>]*-->[[:space:]]*//' || true)"
  printf '%s\t%s\t%s\n' "$MARKER" "$CHECKED" "$DESC"
done)"

if [ "$OPT_JSON" = true ]; then
  echo "$RESULT" | jq -R -s --arg unparseable_line "$UNPARSEABLE_LINE" '
    split("\n") | map(select(length > 0)) |
    ($unparseable_line != "") as $indeterminate |
    map(split("\t")) | map({
      marker: .[0],
      checked: (.[1] == "x" or .[1] == "X"),
      description: .[2]
    }) | {
      items: .,
      marker_count: length,
      markers_present: (length > 0),
      all_checked: (($indeterminate | not) and (length > 0) and all(.[]; .checked == true)),
      unparseable: $indeterminate,
      unparseable_line: (if $indeterminate then ($unparseable_line | tonumber) else null end),
      unchecked: map(select(.checked == false))
    }
  '
else
  echo "PR checklist reconciliation:"
  if [ -n "$UNPARSEABLE_LINE" ]; then
    echo "  (UNPARSEABLE: the body opens a fenced code block indented 1-3 spaces on line $UNPARSEABLE_LINE, closed or not;"
    echo "   its container scope (top level, list item, block quote) cannot be determined, so no checklist reading is trusted)"
    echo "   fix: dedent the fence opener to column 0"
  fi
  if [ -z "$RESULT" ]; then
    echo "  (no managed orc:* checklist markers found — checklist UNSUBSTANTIATED)"
  else
    echo "$RESULT" | while IFS=$'\t' read -r marker checked desc; do
      [ -z "$marker" ] && continue
      if [ "$checked" = "x" ] || [ "$checked" = "X" ]; then
        echo "  [x] $marker: $desc"
      else
        echo "  [ ] $marker: $desc"
      fi
    done
  fi
fi
