#!/usr/bin/env bash
# create-follow-up: open a separate leaf issue for independently testable
# discovered work, linked from the current PR.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=_lib.sh
source "$SCRIPT_DIR/_lib.sh"

orc_lib_parse_common "$@"

if [ "$OPT_HELP" = true ]; then
  orc_lib_print_help "create-follow-up" "Open a follow-up issue for discovered work, linked from a PR."
  exit "$ORC_OK"
fi

# Extract --from-pr, --title, --spec-ref from args.
PR_NUM=""
TITLE=""
SPEC_REF=""
while [ "${#ORC_LIB_EXTRA_ARGS[@]}" -gt 0 ]; do
  case "${ORC_LIB_EXTRA_ARGS[0]}" in
    --from-pr) PR_NUM="${ORC_LIB_EXTRA_ARGS[1]}"; ORC_LIB_EXTRA_ARGS=("${ORC_LIB_EXTRA_ARGS[@]:2}") ;;
    --title)   TITLE="${ORC_LIB_EXTRA_ARGS[1]}"; ORC_LIB_EXTRA_ARGS=("${ORC_LIB_EXTRA_ARGS[@]:2}") ;;
    --spec-ref) SPEC_REF="${ORC_LIB_EXTRA_ARGS[1]}"; ORC_LIB_EXTRA_ARGS=("${ORC_LIB_EXTRA_ARGS[@]:2}") ;;
    *) break ;;
  esac
done

[ -z "$PR_NUM" ] && PR_NUM="${ORC_LIB_EXTRA_ARGS[0]:-}"
[ -z "$TITLE" ] && TITLE="${ORC_LIB_EXTRA_ARGS[1]:-}"

if [ -z "$PR_NUM" ] || [ -z "$TITLE" ]; then
  echo "error: --from-pr <num> and --title <text> required" >&2
  exit "$ORC_ERR_CONFIG"
fi

orc_lib_require_gh_scope
REPO="$(orc_lib_resolve_repo)"

BODY="Follow-up discovered during work on #$PR_NUM."
[ -n "$SPEC_REF" ] && BODY="$BODY

Specification reference: $SPEC_REF"

if [ "$OPT_DRY_RUN" = true ]; then
  echo "[dry-run] gh issue create --repo $REPO --title \"$TITLE\" --body \"$BODY\" --type Task" >&2
  exit "$ORC_OK"
fi

ARGS=(issue create --repo "$REPO" --title "$TITLE" --body "$BODY" --type "Task")
ISSUE_URL="$(orc_lib_run_or_dry_run ARGS gh)"
echo "Created follow-up: $ISSUE_URL" >&2
echo "Add this URL to PR #$PR_NUM 'Newly discovered follow-up work' section." >&2
